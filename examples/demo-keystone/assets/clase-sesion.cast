[183.8818, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m8\u001b[18G\u001b[38;2;166;226;46mthem\u001b[23G\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"light\"\u001b[38;2;248;248;242m,             \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m69\u001b[18G\u001b[38;2;166;226;46mk\u001b[20Gck\u001b[23Gr\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"La versi\u00f3n formal\"\u001b[38;2;248;248;242m,                                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m0\u001b[19G\u001b[38;2;166;226;46mitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Tasa\u001b[32Gtotal = \u03a3\u001b[42G**peso** del grupo \u00d7\u001b[63Gt\u001b[65Gsa del grupo\"\u001b[38;2;248;248;242m,                                                 \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[15G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Pesos distintos bastan para invertir la comparaci\u00f3n: el promedio compara composiciones, no desempe\u00f1os\"\u001b[38;2;248;248;242m                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[15G\u001b[38;2;248;248;242m},\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[15G\u001b[38;2;248;248;242m{\u001b[17G                                                                               "]
