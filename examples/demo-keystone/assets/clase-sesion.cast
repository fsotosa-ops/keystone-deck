[185.2553, "o", "        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[15G\u001b[38;2;248;248;242m},\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[15G\u001b[38;2;248;248;242m{\u001b[17G                                                                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[18G\u001b[38;2;166;226;46mid\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"pregunta\"\u001b[38;2;248;248;242m, \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[18G\u001b[38;2;166;226;46mlayout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cards\"\u001b[38;2;248;248;242m,\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[18G\u001b[38;2;166;226;46mthem\u001b[23G\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"da\u001b[30Gk\"\u001b[38;2;248;248;242m,                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[18G\u001b[38;2;166;226;46mk\u001b[20Gck\u001b[23Gr\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Pregunta de control\"\u001b[38;2;248;248;242m,                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[18G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El ho\u001b[33Gpital A tiene mayor mortalidad que B. \u00bfQu\u00e9 preguntas primero?\"\u001b[38;2;248;248;242m,\r"]
