[303.5879, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3Gpregunta\u001b[12Gque lleva\u001b[22Ga\u001b[24Gla\u001b[27Gl\u00e1mina\u001b[34Gsiguiente.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEjemplo y fuente.\u001b[21G\u001b[22mUs\u00e9\u001b[25Gel\u001b[28Gcaso\u001b[33Gde\u001b[36Gadmisiones\u001b[47Gde\u001b[50GBerkeley\u001b[59Gde\u001b[62G1973,\u001b[68Gel\u001b[71Gejemplo\u001b[79Gcl\u00e1sico\u001b[87Gde\u001b[90Gla\u001b[93Gparadoja\u001b[102Gde\u001b[105GSimpson.\u001b[114GLos\u001b[118Gdatos\u001b[124Gson\u001b[128Glos\u001b[132Gconteos\u001b[140Gde\u001b[143Glos\u001b[147Gseis\r\u001b[2C\u001b[1Bdepartamentos\u001b[17Gm\u00e1s\u001b[21Ggrandes,\u001b[30Gseg\u00fan\u001b[36GBickel,\u001b[44GHammel\u001b[51Gy\u001b[53GO'Connell\u001b[63G(1975),\u001b[71G\u001b[3mScience\u001b[79G\u001b[23m187(4175),\u001b[90G398\u2013404,\u001b[99Gy\u001b[101Gel\u001b[104Gdataset\u001b[112G\u001b[38;2;177;185;249mUCBAdmissions\u001b[126G\u001b[39mde\u001b[129GR.\u001b[132GTodas\u001b[138Glas\u001b[142Gcifras\r\u001b[2C\u001b[1Blas calcula \u001b[38;2;177;185;249mdeck/data/berkeley.py\u001b[39m;\u001b[38Gninguna\u001b[46Gest\u00e1\u001b[51Gescrita\u001b[59Ga\u001b[61Gmano.\r\u001b[2B \u001b[3G\u001b[1mLa idea central:\u001b[22m un promedio total\u001b[38Gmezcla\u001b[45Glo\u001b[48Gque pasa dentro de cada\u001b[72Ggrupo con\u001b[83G\u00f3mo se\u001b[90Grepart\u001b[97G la gente entre grupos, y esa mezcla puede invertir la\r\u001b[2C\u001b[1Bconclusi\u00f3n.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500"]
