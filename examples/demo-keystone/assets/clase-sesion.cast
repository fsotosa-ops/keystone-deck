[239.034, "o", "                                              \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m6\u001b[13G\u001b[22m \u001b[15G}\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m \u001b[13G]\r\u001b[5C\u001b[1B\u001b[2m 88 \u001b[11G\u001b[22m}\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos\u001b[7Gchecks\u001b[14Gpasan;\u001b[21Gquedan\u001b[28Gavisos\u001b[35Gde\u001b[38Gexceso\u001b[45Gde\u001b[48Gpalabras.\u001b[58GRecorto\u001b[66Gtexto\u001b[72Gvisible\u001b[80Gy\u001b[82Gcorrijo\u001b[90Gun\u001b[93Gn\u00famero\u001b[100Gdicho\u001b[106Gen\u001b[109Gel\u001b[112Gguion\u001b[118G(la\u001b[122Gbrecha\u001b[129Ges\u001b[132G14,1\u001b[137Gpts,\u001b[142Gno\u001b[145G15).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mConstruido.\u001b[15GReviso\u001b[22Glas\u001b[26Gcapturas\u001b[35Grenderizadas.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m6\u001b[22m files, listed \u001b[1m1\u001b[22m directory \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mCuatro l\u00e1minas\u001b[18Gse\u001b[21Gven bien. Hay que\u001b[39Gcorregir\u001b[48Gla\u001b[51Gde\u001b[54Gbarras\u001b[61G(se\u001b[65Gdesborda\u001b[74Ga\u001b[76Gambos\u001b[82Glados),\u001b[90Gel\u001b[93Gcolor\u001b[99G(el\u001b[103Gacento\u001b[110Gest\u00e1"]
[239.0351, "o", "\u001b[115Gen\u001b[118Ghombres\u001b[126Gy\u001b[128Gla\u001b[131Ghistoria\u001b[140Ges\u001b[143Gsobre\r\u001b[2C\u001b[1Blas\u001b[7Gmujeres)\u001b[16Gy\u001b[18Gel\u001b[21Gcorte\u001b[27Gde\u001b[30Gl\u00ednea\u001b[36Gen\u001b[39G\u201cC\u2013F\u201d.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa l\u00e1mina de barras se\u001b[26Gdesborda porque\u001b[42Gel moto\u001b[50G fija las barras\u001b[67Gen\u001b[70G86\u001b[73Gpx\u001b[76Gy\u001b[78Gseis\u001b[83Gdepartamentos\u001b[97Gno\u001b[100Gcaben;\u001b[107Gvoy\u001b[111Ga\u001b[113Ga\u00f1adir\u001b[120Gun\u001b[123Gscript\u001b[130Gde\u001b[133Gbuild\u001b[139Greproducible\r\u001b[2C\u001b[1Bque\u001b[7Gaplique\u001b[15Gun\u001b[18Gpeque\u00f1o\u001b[26Gajuste\u001b[33GCSS\u001b[37Gtras\u001b[42Gcompilar.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLas capturas se toman dentro de build.py, antes\u001b[51Gde\u001b[54Gaplicar\u001b[62Gel\u001b[65Gajuste.\u001b[73GLas\u001b[77Gvuelvo\u001b[84Ga\u001b[86Gtomar\u001b[92Gcon\u001b[96Gel\u001b[99GCSS\u001b[103Gya\u001b[106Gaplicado.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?"]
