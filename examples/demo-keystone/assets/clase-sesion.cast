[303.5979, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLo que decid\u00ed por mi cuenta:\r\u001b[1B\u001b[22m \u001b[3G- Que la clase dure 15 minutos.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLa\u001b[8Gmarca\u001b[14G\u001b[38;2;177;185;249mneutral\u001b[39m,\u001b[23Galternando\u001b[34Gl\u00e1minas\u001b[42Goscuras\u001b[50Gy\u001b[52Gclaras.\r\u001b[1B \u001b[3G- Que el total sea de e\u001b[27Gos seis\u001b[35Gdepartamentos\u001b[49Gy\u001b[51Gno\u001b[54Gde\u001b[57Gtoda\u001b[62Gla\u001b[65Guniversidad.\u001b[78GLa\u001b[81Gl\u00e1mina\u001b[88G2\u001b[90Glo\u001b[93Gdice,\u001b[99Gy\u001b[101Gen\u001b[104Gel\u001b[107Gguion\u001b[113Glo\u001b[116Gexplico\u001b[124Gen\u001b[127Gvoz\u001b[131Galta.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPendientes y ajustes:\r\u001b[1B\u001b[22m \u001b[3G-\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[303.8642, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEjemplo y fuente.\u001b[21G\u001b[22mUs\u00e9\u001b[25Gel\u001b[28Gcaso\u001b[33Gde\u001b[36Gadmisiones\u001b[47Gde\u001b[50GBerkeley\u001b[59Gde\u001b[62G1973,\u001b[68Gel\u001b[71Gejemplo\u001b[79Gcl\u00e1sico\u001b[87Gde\u001b[90Gla\u001b[93Gparadoja\u001b[102Gde\u001b[105GSimpson.\u001b[114GLos\u001b[118Gdatos\u001b[124Gson\u001b[128Glos\u001b[132Gconteos\u001b[140Gde\u001b[143Glos\u001b[147Gseis\r\u001b[2C\u001b[1Bdepartamentos m\u00e1s\u001b[21Ggrandes, \u001b[31Geg\u00fan\u001b[36GBickel, Hamm\u001b[49Gl y O'Connell (1975),\u001b[71G\u001b[3mScience\u001b[79G\u001b[23m187(4175),\u001b[90G398\u2013404, y el dataset \u001b[38;2;177;185;249mUCBAdmissions\u001b[39m de R.\u001b[132GT\u001b[134Gdas las cifra\u001b[148G\u001b[K\r\u001b[2C\u001b[1Blas calcula \u001b[38;2;177;185;249mdeck/data/berkeley.py\u001b[39m; ninguna est\u00e1\u001b[51Gescrita a mano.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLa idea central:\u001b[20G\u001b[22mun\u001b[23Gpromedio\u001b[32Gtotal\u001b[38Gmezcla\u001b[45Glo\u001b[48Gque\u001b[52Gpasa\u001b[57Gdentro\u001b[64Gde\u001b[67Gcada\u001b[72Ggrupo\u001b[78Gcon\u001b[82Gc\u00f3mo\u001b[87Gse\u001b[90Greparte\u001b[98Gla\u001b[101Ggente\u001b[107Gentre\u001b[113Ggrupos,\u001b[121Gy\u001b[123Gesa\u001b[127Gmezcla\u001b[134Gpuede\u001b[140Ginvertir\u001b[149Gla\r\u001b[2C\u001b[1Bconclusi\u00f3n.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
