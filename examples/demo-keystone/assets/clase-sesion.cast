[128.3775, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora leo las skills de\u001b[27Gnarrativa,\u001b[38Ggram\u00e1tica\u001b[48Gvisual\u001b[55Gy\u001b[57Gevidencia.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSigo armando el deck:\u001b[25Greviso\u001b[32Gc\u00f3mo\u001b[37Gkeystone\u001b[46Gresuelve\u001b[55Glas\u001b[59Gcifras\u001b[66Gantes\u001b[72Gde\u001b[75Gescribir\u001b[84Glos\u001b[88Gdatos.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDatos decididos: tomo\u001b[25Gel\u001b[28Gcaso\u001b[33Gde\u001b[36Gadmisiones\u001b[47Gde\u001b[50GBerkeley\u001b[59Gde\u001b[62G1973\u001b[67Gcon\u001b[71Glos\u001b[75Gconteos\u001b[83Gde\u001b[86Glos\u001b[90Gseis\u001b[95Gdepartamentos\u001b[109Gm\u00e1s\u001b[113Ggrandes.\u001b[122GAhora\u001b[128Gescribo\u001b[136Gel\u001b[139Gscript\u001b[146Gque\r\u001b[2C\u001b[1Bcalcula\u001b[11Glas\u001b[15Gcifras.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1o3mmj7;file://~/Desktop/keystone-clase-demo/deck/data/berkeley.py\u0007deck/data/berkel"]
[128.3793, "o", "ey.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m108\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b]8;id=1o3mmj7;file://~/Desktop/keystone-clase-demo/deck/data/berkeley.py\u0007\u001b[1mdeck/data/berkeley.py\u001b]8;;\u0007\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env python3\r\u001b[1B\u001b[39m     \u001b[2m  2 \u001b[22m\u001b[38;2;230;219;116m\"\"\"Compute every figure of the deck from the Berkeley 1973 admission counts.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m3\u001b[10G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22mCounts: six largest departments, fall \u001b[38;2;190;132;255m1973\u001b[39m, \u001b[38;2;249;38;114mas\u001b[39m distributed \u001b[38;2;249;38;114min\u001b[39m \u001b[38;2;230;219;116mR'\u001b[75G `datase\u001b[85G::UCBAdmissions`\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[10G\u001b[22m(\u001b[38;2;249;38;114mfrom\u001b[16G\u001b[39mBickel,\u001b[24GHammel\u001b[31G&\u001b[33GO\u001b[38;2;230;219;116m'Connell, 1975). Writes ../evidence.json and fills the bar values\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m6\u001b[10G\u001b[22mof the `departam\u001b[27Gn\u001b[29Gos` slid\u001b[38G \u001b[38;2;249;38;114min\u001b[39m ../deck.json, so no numb\u001b[67Gr\u001b[70G\u001b[38;2;249;38;114ms\u001b[72G\u001b[39mtyped by hand.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b"]
[128.3816, "o", "[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mRun:  python3 data/berke\u001b[35Gey.py \u001b[42G (\u001b[38;2;249;38;114mfrom\u001b[39m the deck folder)\u001b[K\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;230;219;116m\"\"\"\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m10\u001b[10G\u001b[22m\u001b[38;2;249;38;114mimport\u001b[39m json\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m\u2026 +98 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora el guion (talk.md)\u001b[28Gy\u001b[30Gel\u001b[33Gdeck.json.\r\u001b[2B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=14irau9;file://~/Desktop/keystone-clase-demo/deck/talk.md\u0007deck/talk.md\u001b]8;;\u0007)\u001b[K\r\u001b[20C\u001b[2B\u001b[38;2;153;153;153mrunning PreToolUse hook \u00b7 1m 49s \u00b7 \u2193\u001b[58G9.5k tokens)\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[128.4304, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[5Gd\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[128.6309, "o", "\u001b]0;\u25d1 L\u00e1minas Keystone sobre promedios enga\u00f1osos\u0007"]
[128.6484, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u00b7\u001b[4Gi\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[128.7516, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[33B\u001b[38;2;215;119;87mF\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[128.7748, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[20C\u001b[33B\u001b[38;2;153;153;153m1m 49s \u00b7 \u2193\u001b[39m \u001b[38;2;153;153;153m9.5k tokens)\u001b[39m\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[128.8429, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 22 +\u001b[38;2;248;248;242mCada departamento decide sus admisiones por separado, as\u00ed que la comparaci\u00f3n justa es dentro de cada uno. Recorran el gr\u00e1fico de izqu\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242mierda a derecha. En el departamento A las mujeres entran en una proporci\u00f3n mucho mayor que los hombres. En B, D y F tambi\u00e9n van levem\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mente arriba. En C y E van levemente abajo, por pocos puntos. Ning\u00fan departamento muestra la brecha de quince puntos que vimos en el t\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242motal. Esta es la paradoja de Simpson: la direcci\u00f3n de la comparaci\u00f3n en el total no coincide con la direcci\u00f3n dentro de los grupos.  \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 23 +\u001b[38;2;248;248;242m**Pasa a:** si dentro de cada departamento no hay brecha, \u00bfde d\u00f3nde sale la brecha del total?                                        \r\u001b[5C\u001b[1B\u001b[38;2;8"]
[128.847, "o", "0;200;80m 24 +\u001b[38;2;248;248;242m                                                                                                                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 25 +\u001b[38;2;248;248;242m## composicion \u00b7 Docente \u00b7 3:00                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 26 +\u001b[38;2;248;248;242m**En la l\u00e1mina:** qu\u00e9 parte de cada grupo postul\u00f3 a los cuatro departamentos m\u00e1s selectivos, y cu\u00e1n dif\u00edcil era entrar en ellos.     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 27 +\u001b[38;2;248;248;242mLa diferencia est\u00e1 en a d\u00f3nde postul\u00f3 cada grupo. Casi todas las mujeres postularon a los departamentos C a F, donde entra uno de cad\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242ma cuatro. La mitad de los hombres postul\u00f3 a A y B, donde entran m\u00e1s de seis de cada diez. El promedio total de las mujeres es bajo po\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +"]
[128.8482, "o", "\u001b[38;2;248;248;242mrque eligieron programas dif\u00edciles, no porque cada programa las tratara peor. Los autores lo dicen as\u00ed: el sesgo, si existe, est\u00e1 ant\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242mes de la postulaci\u00f3n, en qu\u00e9 carreras se considera que son para qui\u00e9n. Esto no prueba que no haya discriminaci\u00f3n; muestra que este pr\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242momedio no es la evidencia para decidirlo.                                                                                            \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 28 +\u001b[38;2;248;248;242m**Pasa a:** \u00bfc\u00f3mo se escribe esto de forma general, para reconocerlo en otros datos?                                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 29 +\u001b[38;2;248;248;242m                                                                                                                                     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 30 +\u001b[38;2;248;248"]
[128.8493, "o", ";242m## formula \u00b7 Docente \u00b7 3:00                                                                                                          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 31 +\u001b[38;2;248;248;242m**En la l\u00e1mina:** la tasa total como adición de pesos por tasas.                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 32 +\u001b[38;2;248;248;242mDefinan los s\u00edmbolos en la pizarra. La tasa total de un grupo es la adición, sobre los departamentos, del peso de cada departamento por \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242msu tasa. El peso es la fracci\u00f3n de ese grupo que postul\u00f3 ah\u00ed; la tasa es la proporci\u00f3n admitida ah\u00ed. Dos grupos pueden tener tasas id\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242m\u00e9nticas en cada departamento y aun as\u00ed promedios totales muy distintos, solo porque sus pesos son distintos. Cuando los pesos se corr\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242melacionan con la dificultad, el promedio agregado compara composicio"]
[128.8504, "o", "nes, no desempe\u00f1os. Esto pasa igual con hospitales y la gravedad \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242mde sus pacientes, con colegios y el nivel de ingreso de sus familias, con tratamientos y qui\u00e9n los recibe.                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 33 +\u001b[38;2;248;248;242m**Pasa a:** \u00bfsaben aplicarlo a un caso nuevo?                                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 34 +\u001b[38;2;248;248;242m                                                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 35 +\u001b[38;2;248;248;242m## pregunta \u00b7 Docente \u00b7 3:00                                                                                                         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 36 +\u001b[38;2;248;248;242m**En la l\u00e1mina:** un caso con tres preguntas posibles; cada clic revela una opci\u00f3n.                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 37 +\u001b[38;2"]
[128.8515, "o", ";248;248;242m**Clic:** aparece cada opci\u00f3n; la correcta queda destacada.                                                                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 38 +\u001b[38;2;248;248;242mLean el caso: el hospital A tiene una mortalidad promedio m\u00e1s alta que el hospital B. Pidan que cada estudiante elija una opci\u00f3n ante\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242ms de revelar. La correcta es la B: qu\u00e9 mezcla de pacientes graves recibe cada hospital, porque la gravedad es el peso que puede inver\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mtir la comparaci\u00f3n, igual que la selectividad en Berkeley. La A no sirve: el volumen total no cambia la composici\u00f3n. La C tampoco: el\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242m presupuesto puede explicar algo, pero no corrige que uno reciba los casos m\u00e1s dif\u00edciles. Cierren con la regla de la clase: antes de \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mcomparar dos promedios, pregunte"]
[128.8526, "o", "n c\u00f3mo se reparte cada grupo entre las categor\u00edas que importan, y comparen dentro de ellas.          \u001b[49m\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
