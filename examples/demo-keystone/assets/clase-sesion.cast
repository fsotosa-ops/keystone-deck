[106.4698, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m\u276f \u001b[38;2;255;255;255mUsa keystone para armar una clase de 6 l\u00e1minas para estudiantes de mag\u00edster: por qu\u00e9 el promedio puede enga\u00f1ar. Con un ejemplo con n\u00fameros y su \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mfuente, y constr\u00fayela como deck en vivo. Si tienes dudas, decide t\u00fa y construye sin esperar mi confirmaci\u00f3n.\u001b[39m                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mSkill\u001b[22m(keystone:new)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mLoaded\u001b[13Gskill\r\u001b[2B  \u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora\u001b[9Gleo\u001b[13Glas\u001b[17Gskills\u001b[24Gde\u001b[27Gnarrativa,\u001b[38Ggram\u00e1tica\u001b[48Gvisual\u001b[55Gy\u001b[57Gevidencia.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSigo armando el deck:\u001b[25Greviso\u001b[32Gc\u00f3mo\u001b[37Gkeystone\u001b[46Gresuelve\u001b[55Glas\u001b[59Gcifras\u001b[66Gantes\u001b[72Gde\u001b[75Gescribir\u001b[84Glos\u001b[88Gdatos.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1"]
[106.4921, "o", "m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDatos decididos: tomo\u001b[25Gel\u001b[28Gcaso\u001b[33Gde\u001b[36Gadmisiones\u001b[47Gde\u001b[50GBerkeley\u001b[59Gde\u001b[62G1973\u001b[67Gcon\u001b[71Glos\u001b[75Gconteos\u001b[83Gde\u001b[86Glos\u001b[90Gseis\u001b[95Gdepartamentos\u001b[109Gm\u00e1s\u001b[113Ggrandes.\u001b[122GAhora\u001b[128Gescribo\u001b[136Gel\u001b[139Gscript\u001b[146Gque\r\u001b[2C\u001b[1Bcalcula\u001b[11Glas\u001b[15Gcifras.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1o3mmj7;file://~/Desktop/keystone-clase-demo/deck/data/berkeley.py\u0007deck/data/berkeley.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mWrote \u001b[1m108\u001b[22m lines to\u001b[25G\u001b]8;id=1o3mmj7;file://~/Desktop/keystone-clase-demo/deck/data/berkeley.py\u0007\u001b[1mdeck/data/berkeley.py\u001b]8;;\u0007\r\u001b[5C\u001b[1B\u001b[22m\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env python3\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  2 \u001b[22m\u001b[38;2;230;219;116m\"\"\"Compute every figure of the deck from the Berkeley 1973 admission counts.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  3 \u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22mCounts:\u001b[18Gsix\u001b[22Glargest"]
[106.4939, "o", "\u001b[30Gdepartments,\u001b[43Gfall\u001b[48G\u001b[38;2;190;132;255m1973\u001b[39m,\u001b[54G\u001b[38;2;249;38;114mas\u001b[57G\u001b[39mdistributed\u001b[69G\u001b[38;2;249;38;114min\u001b[72G\u001b[38;2;230;219;116mR's `datasets::UCBAdmissions`\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  5 \u001b[22m(\u001b[38;2;249;38;114mfrom\u001b[39m Bickel, Hammel &\u001b[33GO\u001b[38;2;230;219;116m'Connell, 1975). Writes ../evidence.json and fills the bar values\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  6 \u001b[22mof\u001b[13Gthe\u001b[17G`departamentos`\u001b[33Gslide\u001b[39G\u001b[38;2;249;38;114min\u001b[42G\u001b[39m../deck.json,\u001b[56Gso\u001b[59Gno\u001b[62Gnumber\u001b[69G\u001b[38;2;249;38;114mis\u001b[72G\u001b[39mtyped\u001b[78Gby\u001b[81Ghand.\r\u001b[5C\u001b[1B\u001b[2m  7 \r\u001b[5C\u001b[1B  8 \u001b[22mRun:\u001b[16Gpython3\u001b[24Gdata/berkeley.py\u001b[43G(\u001b[38;2;249;38;114mfrom\u001b[49G\u001b[39mthe\u001b[53Gdeck\u001b[58Gfolder)\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m\u001b[38;2;230;219;116m\"\"\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 10 \u001b[22m\u001b[38;2;249;38;114mimport\u001b[17G\u001b[39mjson\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m\u2026 +98 lines \u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
