[304.9258, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G\u001b[1mEjemplo y fuente.\u001b[21G\u001b[22mUs\u00e9\u001b[25Gel\u001b[28Gcaso\u001b[33Gde\u001b[36Gadmisiones\u001b[47Gde\u001b[50GBerkeley\u001b[59Gde\u001b[62G1973,\u001b[68Gel\u001b[71Gejemplo\u001b[79Gcl\u00e1sico\u001b[87Gde\u001b[90Gla\u001b[93Gparadoja\u001b[102Gde\u001b[105GSimpson.\u001b[114GLos\u001b[118Gdatos\u001b[124Gson\u001b[128Glos\u001b[132Gconteos\u001b[140Gde\u001b[143Glos\u001b[147Gseis\r\u001b[2C\u001b[1Bdepartamentos m\u00e1s\u001b[21Ggrandes, \u001b[31Geg\u00fan\u001b[36GBickel, Hamm\u001b[49Gl y O'Connell (1975),\u001b[71G\u001b[3mScience\u001b[79G\u001b[23m187(4175),\u001b[90G398\u2013404, y el dataset \u001b[38;2;177;185;249mUCBAdmissions\u001b[39m de R.\u001b[132GT\u001b[134Gdas las cifra\u001b[148G\u001b[K\r\u001b[2C\u001b[1Blas calcula \u001b[38;2;177;185;249mdeck/data/berkeley.py\u001b[39m; ninguna est\u00e1\u001b[51Gescrita a mano.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLa idea central:\u001b[20G\u001b[22mun\u001b[23Gpromedio\u001b[32Gtotal\u001b[38Gmezcla\u001b[45Glo\u001b[48Gque\u001b[52Gpasa\u001b[57Gdentro\u001b[64Gde\u001b[67Gcada\u001b[72Ggrupo\u001b[78Gcon\u001b[82Gc\u00f3mo\u001b[87Gse\u001b[90Greparte\u001b[98Gla\u001b[101Ggente\u001b[107Gentre\u001b[113Ggrupos,\u001b[121Gy\u001b[123Gesa\u001b[127Gmezcla\u001b[134Gpuede\u001b[140Ginvertir\u001b[149Gla\r\u001b[2C\u001b[1Bconclusi\u00f3n.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[304.9271, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502  #  \u2502       L\u00e1mina       \u2502                                                    Qu\u00e9 muestra                                                     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 1   \u2502 Portada            \ufffd"]
[304.9284, "o", "\ufffd\ufffd Por qu\u00e9 el promedio puede enga\u00f1ar                                                                                  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 2   \u2502 El total           \u2502 Se admiti\u00f3 al 44,5 % de los hombres y al 30,4 % de las mujeres: una brecha de 14,2 puntos                          \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[304.9298, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 3   \u2502 Por departamento   \u2502 En 4 de los 6 departamentos se admiti\u00f3 a una proporci\u00f3n mayor de mujeres; en el A, 20 puntos m\u00e1s                   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 4   \u2502 El mecanismo       \u2502 El 93 % de las mujeres postul\u00f3 a los cuatro departamentos m\u00e1s selectivos, contra el 49 % de los hombres. Ah\u00ed solo  \u2502\r\u001b[4C\u001b[1B \u001b[11G  \u001b[14G         \u001b[32Gentr\u00f3\u001b[38Gel 26 % \u001b[47G       \u001b[55G       \u001b[63G \u001b[65G   \u001b[69G  "]
[304.931, "o", "    \u001b[76G             \u001b[90G   \u001b[94G           \u001b[106G      \u001b[113G  \u001b[116G  \u001b[119G \u001b[121G  \u001b[124G   \u001b[128G        \u001b[137G   \u001b[141G    \r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 5   \u2502 La f\u00f3rmula         \u2502 Tasa total = \u03a3 peso del grupo \u00d7 tasa del grupo                                                                     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
[304.9324, "o", "\ufffd\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 6   \u2502 Pregunta de        \u2502 El hospital A tiene m\u00e1s mortalidad que el B: \u00bfqu\u00e9 preguntas primero? La respuesta correcta se destaca al hacer     \u2502\r\u001b[4C\u001b[1B \u001b[11Gcontrol \u001b[20G  \u001b[32Gc\u001b[34Gic       \u001b[44G \u001b[46G     \u001b[52G   \u001b[56G          \u001b[67G   \u001b[71G  \u001b[74G  \u001b[77G    \u001b[82G         \u001b[92G        \u001b[101G  \u001b[104G         \u001b[114G        \u001b[123G  \u001b[126G       \u001b[134G  \u001b[137G     \r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLo que"]
[304.9337, "o", " decid\u00ed por mi cuenta:\r\u001b[2C\u001b[1B\u001b[22m- Que la clase dure 15 minutos.\r\u001b[4C\u001b[1BLa marca \u001b[38;2;177;185;249mneutral\u001b[39m,\u001b[23Galter\u001b[29Gando l\u00e1minas\u001b[42Goscuras\u001b[50Gy\u001b[52Gclaras.\r\u001b[4C\u001b[1BQue el total sea de esos seis departamentos y no de toda\u001b[62Gla\u001b[65Guniversidad.\u001b[78GLa\u001b[81Gl\u00e1mina\u001b[88G2\u001b[90Glo\u001b[93Gdice,\u001b[99Gy\u001b[101Gen\u001b[104Gel\u001b[107Gguion\u001b[113Glo\u001b[116Gexplico\u001b[124Gen\u001b[127Gvoz\u001b[131Galta.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPendientes y ajustes:\r\u001b[2C\u001b[1B\u001b[22m- Tres l\u00e1minas tienen\u001b[25Gunas\u001b[30G27\u001b[33Ga\u001b[35G30\u001b[38Gpalabras\u001b[47Gvisibles.\u001b[57GKeystone\u001b[66Grecomienda\u001b[77G25\u001b[80Gcomo\u001b[85Gm\u00e1ximo;\u001b[93Ges\u001b[96Gun\u001b[99Gaviso,\u001b[106Gno\u001b[109Gun\u001b[112Gerror.\r\u001b[4C\u001b[1BCon seis departam\u001b[24Gtos, las\u001b[33Gbarras no c\u001b[45Gb\u00edan con el\u001b[57Gancho que trae keystone. Agregu\u00e9 un\u001b[93Gajuste de estilo en \u001b[38;2;177;185;249mdeck/theme/overrides.css\u001b[39m.\u001b[139GPor\u001b[143Geso\u001b[147Ghay\r\u001b[2C\u001b[1B \u001b[5Gque\u001b[9Gr\u001b[11Gconstruir co\u001b[24G \u001b[38;2;177;185;249mdeck/build.sh\u001b[39m,\u001b[40Gque rec\u001b[48Glcula\u001b[54Glas cifras, compila, aplica\u001b[82Gel aj\u001b[88Gste y toma las\u001b[103Gc"]
