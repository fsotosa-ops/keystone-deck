[107.9002, "o", "m\u001b[1mWrite\u001b[22m(\u001b]8;id=1o3mmj7;file://~/Desktop/keystone-clase-demo/deck/data/berkeley.py\u0007deck/data/berkeley.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m108\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b]8;id=1o3mmj7;file://~/Desktop/keystone-clase-demo/deck/data/berkeley.py\u0007\u001b[1mdeck/data/berkeley.py\u001b]8;;\u0007\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env python3\r\u001b[1B\u001b[39m     \u001b[2m  2 \u001b[22m\u001b[38;2;230;219;116m\"\"\"Compute every figure of the deck from the Berkeley 1973 admission counts.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m3\u001b[10G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22mCounts: six largest departments, fall \u001b[38;2;190;132;255m1973\u001b[39m, \u001b[38;2;249;38;114mas\u001b[39m distributed \u001b[38;2;249;38;114min\u001b[39m \u001b[38;2;230;219;116mR'\u001b[75G `datase\u001b[85G::UCBAdmissions`\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[10G\u001b[22m(\u001b[38;2;249;38;114mfrom\u001b[16G\u001b[39mBickel,\u001b[24GHammel\u001b[31G&\u001b[33GO\u001b[38;2;230;219;116m'Connell, 1975). Writes ../evidence.json and fills the bar values\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m6\u001b[10G\u001b[22mof the `departam\u001b[27Gn\u001b[29Gos` slid\u001b[38G \u001b[38;2;2"]
