[198.4959, "o", "        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[15G\u001b[38;2;248;248;242m \u001b[17G\u001b[38;2;166;226;46m\"kicker\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Pregunta de control\"\u001b[38;2;248;248;242m,                                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[18G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El hospital A tiene mayor mortalidad que B. \u00bfQu\u00e9 preguntas primero?\"\u001b[38;2;248;248;242m,\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[18G\u001b[38;2;166;226;46mreveal\u001b[28G\u001b[38;2;230;219;116mitem\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m80\u001b[18G\u001b[38;2;166;226;46mit\u001b[22Gs\u001b[26G\u001b[38;2;248;248;242m[      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m81\u001b[17G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"label\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"A\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"title\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"\u00bfCu\u00e1ntos pacientes atiende en total?\"\u001b[38;2;248;248;242m},\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m82\u001b[17G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"\u001b[22Gabel\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"B"]
[198.4966, "o", "\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"title\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"\u00bfQu\u00e9 mezcla de pacient\u001b[67Gs graves\u001b[76Grecibe cada uno?\"\u001b[38;2;248;248;242m}, \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m83\u001b[17G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"l\u001b[23Gbel\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"C\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"title\"\u001b[38;2;248;248;242m:\u001b[43G\u001b[38;2;230;219;116m\"\u00bfCu\u00e1l tiene mayor presupuesto?\"\u001b[38;2;248;248;242m}\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[17G\u001b[38;2;248;248;242m],                                                                                                                             \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[17G\u001b[38;2;166;226;46m\"highlight\"\u001b[38;2;248;248;242m: \u001b[38;2;190;132;255m1\u001b[38;2;248;248;242m  \u001b[34G        \u001b[43G                                        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 86 \u001b[22m     }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 87 \u001b[22m   ]\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 88 \u001b[22m }\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos ch"]
