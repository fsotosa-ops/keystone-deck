[134.5573, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  \u001b[11G\u001b[38;2;248;248;242mente\u001b[16Garriba. E\u001b[26G C\u001b[29Gy E van levemente abajo, por pocos puntos. Ning\u00fan dep\u001b[83Grtamento mu\u001b[96Gtra la br\u001b[106Gch\u001b[109G de quinc\u001b[119G puntos que vimos\u001b[137Gen\u001b[140Gel t\r\u001b[10C\u001b[1Botal.\u001b[17GEsta \u001b[23Gs la\u001b[28Gparadoja de Simps\u001b[46Gn:\u001b[51G direcci\u00f3n de la\u001b[68Gcomparaci\u00f3n en el\u001b[86Gtotal\u001b[92Gno coincide con la direcci\u00f3n\u001b[121Gdentro de los\u001b[135Ggrupos.  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m23\u001b[11G\u001b[38;2;248;248;242m**Pas\u001b[17G a:** si dentro\u001b[33Gde cada d\u001b[43Gpart\u001b[48Gmento\u001b[54Gn\u001b[56G hay brecha, \u00bfde d\u00f3nde\u001b[79Gsale l\u001b[86G brecha del tot\u001b[102Gl?     \u001b[110G  \u001b[113G      \u001b[120G      \u001b[127G   \u001b[131G     \u001b[137G  \u001b[140G  \u001b[143G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m24\u001b[11G\u001b[38;2;248;248;242m     \u001b[17G    \u001b[22G  \u001b[25G  \u001b[28G        \u001b[37G  \u001b[40G        \u001b[49G  \u001b[52G         \u001b[62G  \u001b[65G  \u001b[68G           \u001b[80G  \u001b[83G  \u001b[86G     \u001b[92G  \u001b[95G        \u001b[104G   \u001b[108G  \u001b[111G         \u001b[121G      \u001b[128G  \u001b[131G   \u001b[135G       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[11G\u001b[38"]
[134.5585, "o", ";2;248;248;242m## composicion\u001b[26G\u00b7 Docent\u001b[36G\u00b7 3:00           \u001b[54G  \u001b[57G   \u001b[61G       \u001b[69G   \u001b[73G     \u001b[79G    \u001b[84G  \u001b[87G      \u001b[94G   \u001b[98G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242m**En\u001b[16Gla\u001b[19Gl\u00e1mina:**\u001b[29Gqu\u00e9\u001b[33Gparte\u001b[39Gde\u001b[42Gcada\u001b[47Ggrupo\u001b[53Gpostul\u00f3\u001b[61Ga\u001b[63Glos\u001b[67Gcuatro\u001b[74Gdepartamentos\u001b[88Gm\u00e1s\u001b[92Gselectivos,\u001b[104Gy\u001b[106Gcu\u00e1n\u001b[111Gdif\u00edcil\u001b[119Gera\u001b[123Gentrar\u001b[130Gen\u001b[133Gellos.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;248;248;242mLa\u001b[14Gdiferen\u001b[23Ga est\u00e1 en a d\u00f3nde postul\u00f3\u001b[49Gcada\u001b[54Ggrupo.\u001b[61GCasi\u001b[66Gtodas\u001b[72Glas\u001b[76Gmujeres\u001b[84Gpostularon\u001b[95Ga\u001b[97Glos\u001b[101Gdepartamentos\u001b[115GC\u001b[117Ga\u001b[119GF,\u001b[122Gdonde\u001b[128Gentra\u001b[134Guno\u001b[138Gde\u001b[141Gcad\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242ma cuatro. La mitad de\u001b[33Glos hombres post\u001b[50Gl\u00f3\u001b[53Ga A y B, donde en\u001b[72Gan m\u00e1s de seis de cada diez. El\u001b[104Gpromedio tota\u001b[119Gde las mujeres es bajo\u001b[142Gpo\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mrque eligieron program\u001b[34Gs dif\u00edciles, no porq"]
[134.5598, "o", "ue cada program\u001b[70G las trata\u001b[81Ga pe\u001b[86Gr. Los autore\u001b[101Glo dicen as\u00ed:\u001b[115Gel sesgo, si\u001b[129Gxiste, est\u00e1\u001b[141Gant\r\u001b[10C\u001b[1Bes de la postulaci\u00f3n,\u001b[33Gen qu\u00e9 carrera\u001b[48G se considera\u001b[62Gque son para\u001b[75Gqui\u00e9n.\u001b[82GEsto\u001b[87Gno\u001b[90Gprueba que\u001b[101Gno\u001b[104Ghaya \u001b[111Gscriminaci\u00f3n; muest\u001b[131Ga que\u001b[137Geste\u001b[143Gr\r\u001b[10C\u001b[1Bomedio no \u001b[22Gs la evidencia para d\u001b[44Gcidirlo.    \u001b[57G    \u001b[62G        \u001b[71G   \u001b[75G       \u001b[83G     \u001b[89G   \u001b[93G       \u001b[101G  \u001b[104G     \u001b[110G    \u001b[115G  \u001b[118G      \u001b[125G  \u001b[128G       \u001b[136G    \u001b[141G   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m28\u001b[11G\u001b[38;2;248;248;242m**Pasa \u001b[19G:** \u00bfc\u00f3mo se escribe\u001b[40Gesto de forma general, para reconocerlo en o\u001b[85Gros datos? \u001b[97G   \u001b[101G  \u001b[104G    \u001b[109G               \u001b[125G       \u001b[133G   \u001b[137G    \u001b[142G  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m29\u001b[11G\u001b[38;2;248;248;242m      \u001b[18G  \u001b[21G  \u001b[24G  \u001b[27G         \u001b[37G    \u001b[42G          \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m30\u001b[11G\u001b[38;2;248;248;242m## formula \u00b7 Docent\u001b[32G\u00b7 3:00 \u001b[40G    \u001b[45G  \u001b[48G     \u001b[54G    "]
[134.5609, "o", "    \u001b[63G    \u001b[68G           \u001b[80G  \u001b[83G     \u001b[89G      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m31\u001b[11G\u001b[38;2;248;248;242m**En\u001b[16Gla\u001b[19Gl\u00e1mina:**\u001b[29Gla\u001b[32Gtasa\u001b[37Gtotal\u001b[43Gcomo\u001b[48Gsuma\u001b[53Gde\u001b[56Gpesos\u001b[62Gpor\u001b[66Gtasas.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242mDefinan \u001b[20Gos s\u00edmbolos\u001b[32Gen la pizarra.\u001b[47GLa\u001b[50Gtasa\u001b[55Gtotal\u001b[61Gde\u001b[64Gun\u001b[67Ggrupo\u001b[73Ges\u001b[76Gla\u001b[79Gsuma,\u001b[85Gsobre\u001b[91Glos\u001b[95Gdepartamentos,\u001b[110Gdel\u001b[114Gpeso\u001b[119Gde\u001b[122Gcada\u001b[127Gdepartamento\u001b[140Gpor\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242msu tas\u001b[18G. El peso es la fracci\u00f3n\u001b[43Gde ese grupo\u001b[56Gque postul\u00f3 ah\u00ed;\u001b[73Gla\u001b[76Gtasa\u001b[81Ges\u001b[84Gla\u001b[87Gproporci\u00f3n\u001b[98Gadmitida\u001b[107Gah\u00ed.\u001b[112GDos\u001b[116Ggrupos\u001b[123Gpueden\u001b[130Gtener\u001b[136Gtasas\u001b[142Gid\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242m\u00e9nt\u001b[15Gc\u001b[17Gs\u001b[19Gen cada departamento y aun as\u00ed\u001b[50Gpromedios totales m\u001b[70Gy di\u001b[75Gtintos, sol\u001b[87G porque\u001b[95Gsus pesos s\u001b[107Gn distintos. Cuan\u001b[125Go\u001b[127Glos pesos se\u001b[140Gc\u001b[143Gr\r\u001b[10C\u001b[1Belacionan con la\u001b[28Gdifi"]
[134.5622, "o", "cult\u001b[37Gd, el\u001b[43Gpromedio agregado compara composiciones,\u001b[84Gno\u001b[87Gdesempe\u00f1os. Esto p\u001b[106Gs\u001b[108G igual con h\u001b[122Gpital\u001b[128Gs\u001b[130Gy la gr\u001b[138Gvedad \r\u001b[10C\u001b[1Bde sus pacientes, con colegios\u001b[42Gy el nivel d\u001b[55G \u001b[57Gngreso d\u001b[66G sus famil\u001b[77Gas, con tratamientos y qui\u00e9n los rec\u001b[114Gbe.  \u001b[120G      \u001b[127G   \u001b[131G     \u001b[137G  \u001b[140G    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m33\u001b[11G\u001b[38;2;248;248;242m**Pasa \u001b[19G:** \u00bfsaben aplicarlo\u001b[40Ga un caso nuevo?    \u001b[61G       \u001b[69G              \u001b[84G  \u001b[87G           \u001b[99G    \u001b[104G    \u001b[109G     \u001b[115G   \u001b[119G          \u001b[130G \u001b[132G  \u001b[135G        \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m34\u001b[11G\u001b[38;2;248;248;242m  \u001b[14G   \u001b[18G          \u001b[29G   \u001b[33G        \u001b[42G \u001b[44G  \u001b[47G     \u001b[53G  \u001b[56G       \u001b[64G  \u001b[67G   \u001b[71G         \u001b[81G   \u001b[85G            \u001b[98G \u001b[100G     \u001b[106G   \u001b[110G       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[11G\u001b[38;2;248;248;242m## pregunta\u001b[23G\u00b7 Docente \u00b7 3:00\u001b[40G \u001b[42G  \u001b[45G    \u001b[50G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242m**En\u001b[16Gla\u001b[19Gl\u00e1min"]
[134.5633, "o", "a:**\u001b[29Gun\u001b[32Gcaso\u001b[37Gcon\u001b[41Gtres\u001b[46Gpreguntas\u001b[56Gposibles;\u001b[66Gcada\u001b[71Gclic\u001b[76Grevela\u001b[83Guna\u001b[87Gopci\u00f3n.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;248;248;242m**Clic:** \u001b[22Gparece cada opci\u00f3n;\u001b[42Gla\u001b[45Gcorrecta\u001b[54Gqueda\u001b[60Gdestacada.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[11G\u001b[38;2;248;248;242mLea\u001b[16Gel\u001b[19Gcaso: el hospital\u001b[37GA tien\u001b[44G una mor\u001b[54Glidad promedio m\u00e1s alta que el hos\u001b[89Gital B.\u001b[97GPidan\u001b[103Gque\u001b[107Gcada\u001b[112Gestudiante\u001b[123Gelija\u001b[129Guna\u001b[133Gopci\u00f3n\u001b[140Gante\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242ms de revel\u001b[22Gr. La correcta es la B: qu\u00e9 mezcla \u001b[58Ge\u001b[60Gpacientes graves\u001b[77Grecibe\u001b[84Gcada\u001b[89Ghospital,\u001b[99Gporque\u001b[106Gla\u001b[109Ggravedad\u001b[118Ges\u001b[121Gel\u001b[124Gpeso\u001b[129Gque\u001b[133Gpuede\u001b[139Ginver\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mtir la comparaci\u00f3n, igu\u001b[37Gque la selectividad en\u001b[60GBerk\u001b[65Gley. La\u001b[73GA no\u001b[78Gsirv\u001b[83G:\u001b[85Gel volumen total no cambi\u001b[112Gla composici\u00f3n. La C\u001b[133Gtampoco: el\r\u001b[10C\u001b[1B pr\u001b[15Gsupu\u001b[20Gsto puede explicar a\u001b[41Ggo,"]
[134.5647, "o", " pero\u001b[50Gno \u001b[54Gorrige que uno reciba los casos m\u00e1s dif\u00edci\u001b[97Ges. Cierren\u001b[109Gcon la regla de la clase: antes d\u001b[143G \r\u001b[10C\u001b[1Bcomparar dos promedios, pregunten c\u00f3mo se reparte cada grupo entre\u001b[78Glas cat\u001b[86Ggor\u00edas que importan, y comp\u001b[114Gren dentro de\u001b[128Gellas.       \u001b[142G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1f324yd;file://~/Desktop/keystone-clase-demo/deck/deck.json\u0007deck/deck.json\u001b]8;;\u0007)\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[3G\u001b[38;2;230;149;117mFiddle-faddling\u2026\u001b[21G\u001b[38;2;153;153;153mrunning PreToolUse hook \u00b7 1m 59s \u00b7 \u2193\u001b[58G11.9k tokens)\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
