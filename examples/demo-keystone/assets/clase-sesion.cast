[305.0808, "o", "[43Gpromedio\u001b[52Gpuede\u001b[58Genga\u00f1ar\u001b[83G   \u001b[87G       \r\u001b[4C\u001b[2B2\u001b[11GEl \u001b[15Got\u001b[18Gl\u001b[32GSe admiti\u00f3\u001b[43Gal 44,5 % d\u001b[55G los homb\u001b[65Ges\u001b[68Gy\u001b[70Gal\u001b[73G30,4\u001b[78G%\u001b[80Gde\u001b[83Glas\u001b[87Gmujeres:\u001b[96Guna\u001b[100Gbrecha\u001b[107Gde\u001b[110G14,2\u001b[115Gpuntos\r\u001b[4C\u001b[2B3\u001b[11GPor departamento\u001b[32GEn\u001b[35G4 de los 6\u001b[46Gdepartam\u001b[55Gnt\u001b[60Gse admiti\u00f3 a\u001b[73Guna proporci\u00f3n mayor de muje\u001b[103Gs; en el A,\u001b[115G20 puntos\u001b[125Gm\u00e1s\r\u001b[4C\u001b[2B4\u001b[11GEl mecanismo    \u001b[33Gl\u001b[35G93 %\u001b[40Gde las mujeres postul\u00f3\u001b[64G los cu\u001b[72Gtro departamentos m\u00e1s\u001b[94Gs\u001b[96Glectivo\u001b[104G,\u001b[106Gcontra el 49 % de los hombres.\u001b[137GAh\u00ed\u001b[141Gsolo\r\u001b[2C\u001b[1B\u2502     \u2502                    \u2502 entr\u00f3 el 26 %                                                                                                      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
