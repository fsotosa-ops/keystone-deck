[484.5755, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m53\u001b[12G\u001b[38;2;248;248;242m            \u001b[25G    \u001b[30G  \u001b[33G         \u001b[43G  \u001b[46G      \u001b[53G      \u001b[60G  \u001b[63G        \u001b[72G  \u001b[75G   \u001b[79G    \u001b[84G  \u001b[87G      \u001b[94G   \u001b[98G  \u001b[101G      \u001b[108G    \u001b[113G        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242m## piloto \u00b7\u001b[23GPresentado\u001b[34G \u00b7 0:50   \u001b[45G         \u001b[55G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[11G\u001b[38;2;248;248;242m**En\u001b[16Gla\u001b[19Gl\u00e1mina:**\u001b[29Gcuatro\u001b[36Ghitos\u001b[42Gde\u001b[45Gun\u001b[48Gpiloto\u001b[55Gde\u001b[58Gseis\u001b[63Gmeses\u001b[69Gen\u001b[72Guna\u001b[76Gcomuna,\u001b[84Gtodos\u001b[90Gmarcados\u001b[99Gcomo\u001b[104Gmeta.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242mPro\u001b[15Gonem\u001b[20Gs una \u001b[27Gola c\u001b[33Gmuna y un\u001b[43Gradio\u001b[49Gcorto.\u001b[56GPrimer\u001b[63Gmes,\u001b[68Gsumamos\u001b[76Gproductores\u001b[88Gcon\u001b[92Gvisitas\u001b[100Gen\u001b[103Gterreno.\u001b[112GSegundo\u001b[120Gmes,\u001b[125Grestoranes\u001b[136Gy\u001b[138Gcolegi\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mos. A\u001b[17G cuarto mes, l\u001b[32G primera ruta semanal estable.\u001b[63GAl sexto, medimos una sola\u001b[90Gcosa: qu\u00e9"]
[484.5875, "o", " parte de las\u001b[113Gventas\u001b[120Gde\u001b[123Gestos\u001b[129Gproductores\u001b[141Gpas\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242m\u00f3 a ser directa. Si\u001b[31Gn\u001b[33G llegamos\u001b[43Ga la meta, lo decimos y paramos.\u001b[76G           \u001b[88G   \u001b[92G       \u001b[100G  \u001b[103G        \u001b[112G       \u001b[120G    \u001b[125G          \u001b[136G \u001b[138G      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m57\u001b[11G\u001b[38;2;248;248;242m**Pasa\u001b[18Ga:** \u00bfqu\u00e9 les ped\u001b[37Gos hoy? \u001b[46G       \u001b[54G        \u001b[63G  \u001b[66G      \u001b[73G       \u001b[81G   \u001b[85G    \u001b[90G     \u001b[96G   \u001b[100G     \u001b[106G  \u001b[109G   \u001b[113G      \u001b[120G  \u001b[123G     \u001b[129G           \u001b[141G   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m58\u001b[11G\u001b[38;2;248;248;242m \u001b[13G \u001b[15G   \u001b[19G        \u001b[28G  \u001b[31G  \u001b[34G        \u001b[43G \u001b[45G  \u001b[48G     \u001b[54G  \u001b[57G       \u001b[65G \u001b[67G        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[11G\u001b[38;2;248;248;242m## cierre \u00b7\u001b[23GPresentador \u00b7 0:40   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m60\u001b[11G\u001b[38;2;248;248;242m**En\u001b[16Gla\u001b[19Gl\u00e1mina:**\u001b[29GRosa\u001b[34Gcon\u001b[38Gsu\u001b[41Gpedido\u001b[48Gaceptado\u001b[57Gy\u001b[59Gla\u001b[62Gpetici\u00f3n\u001b[71Gconcreta.\r\u001b[6C\u001b[1B\u001b[38;"]
[484.5886, "o", "2;80;200;80m61\u001b[11G\u001b[38;2;248;248;242mVolvamos a Rosa. El jueves no espera\u001b[48Gal\u001b[51Gcami\u00f3n:\u001b[59Gsale\u001b[64Gcon\u001b[68Gdoce\u001b[73Glechugas\u001b[82Gpara\u001b[87Gel\u001b[90Gcolegio\u001b[98Gy\u001b[100Gdos\u001b[104Gcajas\u001b[110Gpara\u001b[115GDon\u001b[119GLalo,\u001b[125Ga\u001b[127Gun\u001b[130Gprecio\u001b[137Gque\u001b[141Gpus\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mo ella.\u001b[19GPara que esto pase\u001b[38Gde\u001b[41Gs\u001b[43Gr un\u001b[48Gej\u001b[51Gmplo a ser\u001b[62Gun dato,\u001b[71Gles p\u001b[77Gdimos\u001b[83Gtres\u001b[88Gcosas:\u001b[95Guna\u001b[99Gcomuna,\u001b[107Gcuatro\u001b[114Gcolegios\u001b[123Gy\u001b[125Gseis\u001b[130Grestoranes\u001b[141Gdis\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mpuestos a comprar durant\u001b[36G seis meses.  \u001b[51G       \u001b[59G    \u001b[64G   \u001b[68G    \u001b[73G        \u001b[82G    \u001b[87G  \u001b[90G       \u001b[98G \u001b[100G   \u001b[104G     \u001b[110G    \u001b[115G   \u001b[119G     \u001b[125G \u001b[127G  \u001b[130G      \u001b[137G   \u001b[141G   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m62\u001b[11G\u001b[38;2;248;248;242m**Pas\u001b[17G a:** fin;\u001b[28Gpreguntas.  \u001b[41G   \u001b[45G  \u001b[48G       \u001b[56G \u001b[58G   \u001b[62G  \u001b[65G     \u001b[71G   \u001b[75G       \u001b[83G    \u001b[88G      \u001b[95G   \u001b[99G       \u001b[107G      \u001b"]
