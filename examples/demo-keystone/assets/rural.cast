[1037.5584, "o", "ultura\u001b[88Gfamiliar\u001b[97Gal\u001b[100GPrograma\u001b[109Gde\u001b[112GAlimentaci\u00f3n\u001b[125GEscolar\u001b[133Gen\u001b[136G2023\u001b[141Gy\u001b[143Gel\u001b[146G5%\u001b[149Gde\r\u001b[2C\u001b[1B  compra local vienen de una nota de prensa.\u001b[48GLos\u001b[52Gsitios\u001b[59Gde\u001b[62GMineduc\u001b[70Gy\u001b[72GJUNAEB\u001b[79Grechazaron\u001b[90Gla\u001b[93Gconexi\u00f3n,\u001b[103Gas\u00ed\u001b[107Gque\u001b[111Gno\u001b[114Gpude\u001b[119Gverificar\u001b[129Gesas\u001b[134Gcifras\u001b[141Gen\u001b[144Gla\r\u001b[2C\u001b[1B \u001b[5Gfuente oficial.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEstudio de INDAP:\u001b[22m es de\u00a02015. La demanda p\u00fablica de US$ 450 millones es una estimaci\u00f3n de ese a\u00f1o.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLo inventado est\u00e1 marcado:\u001b[32G\u001b[22mla\u001b[35Giniciativa,\u001b[47Glos\u001b[51Gpersonajes,\u001b[63Glos\u001b[67Gmontos\u001b[74Gde\u001b[77Gla\u001b[80Gdemo,\u001b[86Gla\u001b[89Gcomisi\u00f3n\u001b[98Gy\u001b[100Glas\u001b[104Gmetas\u001b[110Gdel\u001b[114Gpiloto.\u001b[122GCada\u001b[127Gl\u00e1mina\u001b[134Gcon\u001b[138Gesos\u001b[143Gdatos\u001b[149Glo\r\u001b[2C\u001b[1B \u001b[5Gindica en su pie.\u001b[23G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mAvisos pen\u001b[16Gientes:\u001b[22m los chequeos de keystone pasan sin \u001b[60Grrore\u001b[66G. Quedan avisos de exces\u001b[91G de palabr\u001b[104Gen seis \u001b[113G\u00e1m\u001b[116Gnas, en p\u001b[126Grte por\u001b[134Gl\u001b[1"]
