[1035.6698, "o", "rurales t\u001b[55Gene Int\u001b[63Grnet y las\u001b[74Gb\u001b[76Gses del\u001b[84GPrograma de\u001b[96GAlimentaci\u00f3n\u001b[109GEscolar exigen 5% de compra local.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mAlternativas:\u001b[22m una matriz frente\u001b[38Gal cami\u00f3n i\u001b[50Gtermediari\u001b[61G,\u001b[63Gla\u001b[66Gferia\u001b[72Gm\u001b[74Gyorist\u001b[81G, la feria\u001b[92Glibre y\u001b[100Gl\u001b[102G licitaci\u00f3n directa.\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6G\u001b[1mModelo:\u001b[22m el productor\u001b[27Gno\u001b[30Gpaga;\u001b[36Gel\u001b[39Gcomprador\u001b[49Gpaga\u001b[54Guna\u001b[58Gcomisi\u00f3n\u001b[67Gde\u001b[70G6%\u001b[73Gpor\u001b[77Gpedido.\r\u001b[2C\u001b[1B9\u001b[7G\u001b[1miloto:\u001b[22m seis meses en una comuna, con hitos marcados\u001b[59Gcomo m\u001b[67Gas.\u001b[K\r\u001b[2C\u001b[1B10. \u001b[1mCi\u001b[11Gre:\u001b[22m Rosa\u001b[20Gcon\u001b[24Gsu pedido ac\u001b[37Gptado y la\u001b[48Gpe\u001b[51Gici\u00f3n concret\u001b[65G: una comuna, 4 co\u001b[84Gegios y\u001b[92G6 restoranes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuentes en las l\u00e1minas:\u001b[22m cad\u001b[33Gifra lleva\u001b[44Gsu n\u00famero de referencia (175.556\u00b9)\u001b[79Gy\u001b[81Gla\u001b[84Glista\u001b[90Gde\u001b[93Gfuentes\u001b[101Gva\u001b[104Gal\u001b[107Gpie\u001b[111Gde\u001b[114Gla\u001b[117Gmisma\u001b[123Gl\u00e1mina:\r\u001b[2C\u001b[1B- \u001b[1mINE/ODEPA:\u001b[22m Censo Agropecuario\u00a02021.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mS"]
