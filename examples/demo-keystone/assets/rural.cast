[89.5164, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m\u276f \u001b[38;2;255;255;255mUsa keystone para armar una presentaci\u00f3n de 10 l\u00e1minas sobre una iniciativa ficticia de emprendimiento rural: peque\u00f1os productores que venden \u001b[39m      \r\u001b[1B  \u001b[38;2;255;255;255mdirecto a restoranes y colegios cercanos desde el celular. Muestra el producto funcionando en la l\u00e1mina y cita en las l\u00e1minas las fuentes p\u00fablicas \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mde cada dato. Si tienes\u001b[27Gdudas, d\u001b[36Gcide t\u00fa\u001b[44Gy construye \u001b[57Gin esperar\u001b[68Gmi \u001b[72Gonf\u001b[76Grmac\u001b[81G\u00f3n.\u001b[39m                                                             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mSkill\u001b[22m(keystone-html:stage-deck)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mLoaded\u001b[13Gskill\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mNo hay ejemplo \u001b[38;2;177;185;249mpitch-asisto\u001b[39m en la cach\u00e9,\u001b[44Gas\u00ed\u001b[48Gque\u001b[52Gleo\u001b[56Gdirectamente\u001b[69Gel\u001b[72G"]
[89.5174, "o", "motor\u001b[78Gy\u001b[80Glas\u001b[84Gskills\u001b[91Gde\u001b[94Gkeystone.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora el motor stage:\u001b[25Gc\u00f3mo\u001b[30Gconstruye\u001b[40Gcada\u001b[45Gescena\u001b[52Gy\u001b[54Gc\u00f3mo\u001b[59Gmaneja\u001b[66Gla\u001b[69Gapp.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo Agropecuario 2021\u001b[39GINE\u001b[43GChile\u001b[49Gn\u00famero\u001b[56Gde\u001b[59Gexplotaciones\u001b[73Gagropecuarias\u001b[87Gresultados\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"JUNAEB\u001b[22GPrograma\u001b[31Gde\u001b[34GAlimentaci\u00f3n\u001b[47GEscolar\u001b[55Gcompras\u001b[63Gagricultura\u001b[75Gfamiliar\u001b[84Gcampesina\u001b[94GINDAP\u001b[100Gporcentaje\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"SUBTEL\u001b[22Gencuesta\u001b[31Gacceso\u001b[38Ginternet\u001b[47Ghogares\u001b[55Grurales\u001b[63GChile\u001b[69Gporcentaje\u001b[80Gsmar"]
