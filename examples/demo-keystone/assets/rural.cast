[474.9698, "o", "arcados com\u001b[103G m\u001b[106Gta. \u001b[111G        \u001b[120G        \u001b[129G  \u001b[132G         \u001b[142G  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m56\u001b[11G\u001b[38;2;248;248;242mProponemos una sola comuna y\u001b[40Gun radio corto. Primer\u001b[63Gmes,\u001b[68Gsumamos\u001b[76Gproductores\u001b[88Gcon\u001b[92Gvisitas\u001b[100Gen\u001b[103Gterreno.\u001b[112GSegundo\u001b[120Gmes,\u001b[125Grestoranes\u001b[136Gy\u001b[138Gcolegi\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mos. Al cuarto mes, la primera ruta semana\u001b[53G estable. Al\u001b[66Gsexto,\u001b[73Gmedimos\u001b[81Guna\u001b[85Gsola\u001b[90Gcosa:\u001b[96Gqu\u00e9\u001b[100Gparte\u001b[106Gde\u001b[109Glas\u001b[113Gventas\u001b[120Gde\u001b[123Gestos\u001b[129Gproductores\u001b[141Gpas\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242m\u00f3 a \u001b[16Ger directa. Si no llegamos\u001b[43Ga\u001b[45Gla\u001b[48Gmeta,\u001b[54Glo\u001b[57Gdecimos\u001b[65Gy\u001b[67Gparamos.\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m57\u001b[11G\u001b[38;2;248;248;242m**Pasa\u001b[18Ga:**\u001b[23G\u00bfqu\u00e9\u001b[28Gles\u001b[32Gpedimos\u001b[40Ghoy?\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m58\u001b[11G\u001b[38;2;248;248;242m  \u001b[14G      \u001b[21G \u001b[23G           \u001b[35G \u001b[37G    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[11G\u001b[38;2;248;248;242m## cierre \u00b7 Presentado\u001b[34G "]
[474.9712, "o", "\u00b7 0:40\u001b[42G  \u001b[45G     \u001b[51G  \u001b[54G         \u001b[64G    \u001b[69G   \u001b[73G        \u001b[82G   \u001b[86G       \u001b[94G  \u001b[97G     \u001b[103G   \u001b[107G   \u001b[111G          \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m60\u001b[11G\u001b[38;2;248;248;242m**En la l\u00e1mina:** Rosa con\u001b[39Gu\u001b[41Gp\u001b[43Gdido \u001b[49Gceptado y la petic\u001b[70G concreta.          \u001b[91G   \u001b[95G   \u001b[99G  \u001b[102G    \u001b[107G   \u001b[111G      \u001b[118G  \u001b[121G         \u001b[131G \u001b[133G      \u001b[140G    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m61\u001b[11G\u001b[38;2;248;248;242mVolvamos a Rosa. El ju\u001b[34Gves \u001b[39Go esp\u001b[45Gra al cami\u00f3n: sale con doce lechugas para\u001b[87Gel colegio\u001b[98Gy dos cajas para Don Lalo,\u001b[125Ga\u001b[127Gun\u001b[130Gprecio\u001b[137Gque\u001b[141Gpus\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mo ell\u001b[17G. Para que esto pase de\u001b[42Ger\u001b[45Gun ejemplo a ser\u001b[62Gun\u001b[65Gdato,\u001b[71Gles\u001b[75Gpedimos\u001b[83Gtres\u001b[88Gcosas:\u001b[95Guna\u001b[99Gcomuna,\u001b[107Gcuatro\u001b[114Gcolegios\u001b[123Gy\u001b[125Gseis\u001b[130Grestoranes\u001b[141Gdis\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;248;248;242mpuestos\u001b[19Ga\u001b[21Gcomprar\u001b[29Gdurante\u001b[37Gseis\u001b[42Gmeses.\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80"]
