[278.2105, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mSkill\u001b[22m(keystone-html:stage-deck)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mLoaded\u001b[13Gskill\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mNo hay ejemplo \u001b[38;2;177;185;249mpitch-asisto\u001b[39m en la cach\u00e9,\u001b[44Gas\u00ed\u001b[48Gque\u001b[52Gleo\u001b[56Gdirectamente\u001b[69Gel\u001b[72Gmotor\u001b[78Gy\u001b[80Glas\u001b[84Gskills\u001b[91Gde\u001b[94Gkeystone.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora el motor stage:\u001b[25Gc\u00f3mo\u001b[30Gconstruye\u001b[40Gcada\u001b[45Gescena\u001b[52Gy\u001b[54Gc\u00f3mo\u001b[59Gmaneja\u001b[66Gla\u001b[69Gapp.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo Agropecuario 2021\u001b[39GINE\u001b[43GChile\u001b[49Gn\u00famero\u001b[56Gde\u001b[59Gexplotaciones\u001b[73Gagropecuarias\u001b[87Gresultados\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39"]
[278.2116, "o", "m \u001b[1mWeb Search\u001b[22m(\"JUNAEB\u001b[22GPrograma\u001b[31Gde\u001b[34GAlimentaci\u00f3n\u001b[47GEscolar\u001b[55Gcompras\u001b[63Gagricultura\u001b[75Gfamiliar\u001b[84Gcampesina\u001b[94GINDAP\u001b[100Gporcentaje\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"SUBTEL\u001b[22Gencuesta\u001b[31Gacceso\u001b[38Ginternet\u001b[47Ghogares\u001b[55Grurales\u001b[63GChile\u001b[69Gporcentaje\u001b[80Gsmartphone\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G4s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"ODEPA estudio\u001b[29Gmargen\u001b[36Gde\u001b[39Gcomercializaci\u00f3n\u001b[56Ghortalizas\u001b[67Gprecio\u001b[74Gproductor\u001b[84Gvs\u001b[87Gconsumidor\u001b[98GChile\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G7s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Estoy reuniendo\u001b[19Gcifras\u001b[26Gp\u00fablicas\u001b[35Gverificables\u001b[48G(INE/ODEPA,\u001b[60GJUNAEB/INDAP,\u001b[74GSUBTEL)\u001b[82Gantes\u001b[88Gde\u001b[91Gescribir\u001b[100Gel\u001b[103Gguion;\u001b[110Gluego\u001b[116Garmo\u001b[121Gla\u001b[124Gapp\u001b[128Gdemo\u001b[133Gy\u001b[135Glas\u001b[139G10\u001b[142Gl\u00e1minas.\r\u001b[2B\u001b[38;"]
