[565.7811, "o", "66;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"ruta semanal estable, con oferta agrupada\"\u001b[38;2;248;248;242m},                                  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m08\u001b[18G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"wh\u001b[25Gn\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 6\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"{{fig:me\u001b[58G-directa}}\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"de las\u001b[87Gv\u001b[89Gntas de\u001b[97Gesos prod\u001b[107Gct\u001b[110Gres,\u001b[115Gdirec\u001b[122Gs: lo que medimos\"\u001b[38;2;248;248;242m}\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m09\u001b[16G\u001b[38;2;248;248;242m  ],\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras de esta l\u00e1mina son metas del piloto definidas por el equipo, no resultados.\"\u001b[38;2;248;248;242m                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;248;248;242m},                                                                "]
[565.7822, "o", "                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242m{\u001b[18G                                                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[19G\u001b[38;2;166;226;46mid\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m,                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;166;226;46mlayout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,                                                                                                          \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m115\u001b[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"title\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El jueves, Rosa **pone el precio**\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[19G\u001b[38;2;166;226;46mt\u001b[21Gxt\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una c\u001b[45Gmuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren dur"]
[565.7834, "o", "ante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 117 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"device_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,                                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 118 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\u001b[38;2;248;248;242m                              \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m19\u001b[12G\u001b[22m \u001b[16G}\r\u001b[5C\u001b[1B\u001b[2m 120 \u001b[14G\u001b[22m]\r\u001b[2C\u001b[1B   \u001b[2m 121 \u001b[22m }\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos en verde; ahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifr"]
[565.7847, "o", "as\u001b[90Gno\u001b[93Gusadas.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos avisos restantes vienen sobre todo de las notas de fuente,\u001b[66Gque\u001b[70Gel\u001b[73Gpedido\u001b[80Gexige.\u001b[87GConstruyo\u001b[97Gy\u001b[99Greviso\u001b[106Gel\u001b[109Grender.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mRunning python3 -c \"import playwright; print('py ok')\" 2>\u2026\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  $ python3\u001b[17Gc\u001b[20Gimport playwright; \u001b[40Grint('py ok')\" 2>&1; ls ~/Library/Caches/ms-playwright 2>/dev/null | head\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
