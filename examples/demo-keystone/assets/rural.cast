[554.466, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m104\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"milestones\"\u001b[38;2;248;248;242m: [                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[18G\u001b[38;2;248;248;242m  {\u001b[22G\u001b[38;2;166;226;46mwhen\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 1\"\u001b[38;2;248;248;242m,\u001b[38G\u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"{{fig:piloto-productores}}\"\u001b[38;2;248;248;242m,\u001b[77G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[85G\u001b[38;2;230;219;116m\"productores inscritos en terreno, a menos de {{fig:piloto-\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mradio}}\"\u001b[38;2;248;248;242m},     \u001b[28G           \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[18G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 2\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"{{fig:piloto-compradores}}\"\u001b[38;2;248;248;242m,\u001b[77G\u001b["]
[554.4673, "o", "38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[85G\u001b[38;2;230;219;116m\"compradores: {{fig:piloto-restoranes}} restoranes y {{fig:\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mpiloto-colegios}} colegios\"\u001b[38;2;248;248;242m},                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[18G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 4\"\u001b[38;2;248;248;242m,\u001b[38G\u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"Jueves\"\u001b[38;2;248;248;242m,\u001b[57G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[65G\u001b[38;2;230;219;116m\"ruta semanal estable, con oferta agrupada\"\u001b[38;2;248;248;242m},\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[34G\u001b[38;2;230;219;116m6\u001b[54Gmeta-directa}}\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"de las ventas d\u001b[96G eso\u001b[101G productores, directas: lo\u001b[128Gque medimos\"\u001b[38;2;248;248;242m}   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m109\u001b[12G\u001b[38;2;248;248;242m      ],                                                    "]
[554.4686, "o", "                                                                        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[18G\u001b[38;2;166;226;46m\"sourc\u001b[25G_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras de esta l\u00e1mina son metas del piloto definidas por el equipo, no resultados.\"\u001b[38;2;248;248;242m                 \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m111\u001b[12G\u001b[38;2;248;248;242m    },                                                                                                                              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m12\u001b[16G\u001b[38;2;248;248;242m{\u001b[20G                                                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m13\u001b[18G\u001b[38;2;166;226;46m\"id\u001b[22G\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m,    \u001b[38G        \u001b[47G                       \u001b[71G       \u001b[79G                                                              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m14\u001b[18G\u001b[38;2;166;226;46m\"layout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;"]
[554.4699, "o", "116m\"closing\"\u001b[38;2;248;248;242m,                                                                                                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[19G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El jueves, Rosa\u001b[44G**pone\u001b[51Gel\u001b[54Gprecio**\"\u001b[38;2;248;248;242m,                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[16G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una comuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[19G\u001b[38;2;166;226;46mdevice_route\"\u001b[38;2;248;248;242m:\u001b[34G\u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[19G\u001b[38;2;166;226;46msource_note\"\u001b[38;2;248;24"]
[554.4713, "o", "8;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 120 \u001b[22m   ]\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 121 \u001b[22m }\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos\u001b[12Gen verde;\u001b[22Gahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifras\u001b[90Gno\u001b[93Gusadas.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mRunning\u001b[11Gpython3\u001b[19G-\u001b[21G<<'EOF'\u001b[29Gimport\u001b[36Gjson\u001b[41Gd=json.load(open('dec\u2026\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  $ python3 - <<'EOF'\r\u001b[5C\u001b[1Bimport json\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153md=json.load(open('deck.json'))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mS={s['id']:s for s in d['slides']}\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mS['portada']['source_note']=\"Iniciativa ficticia. El radio es una meta de dise\u00f1o.\"\u2026\r\u001b[2C\u001b[2B\u001b[38;2;233;154;122mTopsy-turvying\u2026\u001b[20G\u001b[38;2;153;153;153mrunni"]
