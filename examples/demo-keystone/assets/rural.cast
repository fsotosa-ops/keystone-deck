[967.699, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[33B\u001b[38;2;235;156;47m\u001b[1m\u2733\u001b[22m\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[967.7683, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153man \u001b[1m1\u001b[22m she\u001b[13Gl command \r\u001b[2C\u001b[2B\u001b[39mAhora la demo\u001b[17Gdel producto, paso a\u001b[38Gpaso.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153mead \u001b[1m2\u001b[22m fi\u001b[13Ges \u001b[39m\u001b[K\r\u001b[2C\u001b[2BLa demo ya funciona de punta \u001b[33G punta, con\u001b[45Gla\u001b[48Gcompra\u001b[55Glocal\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[2C\u001b[1Blaptop\u001b[10Gy\u001b[12Gel\u001b[15Gcelular,\u001b[24Gque\u001b[28Gse\u001b[31Gaprieta\u001b[39Gal\u001b[42Gfinal.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mFunciona, pero en el\u001b[24Gpaso 1\u001b[31Glas l\u00edne\u001b[40Gs\u001b[42Gdel r\u00f3tulo chocan\u001b[60Gcon\u001b[64Gel\u001b[67Gindicador\u001b[77Gde\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvecina.\u001b[144GPaso\u001b[149Gel\r\u001b[2C\u001b[1Bpanel\u001b[9Ga\u001b[11Guna\u001b[15Gsola\u001b[20Gcolumna\u001b[28Gpara\u001b[33G"]
[967.7704, "o", "que\u001b[37Glos\u001b[41Gr\u00f3tulos\u001b[49Gqueden\u001b[56Glimpios.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEl paso\u001b[11G3 \u001b[14Ghora tapa la list\u001b[33Gde pedidos; intercambio las dos cajas para\u001b[76Gque\u001b[80Gel\u001b[83Gindicador\u001b[93Gquede\u001b[99Gal\u001b[102Gborde\u001b[108Gderecho.\r\u001b[7C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m7\r\u001b[2C\u001b[2B\u001b[22m\u001b[39mLa\u001b[6Grevisi\u00f3n encontr\u00f3\u001b[24Gcuatro problemas en el modelo: el lapt\u001b[63Gp\u001b[65Gest\u00e1 bajo el celular con un\u001b[93Gestado inc\u001b[104Gnsist\u001b[110Gnte, la\u001b[118Gl\u00ednea\u001b[124Gdel\u001b[128Gpiloto\u001b[135Gsale\u001b[140Gazul\u001b[145Gpor\u001b[149Gel\r\u001b[2C\u001b[1Bcolor\u001b[9Gfijo\u001b[14Gdel\u001b[18Gmotor,\u001b[25Glas\u001b[29Gcifras\u001b[36Gde\u001b[39G\u00abpor\u001b[44Gqu\u00e9\u001b[48Gahora\u00bb\u001b[55Gson\u001b[59Gdemasiado\u001b[69Gchicas\u001b[76Gy\u001b[78Gla\u001b[81Gmatriz\u001b[88Grepite\u001b[95Gr\u00f3tulos\u001b[103Gen\u001b[106Glas\u001b[110Gesquinas.\u001b[120GAhora\u001b[126Gcorrijo\u001b[134Gesos\u001b[139Gcuatro\r\u001b[2C\u001b[1Bpuntos.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m4\u001b[22m files, ran \u001b[1m3\u001b[22"]
[967.7714, "o", "m shell commands \u00b7 \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mCasi listo: la tarjeta\u001b[26Gdel\u001b[30G6%\u001b[33Groza\u001b[38Gel\u001b[41Glaptop,\u001b[49Gy\u001b[51Gel\u001b[54Gsuper\u00edndice\u001b[66G\u00ab\u2074\u00bb\u001b[70Gcae\u001b[74Ga\u001b[76Guna\u001b[80Gfuente\u001b[87Gde\u001b[90Grespaldo\u001b[99Genorme,\u001b[107Gas\u00ed\u001b[111Gque\u001b[115Gvoy\u001b[119Ga\u001b[121Gdefinir\u001b[129Guna\u001b[133Gfuente\u001b[140Gsolo\u001b[145Gpara\r\u001b[2C\u001b[1Blos\u001b[7Gsuper\u00edndices.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2733\u001b[3GTopsy-t\u001b[38;2;235;159;127murv\u001b[38;2;215;119;87mying\u2026 \u001b[47G\u001b[38;2;153;153;153mthought for 16s)\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
