[1035.9609, "o", "[1mroblema:\u001b[22m 175.556 unidades\u001b[33Gprod\u001b[38Gctivas, US$ 450 millones\u001b[63Ga\u001b[66Ga\u00f1o de compras\u001b[81Gp\u00fablicas\u001b[90Gde\u001b[93Galimentos\u001b[103Gfrescos\u001b[111Gy\u001b[113G9\u001b[115Gbarreras\u001b[124Gpara\u001b[129Gvenderle\u001b[138Gal\u001b[141GEstado.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mEspejo:\u001b[22m cada barrera que nombra INDAP con su respuesta en \u001b[65Ga app, una \u001b[77Gor clic.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mProducto:\u001b[22m \u001b[17Gemo en vivo co\u001b[32G dos pantallas sinc\u001b[52Gonizadas, el panel de la cocina del\u001b[88Gcolegio\u001b[96Gy\u001b[98Gel\u001b[101Gcelular\u001b[109Gde\u001b[112GRosa.\u001b[118GCon\u001b[122Gcuatro\u001b[129Gclics\u001b[135GRosa\u001b[140Gpublica,\u001b[149Gel\r\u001b[2C\u001b[1B  \u001b[6Gcolegio pi\u001b[18G y\u001b[21GRosa acepta. Los r\u00f3\u001b[41Gu\u001b[43Gos lee\u001b[50G l\u001b[53Gs n\u00fameros en vivo: la compra loca\u001b[88Gde\u001b[91G colegio pasa de 2,0% a 5,2% y\u001b[122Glo que\u001b[129GRosa vende\u001b[140Gdirecto\u001b[K\r\u001b[5C\u001b[1Bsub\u001b[10G a $51.000.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mPor qu\u00e9 ahora:\u001b[22m el\u001b[24G95,1%\u001b[30Gde\u001b[33Glos\u001b[37Ghogares\u001b[45Grurales\u001b[53Gtiene\u001b[59GInternet\u001b[68Gy\u001b[70Glas\u001b[74Gbases\u001b[80Gdel\u001b[84GPrograma\u001b[93Gde\u001b[96GAlimentaci\u00f3n\u001b[109GEscolar\u001b[117Gexigen\u001b[124G5%\u001b["]
[1035.962, "o", "127Gde\u001b[130Gcompra\u001b[137Glocal.\r\u001b[2C\u001b[1B7\u001b[6G\u001b[1mAlternativas:\u001b[22m una\u001b[24Gmatriz frente al cami\u00f3n intermediario, la feria mayori\u001b[79Gta, la fe\u001b[89Gia libre y la licitaci\u00f3n dir\u001b[118Gcta.\u001b[K\r\u001b[2C\u001b[1B8\u001b[6G\u001b[1mMod\u001b[10Glo:\u001b[22m el productor no paga; \u001b[37Gl comprador paga una comisi\u00f3n de 6% por pedido.\u001b[K\r\u001b[2C\u001b[1B9\u001b[6G\u001b[1mPilot\u001b[14G\u001b[22mseis meses en una comuna, con hitos marcados como metas.\u001b[K\r\u001b[2C\u001b[1B10. \u001b[1mCierre:\u001b[22m Ro\u001b[18Ga con su pedido aceptad\u001b[42G y la petici\u00f3n concreta: una\u001b[71Gcomuna,\u001b[79G4\u001b[81Gcolegios\u001b[90Gy\u001b[92G6\u001b[94Grestoranes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuentes en las l\u00e1minas:\u001b[27G\u001b[22mcada\u001b[32Gcifra\u001b[38Glleva\u001b[44Gsu\u001b[47Gn\u00famero\u001b[54Gde\u001b[57Greferencia\u001b[68G(175.556\u00b9)\u001b[79Gy\u001b[81Gla\u001b[84Glista\u001b[90Gde\u001b[93Gfuentes\u001b[101Gva\u001b[104Gal\u001b[107Gpie\u001b[111Gde\u001b[114Gla\u001b[117Gmisma\u001b[123Gl\u00e1mina:\r\u001b[2C\u001b[1B- \u001b[1mINE/ODEPA:\u001b[22m Censo Agropecu\u001b[31Grio\u00a02021.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSUBTEL:\u001b[22m encu\u001b[18Gsta\u001b[22Gde acceso y uso de\u001b[41GInternet\u001b[50Gde\u001b[53Gnoviembre\u001b[63Gde\u00a02025.\u001b[72GSaqu\u00e9\u001b[78Glos\u001b[82Gdatos\u001b[88Grurales\u001b[96Gdirectame"]
[1035.9632, "o", "nte\u001b[109Gde\u001b[112Gsus\u001b[116Gtablas.\r\u001b[4C\u001b[1B\u001b[1mINDAP\u2013USACH (2015):\u001b[25G\u001b[22mestudio sobre compras p\u00fablicas d\u001b[58G alimentos y agricultura familia\u001b[91G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mLa Tercera (2024):\u001b[22m citan\u001b[30Go a INDAP y JUNAEB.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mQu\u00e9 conviene revisar antes de presentarla:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDat\u001b[9G de compras escolares:\u001b[22m la cifra de $4.126\u001b[51Gmillones\u001b[60Gvendidos\u001b[69Gpor\u001b[73Gla\u001b[76Gagricultura\u001b[88Gfamiliar\u001b[97Gal\u001b[100GPrograma\u001b[109Gde\u001b[112GAlimentaci\u00f3n\u001b[125GEscolar\u001b[133Gen\u001b[136G2023\u001b[141Gy\u001b[143Gel\u001b[146G5%\u001b[149Gde\r\u001b[2C\u001b[1B \u001b[5Gcompra local vienen de una\u001b[32Gnota de pr\u001b[43Gnsa\u001b[47G Los sitios de Mineduc y JUNAEB rechazaron la conexi\u00f3n, as\u00ed que no pude verificar esas cifras\u001b[141Gen \u001b[145Ga\u001b[K\r\u001b[4C\u001b[1Bfuente\u001b[12Goficial.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEstudio de INDAP:\u001b[23G\u001b[22mes\u001b[26Gde\u00a02015.\u001b[35GLa\u001b[38Gdemanda\u001b[46Gp\u00fablica\u001b[54Gde\u001b[57GUS$\u001b[61G450\u001b[65Gmillones\u001b[74Ges\u001b[77Guna\u001b[81Gestimaci\u00f3n\u001b[92Gde\u001b[95Gese\u001b[99Ga\u00f1o.\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
