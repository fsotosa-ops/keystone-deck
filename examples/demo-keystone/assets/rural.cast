[588.937, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[12G\u001b[38;2;230;219;116m\u001b[48;2;2;40;0mpiloto-colegios}} colegios\"\u001b[38;2;248;248;242m},\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[34G\u001b[38;2;230;219;116m4\u001b[48GJueves\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"ruta \u001b[72Gemanal estable, con oferta\u001b[99Gagrupada\"\u001b[38;2;248;248;242m},                                  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m108\u001b[12G\u001b[38;2;248;248;242m        {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 6\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"{{fig:meta-directa}}\"\u001b[38;2;248;248;242m,\u001b[71G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[79G\u001b[38;2;230;219;116m\"de las ventas de esos productores, directas: lo que medimos\"\u001b[38;2;248;248;242m}\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[18G\u001b[38;2;248;248;242m],                                                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[18G\u001b[38;2;166;226;46m\"sourc\u001b[25G_note\"\u001b["]
[588.9381, "o", "38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras de es\u001b[58G l\u00e1mina son metas del piloto\u001b[87Gd\u001b[89Gfinidas\u001b[97Gpor el eq\u001b[107Gip\u001b[110G, no\u001b[115Gresul\u001b[122Gdos.\"\u001b[38;2;248;248;242m              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m11\u001b[16G\u001b[38;2;248;248;242m},  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242m{\u001b[18G                                                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[16G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"id\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m,                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"layout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,                                                                                                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[19G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;24"]
[588.9394, "o", "2m: \u001b[38;2;230;219;116m\"El jueves, Rosa **pone el precio**\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[19G\u001b[38;2;166;226;46mtext\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una comuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[19G\u001b[38;2;166;226;46md\u001b[21Gvice_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/product\u001b[45Gr/fin\"\u001b[38;2;248;248;242m,                                                                                            \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m118\u001b[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 120 \u001b[22m   ]\u001b[K\r\u001b[7C\u001b[1B\u001b[2m21\u001b[12G\u001b[22m}\u001b[16G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b["]
[588.9408, "o", "22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos en verde; ahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifras\u001b[90Gno\u001b[93Gusadas.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos avisos restantes\u001b[24Gvienen\u001b[31Gsobre\u001b[37Gtodo\u001b[42Gde\u001b[45Glas\u001b[49Gnotas\u001b[55Gde\u001b[58Gfuente,\u001b[66Gque\u001b[70Gel\u001b[73Gpedido\u001b[80Gexige.\u001b[87GConstruyo\u001b[97Gy\u001b[99Greviso\u001b[106Gel\u001b[109Grender.\r\u001b[2B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mRunning SP=/priva\u001b[22G/tmp/claude-501/-Users-me-Desktop\u2026\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  $ SP=/private/tmp/claude-501/-Users-me-Desktop-keystone-rural-demo/169fb3d8-e94a-4c5f-a1c8-133550a9046c/scratchpad; mkdir -p \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m~/Desktop/keystone-rural-demo/deck/build/review; cat > $SP/shoot.js <<'EOF'\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mconst { chromiu\u001b[22G } = require('playwright');\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(async () => {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38"]
