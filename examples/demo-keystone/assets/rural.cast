[638.9427, "o", "                                                                                                                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[19G\u001b[38;2;166;226;46msource_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras de esta l\u00e1mina son metas del piloto definidas por el equipo, no resultados.\"\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;248;248;242m},                                                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242m{\u001b[18G                                                                                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m113\u001b[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"id\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m, \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;166;226;46mlayout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[19G\u001b[38;2;166;226;46mtitle\"\u001b[38;2"]
[638.9441, "o", ";248;248;242m: \u001b[38;2;230;219;116m\"El jueves, Rosa **pone el precio**\"\u001b[38;2;248;248;242m,                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 116 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una comuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                                                                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 117 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"device_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,                                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 118 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedida"]
[638.9507, "o", "s son metas del piloto.\"\u001b[38;2;248;248;242m                              \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 120 \u001b[14G\u001b[22m]\r\u001b[1B \u001b[3G   \u001b[2m 121 \u001b[12G\u001b[22m}\u001b[K\r\u001b[2C\u001b[4BChequeo\u001b[11G en verde; ahora recorto text\u001b[42Gvisible (avisos\u001b[58Gde >25 palabras) y quito cifras no \u001b[94Gsadas.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos avisos restantes vienen sobre todo de las notas de fuente, que el pedido exige. Construyo\u001b[97Gy\u001b[99Greviso\u001b[106Gel\u001b[109Grender.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mReading deck/build/review/01-portada.png\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  deck/build/review/01-portada.png\r\u001b[33C\u001b[2B9\u001b[43G)\u001b[39m\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
