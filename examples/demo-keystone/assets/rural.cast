[802.7215, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[2BChequeo\u001b[11G en verde; ahora recorto text\u001b[42Gvisible (avisos\u001b[58Gde >25 palabras) y quito cifras no \u001b[94Gsadas.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153man \u001b[1m1\u001b[22m she\u001b[13Gl command\u001b[23G\u001b[39m\u001b[K\r\u001b[2C\u001b[2BL\u001b[5Gs \u001b[8Gvisos re\u001b[17Gtantes\u001b[25Gienen sobre todo de las\u001b[49Gnotas de\u001b[58Gfuente, que el pedido exige.\u001b[87GConstruy\u001b[97Gy\u001b[99Greviso\u001b[106Gel\u001b[109Grender.\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m, ran \u001b[1m5\u001b[22m shell commands \r\u001b[2C\u001b[2B\u001b[39mP\u001b[5Grtada y perso\u001b[19Ga se ven bien. Sigo revisando\u001b[49Gel resto de\u001b[61Glas cap\u001b[69Guras,\u001b[75Gincluida\u001b[84Gla \u001b[88Gemo paso a paso.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153mead \u001b[1m2\u001b[22m fi\u001b[13Ges \u001b[39m\u001b[K\r\u001b[2C\u001b[2BDos problemas\u001b[17Gen la l\u00e1mina 3: \u00ab9\u00b2\u00bb\u001b[38Gy \u00abUS$\u001b[45G450\u001b[49GM\u00b2\u00bb\u001b[53Gse\u001b[56Gleen\u001b[61Gcomo\u001b[66Gpotencia\u001b[75Gy\u001b[77Gmetros\u001b[84Gcuadrados.\u001b[95GLo\u001b[98Gcorrijo.\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153man \u001b[1m1\u001b[22m she\u001b[13Gl command \r\u001b[2C\u001b[2B\u001b[39mAhora la demo del producto, p\u001b[33Gso a paso.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B"]
[802.7227, "o", "\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa\u001b[6Gdemo\u001b[11Gya\u001b[14Gfunciona\u001b[23Gde\u001b[26Gpunta\u001b[32Ga\u001b[34Gpunta,\u001b[41Gcon\u001b[45Gla\u001b[48Gcompra\u001b[55Glocal\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[1B \u001b[3Glaptop y el celular,\u001b[24Gque se\u001b[31Gaprieta \u001b[40Gl\u001b[42Gfinal.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Funciona, pero en el paso 1 las l\u00edneas del r\u00f3tulo chocan con el indicador de\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvecina.\u001b[144GPaso\u001b[149Gel\r\u001b[2C\u001b[1Bpanel a una sola columna para que los r\u00f3tulos\u001b[49Gqueden\u001b[56Glimpios.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mReading deck/build/review/05-producto-paso1.png\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  deck/build/review/05-"]
