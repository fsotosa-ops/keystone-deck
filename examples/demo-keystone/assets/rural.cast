[747.1362, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos\u001b[12Gen\u001b[15Gverde;\u001b[22Gahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifras\u001b[90Gno\u001b[93Gusadas.\r\u001b[2C\u001b[4BLos avi\u001b[11Gos restantes vienen sobre tod\u001b[42Gde las notas de\u001b[58Gfuente, que el pedido exige. Constr\u001b[94Gyo y reviso\u001b[106Gel\u001b[109Grender.\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153mead \u001b[1m2\u001b[22m fi\u001b[13Ges, ran \u001b[1m5\u001b[23G\u001b[22mshell commands \r\u001b[2C\u001b[2B\u001b[39mP\u001b[5Grt\u001b[8Gda y per\u001b[17Gona se\u001b[25Gen bien. Sigo revisando\u001b[49Gel resto\u001b[58Gde las capturas, incluida la\u001b[87Gdemo pas\u001b[97Ga\u001b[99Gpaso.\u001b[K\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BD\u001b[5Gs problemas e\u001b[19G la l\u00e1mina 3: \u00ab9\u00b2\u00bb y \u00abUS$ 450\u001b[49GM\u00b2\u00bb se leen\u001b[61Gcomo po\u001b[69Gencia\u001b[75Gy metros\u001b[84Gcua\u001b[88Grados. Lo corrijo.\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153man \u001b[1m1\u001b[22m she\u001b[13Gl command \r\u001b[2C\u001b[2B\u001b[39mAhora la demo\u001b[17Gdel producto, paso a\u001b[38Gpaso.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153mead \u001b[1"]
[747.1389, "o", "m2\u001b[22m fi\u001b[13Ges \u001b[39m\u001b[K\r\u001b[2C\u001b[2BLa demo ya funciona de punta \u001b[33G punta, con\u001b[45Gla\u001b[48Gcompra\u001b[55Glocal\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[2C\u001b[1Blaptop\u001b[10Gy\u001b[12Gel\u001b[15Gcelular,\u001b[24Gque\u001b[28Gse\u001b[31Gaprieta\u001b[39Gal\u001b[42Gfinal.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mFunciona, pero en el\u001b[24Gpaso 1\u001b[31Glas l\u00edne\u001b[40Gs\u001b[42Gdel r\u00f3tulo chocan\u001b[60Gcon\u001b[64Gel\u001b[67Gindicador\u001b[77Gde\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvecina.\u001b[144GPaso\u001b[149Gel\r\u001b[2C\u001b[1Bpanel\u001b[9Ga\u001b[11Guna\u001b[15Gsola\u001b[20Gcolumna\u001b[28Gpara\u001b[33Gque\u001b[37Glos\u001b[41Gr\u00f3tulos\u001b[49Gqueden\u001b[56Glimpios.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[46C\u001b[2B\u001b[38"]
