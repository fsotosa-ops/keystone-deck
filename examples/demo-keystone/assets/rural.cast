[1039.4882, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G  \u001b[6Gsube a $51.000.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mPor qu\u00e9 ahora:\u001b[21G\u001b[22mel 95,1% de los hogares rurales tiene Inter\u001b[65Get y las bases de\u001b[83G Programa de Aliment\u001b[104Gci\u00f3n Escolar exigen 5% de compra local.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mAlternativas:\u001b[22m una\u001b[24Gmatriz\u001b[31Gfrente\u001b[38Gal\u001b[41Gcami\u00f3n\u001b[48Gintermediario,\u001b[63Gla\u001b[66Gferia\u001b[72Gmayorista,\u001b[83Gla\u001b[86Gferia\u001b[92Glibre\u001b[98Gy\u001b[100Gla\u001b[103Glicitaci\u00f3n\u001b[114Gdirecta.\r\u001b[2C\u001b[1B8\u001b[6G\u001b[1mM\u001b[8Gdelo:\u001b[22m el productor no\u001b[30Gpaga; el comprado\u001b[48G paga una comisi\u00f3n de\u001b[70G6% por pedido.\u001b[K\r\u001b[2C\u001b[1B9\u001b[6G\u001b[1mPiloto:\u001b[22m seis meses en una comuna, con hitos ma\u001b[53Gca\u001b[56Gos c\u001b[61Gmo metas.\u001b[K\r\u001b[2C\u001b[1B10. \u001b[1mCi\u001b[10Grre:\u001b[22m Rosa con su\u001b[27Gpedido ac\u001b[37Gptado y la petici\u00f3\u001b[56G concreta:\u001b[67Guna comuna, 4 c\u001b[83Glegios\u001b[90Gy\u001b[92G6\u001b[94Grestoranes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuentes en las l\u00e1minas:\u001b[27G\u001b[22mca\u001b[30Ga cifra lleva su n\u00famero de\u001b[57Grefe\u001b[63Gncia (175.556\u00b9)\u001b[79Gy\u001b[81Gla lista\u001b[90Gde fu\u001b[96Gn\u001b[98Ges va al\u001b[107Gpie\u001b[111Gde\u001b[114Gla\u001b[117Gmisma\u001b[123"]
[1039.6861, "o", "Gl\u00e1mina:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mINE/ODEPA:\u001b[16G\u001b[22mCenso\u001b[22GAgropecuario\u00a02021.\r\u001b[2C\u001b[1B- \u001b[1mSUBTEL:\u001b[22m encuesta de ac\u001b[28Geso\u001b[32Gy uso\u001b[38Gde Internet de noviembre de\u00a02025. Saqu\u00e9 los dato\u001b[87G rurales direct\u001b[103Gmente de sus tablas.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mDAP\u2013US\u001b[14GCH (2015):\u001b[22m estudio sobre compras\u001b[47Gp\u00fablicas\u001b[56Gde\u001b[59Galimentos\u001b[69Gy\u001b[71Gagricultura\u001b[83Gfamiliar.\r\u001b[4C\u001b[1B\u001b[1mLa \u001b[9Gercera (2024):\u001b[22m citand\u001b[32Ga\u001b[34GINDAP y JUNAEB.\u001b[50G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mQu\u00e9 convi\u001b[13Gne\u001b[16Grevisar antes de presentarla:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDato de compras escolares:\u001b[32G\u001b[22mla\u001b[35Gcifra\u001b[41Gde\u001b[44G$4.126\u001b[51Gmillones\u001b[60Gvendidos\u001b[69Gpor\u001b[73Gla\u001b[76Gagricultura\u001b[88Gfamiliar\u001b[97Gal\u001b[100GPrograma\u001b[109Gde\u001b[112GAlimentaci\u00f3n\u001b[125GEscolar\u001b[133Gen\u001b[136G2023\u001b[141Gy\u001b[143Gel\u001b[146G5%\u001b[149Gde\r\u001b[2C\u001b[1B  compra local vienen de una nota de prensa.\u001b[48GLos\u001b[52Gsitios\u001b[59Gde\u001b[62GMineduc\u001b[70Gy\u001b[72GJUNAEB\u001b[79Grechazaron\u001b[90Gla\u001b[93Gconexi\u00f3n,\u001b[103Gas\u00ed\u001b[107Gque\u001b[111Gno\u001b[114Gpude\u001b[119Gverificar\u001b[129Gesas\u001b[134Gcifras\u001b[1"]
[1039.6863, "o", "41Gen\u001b[144Gla\r\u001b[2C\u001b[1B \u001b[5Gfuente oficial.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEstudio de INDAP:\u001b[22m es de\u00a02015. La demanda p\u00fablica de US$ 450 millones es una estimaci\u00f3n de ese a\u00f1o.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLo inventado est\u00e1 marcado:\u001b[32G\u001b[22mla\u001b[35Giniciativa,\u001b[47Glos\u001b[51Gpersonajes,\u001b[63Glos\u001b[67Gmontos\u001b[74Gde\u001b[77Gla\u001b[80Gdemo,\u001b[86Gla\u001b[89Gcomisi\u00f3n\u001b[98Gy\u001b[100Glas\u001b[104Gmetas\u001b[110Gdel\u001b[114Gpiloto.\u001b[122GCada\u001b[127Gl\u00e1mina\u001b[134Gcon\u001b[138Gesos\u001b[143Gdatos\u001b[149Glo\r\u001b[2C\u001b[1B \u001b[5Gindica en su pie.\u001b[23G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mAvisos pen\u001b[16Gientes:\u001b[22m los chequeos de keystone pasan sin \u001b[60Grrore\u001b[66G. Quedan avisos de exces\u001b[91G de palabr\u001b[104Gen seis \u001b[113G\u00e1m\u001b[116Gnas, en p\u001b[126Grte por\u001b[134Gl\u001b[136Gs\u001b[138Gpie\u001b[144Ge\u001b[K\r\u001b[4C\u001b[1Bfuente\u001b[12Gque ped\u001b[20Gste,\u001b[25Gy\u001b[27Gotros\u001b[33Gque\u001b[37Gson\u001b[41Gfalsos\u001b[48Gpositivos\u001b[58Gpor\u001b[62Gporcentajes\u001b[74Gdentro\u001b[81Gdel\u001b[85GCSS.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecisiones que tom\u00e9 sin\u001b[27Gconsultarte: ubicar la iniciativa en Chile, u\u001b[73Gar una paleta verde\u001b[93Gtierra\u001b[100Gpropia\u001b[107Gy\u001b[109Gdirigir\u001b[117Gla\u001b[120Gpresent"]
