[547.3007, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m9\u001b[16G\u001b[38;2;248;248;242m{ \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m100\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"id\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"piloto\"\u001b[38;2;248;248;242m,                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[19G\u001b[38;2;166;226;46mlayout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"\u001b[30Gimeline\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[19G\u001b[38;2;166;226;46mkicker\u001b[29G\u001b[38;2;230;219;116mP\u001b[31Gloto \u00b7 metas\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[19G\u001b[38;2;166;226;46mt\u001b[21Gtl\u001b[24G\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Una comuna y **seis meses** bastan para saber si funciona\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;166;226;46mm\u001b[21Glestones\"\u001b[38;2;248;248;242m: [                                                      \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[18G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;"]
[547.302, "o", "219;116m\"Mes 1\"\u001b[38;2;248;248;242m,\u001b[38G\u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"{{fig:piloto-productores}}\"\u001b[38;2;248;248;242m,\u001b[77G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[85G\u001b[38;2;230;219;116m\"productores inscritos en terreno, a menos de {{fig:piloto-\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mradio}}\"\u001b[38;2;248;248;242m},      \u001b[29G        \u001b[38G        \u001b[47G                             \u001b[77G       \u001b[85G                                                           \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m106\u001b[12G\u001b[38;2;248;248;242m        {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m:\u001b[29G\u001b[38;2;230;219;116m\"Mes 2\"\u001b[38;2;248;248;242m,\u001b[38G\u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"{{fig:piloto-compradores}}\"\u001b[38;2;248;248;242m,\u001b[77G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[85G\u001b[38;2;230;219;116m\"compradores: {{fig:piloto-restoranes}} restoranes y {{fig:\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mpiloto-colegios}} colegios\"\u001b[38;2;248;248;242m}"]
[547.3033, "o", ",     \u001b[47G                             \u001b[77G       \u001b[85G                                                           \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m107\u001b[12G\u001b[38;2;248;248;242m        {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 4\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"Jueves\"\u001b[38;2;248;248;242m,\u001b[57G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[65G\u001b[38;2;230;219;116m\"ruta semanal estable, con oferta agrupada\"\u001b[38;2;248;248;242m},\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[34G\u001b[38;2;230;219;116m6\u001b[48G{{fig:meta-directa}}\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"de las ventas de esos pro\u001b[106Guctores, directas: lo que medimos\"\u001b[38;2;248;248;242m}\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[18G\u001b[38;2;248;248;242m],                                                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[18G\u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;23"]
[547.3045, "o", "0;219;116m\"Todas las cifras de esta l\u00e1mina son metas del piloto definidas por el equipo, no resultados.\"\u001b[38;2;248;248;242m                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;248;248;242m},                                                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242m{ \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"id\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m,                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;166;226;46mlayout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[19G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El jueves, Rosa **pone el precio**\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[20G\u001b[38;2;166;226;46mext\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les\u001b[31Gpedimos\u001b[39G"]
[547.3059, "o", "una comuna,\u001b[51G{{fig:p\u001b[59Gloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                                                                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m117\u001b[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"device_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[19G\u001b[38;2;166;226;46msour\u001b[26Gn\u001b[28Gte\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[7C\u001b[1B\u001b[2m20\u001b[14G\u001b[22m]\u001b[16G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m}\u001b[14G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Chequeos en verde; ahora recorto texto visible (avisos de >25 palabras) y quito cifras no usadas.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;15"]
[547.3071, "o", "3;153;153m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[45C\u001b[2B\u001b[38;2;153;153;153mthought for 3s)\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
