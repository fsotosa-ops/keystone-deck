[357.9049, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo\u001b[21GAgropecuario\u001b[34G2021\u001b[39GINE\u001b[43GChile\u001b[49Gn\u00famero\u001b[56Gde\u001b[59Gexplotaciones\u001b[73Gagropecuarias\u001b[87Gresultados\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search in\u001b[22G5s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"JUNAEB\u001b[22GPrograma\u001b[31Gde\u001b[34GAlimentaci\u00f3n\u001b[47GEscolar\u001b[55Gcompras\u001b[63Gagricultura\u001b[75Gfamiliar\u001b[84Gcampesina\u001b[94GINDAP\u001b[100Gporcentaje\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search in\u001b[22G5s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"SUBTEL\u001b[22Gencuesta\u001b[31Gacceso\u001b[38Ginternet\u001b[47Ghogares\u001b[55Grurales\u001b[63GChile\u001b[69Gporcentaje\u001b[80Gsmartphone\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search in 4s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"ODEPA\u001b[21Gestudio\u001b[29Gmargen\u001b[36Gde\u001b[39Gcomercializaci\u00f3n\u001b[56Ghortalizas\u001b[67Gprecio\u001b[74Gproductor\u001b[84Gvs\u001b[87Gco"]
[357.9064, "o", "nsumidor\u001b[98GChile\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search\u001b[19Gin 7s\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEstoy reuniendo cifras p\u00fabli\u001b[32Gas ver\u001b[39Gfi\u001b[42Gabl\u001b[47G (INE/ODEPA, JUNAEB/INDAP, SUBTEL) an\u001b[85Ges de escribir el guion; luego armo la app demo y\u001b[135Glas\u001b[139G10\u001b[142Gl\u00e1minas.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mFetch\u001b[22m(https://www.odepa.gob.cl/publicaciones/articulos/censo-agropecuario-y-forestal-2021-distribucion-de-las-unidades-productivas)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mReceived \u001b[1m4KB\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mYa\u001b[6Gtengo\u001b[12Glas\u001b[16Gcifras\u001b[23Gverificadas:\u001b[36GINE/ODEPA,\u001b[47GSUBTEL\u001b[54G2025,\u001b[60GINDAP\u001b[66Gy\u001b[68Gla\u001b[71Gcifra\u001b[77GJUNAEB/INDAP\u001b[90Gpublicada\u001b[100Gpor\u001b[104GLa\u001b[107GTercera.\u001b[116GAhora\u001b[122Gpreparo\u001b[130Gla\u001b[133Gcarpeta\u001b[141Gdel\u001b[145Gdeck\u001b[150Gy\r\u001b[2C\u001b[1Bescribo el guion.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255"]
[357.9076, "o", ";255m\u23fa\u001b[3G\u001b[39mAhora la marca (palet\u001b[25G tierra/verde), el sc\u001b[47Gipt de cifras y\u001b[63Gel\u001b[66Gguion.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mPaleta OK en contraste. Ahora genero\u001b[40Glas\u001b[44Gcifras\u001b[51Gdesde\u001b[57G\u001b[38;2;177;185;249mdata/\u001b[63G\u001b[39m(el\u001b[67Gledger\u001b[74Gse\u001b[77Gcalcula,\u001b[86Gno\u001b[89Gse\u001b[92Gtipea).\r\u001b[45C\u001b[2B\u001b[38;2;153;153;153mthought for 9s)\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
