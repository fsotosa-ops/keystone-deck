[857.0015, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m5\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mPortada\u001b[11Gy\u001b[13Gpersona\u001b[21Gse\u001b[24Gven\u001b[28Gbien.\u001b[34GSigo\u001b[39Grevisando\u001b[49Gel\u001b[52Gresto\u001b[58Gde\u001b[61Glas\u001b[65Gcapturas,\u001b[75Gincluida\u001b[84Gla\u001b[87Gdemo\u001b[92Gpaso\u001b[97Ga\u001b[99Gpaso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos\u001b[7Gproblemas\u001b[17Gen\u001b[20Gla\u001b[23Gl\u00e1mina\u001b[30G3:\u001b[33G\u00ab9\u00b2\u00bb\u001b[38Gy\u001b[40G\u00abUS$\u001b[45G450\u001b[49GM\u00b2\u00bb\u001b[53Gse\u001b[56Gleen\u001b[61Gcomo\u001b[66Gpotencia\u001b[75Gy\u001b[77Gmetros\u001b[84Gcuadrados.\u001b[95GLo\u001b[98Gcorrijo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora\u001b[9Gla\u001b[12Gdemo\u001b[17Gdel\u001b[21Gproducto,\u001b[31Gpaso\u001b[36Ga\u001b[38Gpaso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mL\u001b[5G demo ya funciona de punta a punta, con la compra local\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b"]
[857.0075, "o", "[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[2C\u001b[1Blaptop\u001b[10Gy\u001b[12Gel\u001b[15Gcelular,\u001b[24Gque\u001b[28Gse\u001b[31Gaprieta\u001b[39Gal\u001b[42Gfinal.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mFu\u001b[6Gciona, per\u001b[17G en e\u001b[23G paso 1 las l\u00edneas del r\u00f3tulo chocan c\u001b[62Gn el indicador\u001b[77Gde\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvecina.\u001b[144GPaso\u001b[149Gel\r\u001b[2C\u001b[1Bpanel\u001b[9Ga\u001b[11Guna\u001b[15Gsola\u001b[20Gcolumna\u001b[28Gpara\u001b[33Gque\u001b[37Glos\u001b[41Gr\u00f3tulos\u001b[49Gqueden\u001b[56Glimpios.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEl\u001b[6Gpaso\u001b[11G3\u001b[13Gahora\u001b[19Gtapa\u001b[24Gla\u001b[27Glista\u001b[33Gde\u001b[36Gpedidos;\u001b[45Gintercambio\u001b[57Glas\u001b[61Gdos\u001b[65Gcaja"]
