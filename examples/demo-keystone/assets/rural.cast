[1038.9454, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G2\u001b[7G\u001b[1me\u001b[9Gson\u001b[15G\u001b[22mRosa, a l\u001b[25Gs\u001b[27G6:04, con \u001b[38Gn precio que hoy le pone\u001b[63Gel\u001b[66Gintermediario.\r\u001b[2C\u001b[1B3\u001b[7G\u001b[1mroblema:\u001b[22m 175.556 unidades\u001b[33Gprod\u001b[38Gctivas, US$ 450 millones\u001b[63Ga\u001b[66Ga\u00f1o de compras\u001b[81Gp\u00fablicas\u001b[90Gde\u001b[93Galimentos\u001b[103Gfrescos\u001b[111Gy\u001b[113G9\u001b[115Gbarreras\u001b[124Gpara\u001b[129Gvenderle\u001b[138Gal\u001b[141GEstado.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mEspejo:\u001b[22m cada barrera que nombra INDAP con su respuesta en \u001b[65Ga app, una \u001b[77Gor clic.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mProducto:\u001b[22m \u001b[17Gemo en vivo co\u001b[32G dos pantallas sinc\u001b[52Gonizadas, el panel de la cocina del\u001b[88Gcolegio\u001b[96Gy\u001b[98Gel\u001b[101Gcelular\u001b[109Gde\u001b[112GRosa.\u001b[118GCon\u001b[122Gcuatro\u001b[129Gclics\u001b[135GRosa\u001b[140Gpublica,\u001b[149Gel\r\u001b[2C\u001b[1B  \u001b[6Gcolegio pi\u001b[18G y\u001b[21GRosa acepta. Los r\u00f3\u001b[41Gu\u001b[43Gos lee\u001b[50G l\u001b[53Gs n\u00fameros en vivo: la compra loca\u001b[88Gde\u001b[91G colegio pasa de 2,0% a 5,2% y\u001b[122Glo que\u001b[129GRosa vende\u001b[140Gdirecto\u001b[K\r\u001b[5C\u001b[1Bsub\u001b[10G a $51.000.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mPor qu\u00e9 ahora:\u001b[22m el\u001b[24G95,1%\u001b[30Gde\u001b[33Glos\u001b[37"]
[1038.9466, "o", "Ghogares\u001b[45Grurales\u001b[53Gtiene\u001b[59GInternet\u001b[68Gy\u001b[70Glas\u001b[74Gbases\u001b[80Gdel\u001b[84GPrograma\u001b[93Gde\u001b[96GAlimentaci\u00f3n\u001b[109GEscolar\u001b[117Gexigen\u001b[124G5%\u001b[127Gde\u001b[130Gcompra\u001b[137Glocal.\r\u001b[2C\u001b[1B7\u001b[6G\u001b[1mAlternativas:\u001b[22m una\u001b[24Gmatriz frente al cami\u00f3n intermediario, la feria mayori\u001b[79Gta, la fe\u001b[89Gia libre y la licitaci\u00f3n dir\u001b[118Gcta.\u001b[K\r\u001b[2C\u001b[1B8\u001b[6G\u001b[1mMod\u001b[10Glo:\u001b[22m el productor no paga; \u001b[37Gl comprador paga una comisi\u00f3n de 6% por pedido.\u001b[K\r\u001b[2C\u001b[1B9\u001b[6G\u001b[1mPilot\u001b[14G\u001b[22mseis meses en una comuna, con hitos marcados como metas.\u001b[K\r\u001b[2C\u001b[1B10. \u001b[1mCierre:\u001b[22m Ro\u001b[18Ga con su pedido aceptad\u001b[42G y la petici\u00f3n concreta: una\u001b[71Gcomuna,\u001b[79G4\u001b[81Gcolegios\u001b[90Gy\u001b[92G6\u001b[94Grestoranes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuentes en las l\u00e1minas:\u001b[27G\u001b[22mcada\u001b[32Gcifra\u001b[38Glleva\u001b[44Gsu\u001b[47Gn\u00famero\u001b[54Gde\u001b[57Greferencia\u001b[68G(175.556\u00b9)\u001b[79Gy\u001b[81Gla\u001b[84Glista\u001b[90Gde\u001b[93Gfuentes\u001b[101Gva\u001b[104Gal\u001b[107Gpie\u001b[111Gde\u001b[114Gla\u001b[117Gmisma\u001b[123Gl\u00e1mina:\r\u001b[2C\u001b[1B- \u001b[1mINE/ODEPA:\u001b[22m Censo Agropecu\u001b[31Grio\u00a02021.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSUB"]
