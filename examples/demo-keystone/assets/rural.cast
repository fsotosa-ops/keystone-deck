[1034.2736, "o", "\ufffd en capturas de cada l\u00e1mina y de cada\u001b[99Gclic, y correg\u00ed\u001b[115Glo q\u001b[120Ge se ve\u00eda mal.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPara abrirla:\r\u001b[2C\u001b[1B\u001b[22mpython3 -m http.server\u001b[26G8770\u001b[31G--directory\u001b[43G~/Desktop/keystone-rural-demo/deck/build\r\u001b[2C\u001b[1B\u001b[32m# abrir http://localhost:8770/stage/   \u00b7   P = vista del presentador con el guion\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLas 10 l\u00e1minas:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mPortada:\u001b[22m la promesa,\u001b[27Gcon\u001b[31Gel\u001b[34Gcelular\u001b[42Gde\u001b[45Gla\u001b[48Gproductora.\r\u001b[2C\u001b[1B2\u001b[7G\u001b[1me\u001b[9Gson\u001b[15G\u001b[22mRosa, a l\u001b[25Gs\u001b[27G6:04, con \u001b[38Gn precio que hoy le pone\u001b[63Gel\u001b[66Gintermediario.\r\u001b[2C\u001b[1B3\u001b[7G\u001b[1mroblema:\u001b[22m 175.556 unidades\u001b[33Gprod\u001b[38Gctivas, US$ 450 millones\u001b[63Ga\u001b[66Ga\u00f1o de compras\u001b[81Gp\u00fablicas\u001b[90Gde\u001b[93Galimentos\u001b[103Gfrescos\u001b[111Gy\u001b[113G9\u001b[115Gbarreras\u001b[124Gpara\u001b[129Gvenderle\u001b[138Gal\u001b[141GEstado.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mEspejo:\u001b[22m cada barrera que nombra INDAP con su respuesta en \u001b[65Ga app, una \u001b[77Gor clic.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mProducto:\u001b[22m \u001b[17Gemo en vivo co\u001b[32G "]
