[809.0728, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m5\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mPortada\u001b[11Gy\u001b[13Gpersona\u001b[21Gse\u001b[24Gven\u001b[28Gbien.\u001b[34GSigo\u001b[39Grevisando\u001b[49Gel\u001b[52Gresto\u001b[58Gde\u001b[61Glas\u001b[65Gcapturas,\u001b[75Gincluida\u001b[84Gla\u001b[87Gdemo\u001b[92Gpaso\u001b[97Ga\u001b[99Gpaso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos\u001b[7Gproblemas\u001b[17Gen\u001b[20Gla\u001b[23Gl\u00e1mina\u001b[30G3:\u001b[33G\u00ab9\u00b2\u00bb\u001b[38Gy\u001b[40G\u00abUS$\u001b[45G450\u001b[49GM\u00b2\u00bb\u001b[53Gse\u001b[56Gleen\u001b[61Gcomo\u001b[66Gpotencia\u001b[75Gy\u001b[77Gmetros\u001b[84Gcuadrados.\u001b[95GLo\u001b[98Gcorrijo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora\u001b[9Gla\u001b[12Gdemo\u001b[17Gdel\u001b[21Gproducto,\u001b[31Gpaso\u001b[36Ga\u001b[38Gpaso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa\u001b[6Gdemo\u001b[11Gya\u001b[14Gfunciona\u001b[23Gde\u001b[26Gpunta\u001b[32Ga\u001b[34Gpunta,\u001b[41Gcon\u001b[45Gla\u001b[48Gcompra\u001b[55Glocal"]
