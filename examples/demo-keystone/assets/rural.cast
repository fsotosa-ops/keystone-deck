[579.0735, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m   \u001b[12G\u001b[38;2;230;219;116mradio}}\"\u001b[38;2;248;248;242m},      \u001b[29G        \u001b[38G        \u001b[47G                             \u001b[77G       \u001b[85G                                                           \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m106\u001b[12G\u001b[38;2;248;248;242m        {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 2\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b[38;2;230;219;116m\"{{fig:piloto-compradores}}\"\u001b[38;2;248;248;242m,\u001b[77G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[85G\u001b[38;2;230;219;116m\"compradores: {{fig:piloto-restoranes}} restoranes y {{fig:\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mpiloto-colegios}} colegios\"\u001b[38;2;248;248;242m},     \u001b[47G         \u001b[57G       \u001b[65G                                             \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[34G\u001b[38;2;230;219;116m4\u001b[48GJueves\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"ruta semanal estable, con oferta agrupa"]
[579.0784, "o", "\u001b[106Ga\"\u001b[38;2;248;248;242m},                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[18G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 6\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"{{fig:meta-directa}}\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"de las ventas de esos productores, directas: lo que medimos\"\u001b[38;2;248;248;242m}   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m09\u001b[18G\u001b[38;2;248;248;242m],                                                                                                                            \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[16G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras de esta l\u00e1mina son metas del piloto definidas por el equipo, no resultados.\"\u001b[38;2;248;248;242m                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;248;248;242m},\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242m{\u001b[18G                   "]
[579.08, "o", "                                                                                                           \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[19G\u001b[38;2;166;226;46mid\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m,     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;166;226;46mlayout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[20G\u001b[38;2;166;226;46mitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El\u001b[31Gjueves,\u001b[39GRosa **pone\u001b[51Gel prec\u001b[59Go**\"\u001b[38;2;248;248;242m,                                                                                \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m116\u001b[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una comuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[19G\u001b[38;2;"]
[579.0813, "o", "166;226;46mdevi\u001b[26Gr\u001b[28Gute\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 118 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\u001b[38;2;248;248;242m                              \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m19\u001b[14G\u001b[22m \u001b[16G}\r\u001b[8C\u001b[1B\u001b[2m0\u001b[12G\u001b[22m \u001b[14G]\r\u001b[5C\u001b[1B\u001b[2m 121 \u001b[12G\u001b[22m}\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos\u001b[12Gen\u001b[15Gverde;\u001b[22Gahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifras\u001b[90Gno\u001b[93Gusadas.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos\u001b[7Gavisos\u001b[14Grestantes\u001b[24Gvienen\u001b[31Gsobre\u001b[37Gtodo\u001b[42Gde\u001b[45Glas\u001b[49Gnotas\u001b[55Gde\u001b[58Gfuente,\u001b"]
