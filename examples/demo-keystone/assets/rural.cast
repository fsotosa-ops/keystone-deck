[1022.4878, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[3C\u001b[1B\u001b[38;2;153;153;153man \u001b[1m1\u001b[22m she\u001b[13Gl command \r\u001b[2C\u001b[2B\u001b[39mAhora la demo del producto, p\u001b[33Gso a paso.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa\u001b[6Gdemo\u001b[11Gya\u001b[14Gfunciona\u001b[23Gde\u001b[26Gpunta\u001b[32Ga\u001b[34Gpunta,\u001b[41Gcon\u001b[45Gla\u001b[48Gcompra\u001b[55Glocal\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[1B \u001b[3Glaptop y el celular,\u001b[24Gque se\u001b[31Gaprieta \u001b[40Gl\u001b[42Gfinal.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mFunciona,\u001b[13Gpero\u001b[18Gen\u001b[21Gel\u001b[24Gpaso\u001b[29G1\u001b[31Glas\u001b[35Gl\u00edneas\u001b[42Gdel\u001b[46Gr\u00f3tulo\u001b[53Gchocan\u001b[60Gcon\u001b[64Gel\u001b[67Gindicador\u001b[77Gde\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvec"]
[1022.489, "o", "ina.\u001b[144GPaso\u001b[149Gel\r\u001b[1B \u001b[3Gpanel a\u001b[11Gun\u001b[14G sola columna par\u001b[33Gque los r\u00f3tulos queden limpios.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[7C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m2\r\u001b[2C\u001b[2B\u001b[22m\u001b[39mEl\u001b[6Gpaso 3 ahora tapa\u001b[24Gla lista de pedidos; intercambio las d\u001b[63Gs\u001b[65Gcajas para que el indicador\u001b[93Gquede al b\u001b[104Grde d\u001b[110Grecho.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m7\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa revisi\u00f3n encontr\u00f3 cuatro problemas en el modelo:\u001b[55Gel\u001b[58Glaptop\u001b[65Gest\u00e1\u001b[70Gbajo\u001b[75Gel\u001b[78Gcelular\u001b[86Gcon\u001b[90Gun\u001b[93Gestado\u001b[100Ginconsistente,\u001b[115Gla\u001b[118Gl\u00ednea\u001b[124Gdel\u001b[128Gpiloto\u001b[135Gsale\u001b[140Gazul\u001b[145Gpor\u001b[149Gel\r\u001b[2C\u001b[1Bcolor\u001b[9Gfijo\u001b[14Gdel\u001b[18Gmotor,\u001b[25Glas\u001b[29Gcifras\u001b[36Gde\u001b[39G\u00abpor\u001b[44Gqu\u00e9\u001b[48Gahora\u00bb\u001b[55Gson\u001b[59Gdemasiado\u001b[69Gchicas\u001b[76Gy\u001b[78Gla\u001b[81Gmatriz\u001b[88Grepite\u001b[95Gr\u00f3tulos\u001b[103Gen\u001b[106Glas\u001b[110Gesquinas.\u001b[120GAhora\u001b[126Gcorrijo\u001b[134Gesos\u001b[139Gcuatro\r\u001b[1B \u001b[3Gpuntos.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B"]
