[655.5605, "o", "[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"device_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[19G\u001b[38;2;166;226;46msour\u001b[26Gn\u001b[28Gte\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[7C\u001b[1B\u001b[2m20\u001b[14G\u001b[22m]\u001b[16G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m}\u001b[14G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos\u001b[12Gen\u001b[15Gverde;\u001b[22Gahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifras\u001b[90Gno\u001b[93Gusadas.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos\u001b[7Gavisos\u001b[14Grestantes\u001b[24Gvienen\u001b[31Gsobre\u001b[37Gtodo\u001b[42Gde\u001b[45Glas\u001b[49Gnotas\u001b[55Gde\u001b[58Gfuente,\u001b[66Gque\u001b[70Gel\u001b[73Gpedido\u001b[80Gexige.\u001b[87GConstruyo\u001b[97Gy\u001b[99Greviso\u001b[106Gel\u001b[109Grender.\r"]
[655.5721, "o", "\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m5\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mPortada\u001b[11Gy\u001b[13Gpersona\u001b[21Gse\u001b[24Gven\u001b[28Gbien.\u001b[34GSigo\u001b[39Grevisando\u001b[49Gel\u001b[52Gresto\u001b[58Gde\u001b[61Glas\u001b[65Gcapturas,\u001b[75Gincluida\u001b[84Gla\u001b[87Gdemo\u001b[92Gpaso\u001b[97Ga\u001b[99Gpaso.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos\u001b[7Gproblemas\u001b[17Gen\u001b[20Gla\u001b[23Gl\u00e1mina\u001b[30G3:\u001b[33G\u00ab9\u00b2\u00bb\u001b[38Gy\u001b[40G\u00abUS$\u001b[45G450\u001b[49GM\u00b2\u00bb\u001b[53Gse\u001b[56Gleen\u001b[61Gcomo\u001b[66Gpotencia\u001b[75Gy\u001b[77Gmetros\u001b[84Gcuadrados.\u001b[95GLo\u001b[98Gcorrijo.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Ahora la demo del producto, paso a paso.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file\u2026\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mTopsy-turvying\u2026\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
