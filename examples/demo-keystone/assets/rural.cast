[1021.0429, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mL\u001b[5G demo ya funciona de punta a punta, con la compra local\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[2C\u001b[1Blaptop\u001b[10Gy\u001b[12Gel\u001b[15Gcelular,\u001b[24Gque\u001b[28Gse\u001b[31Gaprieta\u001b[39Gal\u001b[42Gfinal.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mFu\u001b[6Gciona, per\u001b[17G en e\u001b[23G paso 1 las l\u00edneas del r\u00f3tulo chocan c\u001b[62Gn el indicador\u001b[77Gde\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvecina.\u001b[144GPaso\u001b[149Gel\r\u001b[2C\u001b[1Bpanel\u001b[9Ga\u001b[11Guna\u001b[15Gsola\u001b[20Gcolumna\u001b[28Gpara\u001b[33Gque\u001b[37Glos\u001b[41Gr\u00f3tulos\u001b[49Gqueden\u001b[56Glimpios.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;15"]
[1021.0584, "o", "3mRead \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEl\u001b[6Gpaso\u001b[11G3\u001b[13Gahora\u001b[19Gtapa\u001b[24Gla\u001b[27Glista\u001b[33Gde\u001b[36Gpedidos;\u001b[45Gintercambio\u001b[57Glas\u001b[61Gdos\u001b[65Gcajas\u001b[71Gpara\u001b[76Gque\u001b[80Gel\u001b[83Gindicador\u001b[93Gquede\u001b[99Gal\u001b[102Gborde\u001b[108Gderecho.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m7\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa revisi\u00f3n \u001b[16Gncon\u001b[21Gr\u00f3 cu\u001b[27Gtro p\u001b[33Goblemas en\u001b[44Gel modelo:\u001b[55Gel laptop est\u00e1 bajo el\u001b[78Gcelula\u001b[85G con un \u001b[94Gstado inco\u001b[105Gsistente, l\u001b[117G l\u00ednea del piloto \u001b[136Gale azul por\u001b[149Gel\r\u001b[2C\u001b[1Bcolor fijo del motor,\u001b[25Glas\u001b[29Gcifras\u001b[36Gde\u001b[39G\u00abpor\u001b[44Gqu\u00e9\u001b[48Gahora\u00bb\u001b[55Gson\u001b[59Gdemasiado\u001b[69Gchicas\u001b[76Gy\u001b[78Gla\u001b[81Gmatriz\u001b[88Grepite\u001b[95Gr\u00f3tulos\u001b[103Gen\u001b[106Glas\u001b[110Gesquinas.\u001b[120GAhora\u001b[126Gcorrijo\u001b[134Gesos\u001b[139Gcuatro\r\u001b[2C\u001b[1Bpuntos.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m4\u001b[22m files, ran \u001b[1m3\u001b[22m sh"]
