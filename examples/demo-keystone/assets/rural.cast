[540.646, "o", "1B\u001b[38;2;80;200;80m100\u001b[16G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"id\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"piloto\"\u001b[38;2;248;248;242m,                                                                                                               \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m101\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"layout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"timeline\"\u001b[38;2;248;248;242m,                                                                                                         \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[19G\u001b[38;2;166;226;46mkicker\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Piloto \u00b7 metas\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[19G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Una comuna y **seis meses** bastan para saber si funciona\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;166;226;46mm\u001b[21Glestones\"\u001b[38;2;248;248;242m: [            \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[18G\u001b[38;2;248;248;242m  {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;2"]
[540.6473, "o", "30;219;116m\"Mes 1\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"{{fig:piloto-productores}}\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[86G\u001b[38;2;230;219;116mproductores inscritos en terreno, a menos de {{fig:piloto-\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116mradio}}\"\u001b[38;2;248;248;242m},         \u001b[32G \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[34G\u001b[38;2;230;219;116m2\u001b[61Gcomprad\u001b[86Gcomprad\u001b[97G: {{fig:piloto-restoranes}} restoranes y {{fig:\r\u001b[11C\u001b[1Bpiloto-colegios}} colegios\"\u001b[38;2;248;248;242m},\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[34G\u001b[38;2;230;219;116m4\u001b[48GJueves\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"ruta \u001b[72Gemanal estable, con oferta\u001b[99Gagrupada\"\u001b[38;2;248;248;242m},                                  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m108\u001b[12G\u001b[38;2;248;248;242m        {\u001b[38;2;166;226;46m\"when\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Mes 6\"\u001b[38;2;248;248;242m, \u001b[38;2;166;226;46m\"value\"\u001b[38;2;248;248;242m:\u001b[47G\u001b["]
[540.6488, "o", "38;2;230;219;116m\"{{fig:meta-directa}}\"\u001b[38;2;248;248;242m,\u001b[71G\u001b[38;2;166;226;46m\"text\"\u001b[38;2;248;248;242m:\u001b[79G\u001b[38;2;230;219;116m\"de las ventas de esos productores, directas: lo que medimos\"\u001b[38;2;248;248;242m}\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[18G\u001b[38;2;248;248;242m],                                                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[18G\u001b[38;2;166;226;46m\"sourc\u001b[25G_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras de es\u001b[58G l\u00e1mina son metas del piloto\u001b[87Gd\u001b[89Gfinidas\u001b[97Gpor el eq\u001b[107Gip\u001b[110G, no\u001b[115Gresul\u001b[122Gdos.\"\u001b[38;2;248;248;242m              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m11\u001b[16G\u001b[38;2;248;248;242m},  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242m{\u001b[18G                                                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[16G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"id\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b["]
[540.6501, "o", "38;2;248;248;242m,                                                                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"layout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,                                                                                                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[19G\u001b[38;2;166;226;46mtitle\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El jueves, Rosa **pone el precio**\"\u001b[38;2;248;248;242m,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[19G\u001b[38;2;166;226;46mtext\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una comuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[19G\u001b[38;2;166;226;46md\u001b[21Gvice_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/product\u001b[45Gr/fin\"\u001b[38;2;248;248;242m,"]
[540.6514, "o", "                                                                                            \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m118\u001b[12G\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46m\"source_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes ficticios. Las cantidades pedidas son metas del piloto.\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 120 \u001b[22m   ]\u001b[K\r\u001b[7C\u001b[1B\u001b[2m21\u001b[12G\u001b[22m}\u001b[16G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
