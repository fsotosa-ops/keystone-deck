[328.1303, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m No hay \u001b[11Gjemplo \u001b[38;2;177;185;249mpitch-asisto\u001b[31G\u001b[39men\u001b[34Gla\u001b[37Gcach\u00e9,\u001b[44Gas\u00ed\u001b[48Gque\u001b[52Gleo\u001b[56Gdirectamente\u001b[69Gel\u001b[72Gmotor\u001b[78Gy\u001b[80Glas\u001b[84Gskills\u001b[91Gde\u001b[94Gkeystone.\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[2BAhor\u001b[8G el motor\u001b[18Gstage: c\u00f3mo co\u001b[33Gstruye cada escena\u001b[52Gy c\u00f3mo maneja la\u001b[69Gapp.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153mead \u001b[1m1\u001b[22m fi\u001b[13Ge, ran \u001b[1m3\u001b[22m \u001b[23Ghell commands \r\u001b[2B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Cen\u001b[19Go Agropecuario 2021 INE Chile \u001b[50G\u00famero de\u001b[59Gexplotaciones agropecuarias\u001b[87Gresultados\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"JUNAEB\u001b[22GPrograma\u001b[31Gde\u001b[34GAlimentaci\u00f3n\u001b[47GEscolar\u001b[55Gcompras\u001b[63Gagricultura\u001b[75Gfamiliar\u001b[84Gcampesina\u001b[94GINDAP\u001b[100Gporcentaje\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search in 5s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b"]
