[1036.6143, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3Grestoranes\u001b[14Gy\u001b[16Gcolegios\u001b[25Gcercanos\u001b[34Gdesde\u001b[40Gel\u001b[43Gcelular.\u001b[52GLa\u001b[55Grevis\u00e9\u001b[62Gen\u001b[65Gcapturas\u001b[74Gde\u001b[77Gcada\u001b[82Gl\u00e1mina\u001b[89Gy\u001b[91Gde\u001b[94Gcada\u001b[99Gclic,\u001b[105Gy\u001b[107Gcorreg\u00ed\u001b[115Glo\u001b[118Gque\u001b[122Gse\u001b[125Gve\u00eda\u001b[130Gmal.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPara abrirla:\u001b[22m\u001b[K\r\u001b[2C\u001b[1Bpython3\u001b[11G-m\u001b[14Ghttp.server\u001b[26G8770\u001b[31G--directory\u001b[43G~/Desktop/keystone-rural-demo/deck/build\r\u001b[2C\u001b[1B\u001b[32m# abrir http://localhost:8770/stage/   \u00b7   P = vista del presentador con el guion\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLas 10 l\u00e1minas:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mPortada:\u001b[15G\u001b[22mla\u001b[18Gpromesa,\u001b[27Gcon\u001b[31Gel\u001b[34Gcelular\u001b[42Gde\u001b[45Gla\u001b[48Gproductora.\r\u001b[2C\u001b[1B2. \u001b[1mPersona:\u001b[22m Rosa,\u001b[21Ga\u001b[23Glas\u001b[27G6:04,\u001b[33Gcon\u001b[37Gun\u001b[40Gprecio\u001b[47Gque\u001b[51Ghoy\u001b[55Gle\u001b[58Gpone\u001b[63Gel\u001b[66Gintermediario.\r\u001b[2C\u001b[1B3\u001b[7G\u001b[1mroblema:\u001b[22m 175.556 unidades prod\u001b[38Gctivas, US$ 450 millones\u001b[63Gal\u001b[66Ga\u00f1o\u001b[70Gde\u001b[73Gcompras\u001b[81Gp\u00fablicas\u001b[90Gde\u001b[93Galimentos\u001b[103Gfrescos\u001b[111Gy\u001b[113G9\u001b[115Gbarreras\u001b[124G"]
[1036.6154, "o", "para\u001b[129Gvenderle\u001b[138Gal\u001b[141GEstado.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mEspejo:\u001b[22m cada barrera\u001b[27Gque nombra INDAP c\u001b[46Gn su\u001b[51Grespu\u001b[57Gsta \u001b[62Gn \u001b[65Ga app, una por clic.\r\u001b[2C\u001b[1B5\u001b[9G\u001b[1mducto\u001b[16G\u001b[22mdemo en\u001b[24Gvivo con\u001b[33Gdos pantallas sincronizadas, el p\u001b[67Gnel de la cocina del col\u001b[92Ggio y el celular de Rosa. Con cuat\u001b[127Go\u001b[129Gclics Ros\u001b[139G publica,\u001b[149Gel\r\u001b[2C\u001b[1B  \u001b[6Gcolegio\u001b[14Gpi\u001b[17Ge\u001b[19Gy Rosa acepta. Los\u001b[38Gr\u00f3tulos leen\u001b[51Glo\u001b[54G n\u00fameros en vivo:\u001b[72Gla compra local\u001b[88Gdel\u001b[92Gcolegio\u001b[100Gpasa\u001b[105Gde\u001b[108G2,0%\u001b[113Ga\u001b[115G5,2%\u001b[120Gy\u001b[122Glo\u001b[125Gque\u001b[129GRosa\u001b[134Gvende\u001b[140Gdirecto\r\u001b[2C\u001b[1B  \u001b[6Gsube a $51.000.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mPor qu\u00e9 ahora:\u001b[21G\u001b[22mel 95,1% de los hogares rurales tiene Inter\u001b[65Get y las bases de\u001b[83G Programa de Aliment\u001b[104Gci\u00f3n Escolar exigen 5% de compra local.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mAlternativas:\u001b[22m una\u001b[24Gmatriz\u001b[31Gfrente\u001b[38Gal\u001b[41Gcami\u00f3n\u001b[48Gintermediario,\u001b[63Gla\u001b[66Gferia\u001b[72Gmayorista,\u001b[83Gla\u001b[86Gferia\u001b[92Glibre\u001b[98Gy\u001b[100Gla\u001b[103Glicitaci\u00f3"]
[1036.6171, "o", "n\u001b[114Gdirecta.\r\u001b[2C\u001b[1B8\u001b[6G\u001b[1mM\u001b[8Gdelo:\u001b[22m el productor no\u001b[30Gpaga; el comprado\u001b[48G paga una comisi\u00f3n de\u001b[70G6% por pedido.\u001b[K\r\u001b[2C\u001b[1B9\u001b[6G\u001b[1mPiloto:\u001b[22m seis meses en una comuna, con hitos ma\u001b[53Gca\u001b[56Gos c\u001b[61Gmo metas.\u001b[K\r\u001b[2C\u001b[1B10. \u001b[1mCi\u001b[10Grre:\u001b[22m Rosa con su\u001b[27Gpedido ac\u001b[37Gptado y la petici\u00f3\u001b[56G concreta:\u001b[67Guna comuna, 4 c\u001b[83Glegios\u001b[90Gy\u001b[92G6\u001b[94Grestoranes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuentes en las l\u00e1minas:\u001b[27G\u001b[22mca\u001b[30Ga cifra lleva su n\u00famero de\u001b[57Grefe\u001b[63Gncia (175.556\u00b9)\u001b[79Gy\u001b[81Gla lista\u001b[90Gde fu\u001b[96Gn\u001b[98Ges va al\u001b[107Gpie\u001b[111Gde\u001b[114Gla\u001b[117Gmisma\u001b[123Gl\u00e1mina:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mINE/ODEPA:\u001b[16G\u001b[22mCenso\u001b[22GAgropecuario\u00a02021.\r\u001b[2C\u001b[1B- \u001b[1mSUBTEL:\u001b[22m encuesta de ac\u001b[28Geso\u001b[32Gy uso\u001b[38Gde Internet de noviembre de\u00a02025. Saqu\u00e9 los dato\u001b[87G rurales direct\u001b[103Gmente de sus tablas.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mDAP\u2013US\u001b[14GCH (2015):\u001b[22m estudio sobre compras\u001b[47Gp\u00fablicas\u001b[56Gde\u001b[59Galimentos\u001b[69Gy\u001b[71Gagricultura\u001b[83Gfamiliar.\r\u001b[4C\u001b[1B\u001b[1mLa \u001b[9Gercera (2024):\u001b[22m cita"]
[1036.6182, "o", "nd\u001b[32Ga\u001b[34GINDAP y JUNAEB.\u001b[50G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mQu\u00e9 convi\u001b[13Gne\u001b[16Grevisar antes de presentarla:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDato de compras escolares:\u001b[32G\u001b[22mla\u001b[35Gcifra\u001b[41Gde\u001b[44G$4.126\u001b[51Gmillones\u001b[60Gvendidos\u001b[69Gpor\u001b[73Gla\u001b[76Gagricultura\u001b[88Gfamiliar\u001b[97Gal\u001b[100GPrograma\u001b[109Gde\u001b[112GAlimentaci\u00f3n\u001b[125GEscolar\u001b[133Gen\u001b[136G2023\u001b[141Gy\u001b[143Gel\u001b[146G5%\u001b[149Gde\r\u001b[2C\u001b[1B  compra local vienen de una nota de prensa.\u001b[48GLos\u001b[52Gsitios\u001b[59Gde\u001b[62GMineduc\u001b[70Gy\u001b[72GJUNAEB\u001b[79Grechazaron\u001b[90Gla\u001b[93Gconexi\u00f3n,\u001b[103Gas\u00ed\u001b[107Gque\u001b[111Gno\u001b[114Gpude\u001b[119Gverificar\u001b[129Gesas\u001b[134Gcifras\u001b[141Gen\u001b[144Gla\r\u001b[2C\u001b[1B \u001b[5Gfuente oficial.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEstudio de INDAP:\u001b[22m es de\u00a02015. La demanda p\u00fablica de US$ 450 millones es una estimaci\u00f3n de ese a\u00f1o.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLo inventado est\u00e1 marcado:\u001b[32G\u001b[22mla\u001b[35Giniciativa,\u001b[47Glos\u001b[51Gpersonajes,\u001b[63Glos\u001b[67Gmontos\u001b[74Gde\u001b[77Gla\u001b[80Gdemo,\u001b[86Gla\u001b[89Gcomisi\u00f3n\u001b[98Gy\u001b[100Glas\u001b[104Gmetas\u001b[110Gdel\u001b[114Gpiloto.\u001b[122GCada\u001b[127Gl\u00e1mina\u001b[134Gcon\u001b[13"]
