[650.0324, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m109\u001b[12G\u001b[38;2;248;248;242m      ],                                                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[18G\u001b[38;2;166;226;46m\"sourc\u001b[25G_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Todas las cifras d\u001b[53G esta l\u00e1mina son metas del piloto definidas por el equipo, no resultados.\"\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m11\u001b[16G\u001b[38;2;248;248;242m},\u001b[20G                                                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m12\u001b[16G\u001b[38;2;248;248;242m{\u001b[18G  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[19G\u001b[38;2;166;226;46mid\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"cierre\"\u001b[38;2;248;248;242m,                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[16G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46m\"layout\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"closing\"\u001b[38;2;248;248;242m,"]
[650.0339, "o", "                                                                                                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;248;248;242m \u001b[18G\u001b[38;2;166;226;46m\"title\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"El jueves, Rosa **pone el precio**\"\u001b[38;2;248;248;242m,                                                                                \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[19G\u001b[38;2;166;226;46mtext\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Les pedimos una comuna, {{fig:piloto-colegios}} colegios y {{fig:piloto-restoranes}} restoranes que compren durante {\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;230;219;116m{fig:piloto-meses}}.\"\u001b[38;2;248;248;242m,    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[19G\u001b[38;2;166;226;46mdevice_route\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"#/productor/fin\"\u001b[38;2;248;248;242m,            \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[19G\u001b[38;2;166;226;46msource_note\"\u001b[38;2;248;248;242m: \u001b[38;2;230;219;116m\"Iniciativa y personajes fic\u001b[62Gici\u001b[66Gs. La\u001b[72G cantidade\u001b[84Gpedidas son metas del piloto."]
[650.035, "o", "\"\u001b[38;2;248;248;242m                              \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 119 \u001b[22m     }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 120 \u001b[22m   ]\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 121 \u001b[22m }\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mChequeos\u001b[12Gen\u001b[15Gverde;\u001b[22Gahora\u001b[28Grecorto\u001b[36Gtexto\u001b[42Gvisible\u001b[50G(avisos\u001b[58Gde\u001b[61G>25\u001b[65Gpalabras)\u001b[75Gy\u001b[77Gquito\u001b[83Gcifras\u001b[90Gno\u001b[93Gusadas.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLos\u001b[7Gavisos\u001b[14Grestantes\u001b[24Gvienen\u001b[31Gsobre\u001b[37Gtodo\u001b[42Gde\u001b[45Glas\u001b[49Gnotas\u001b[55Gde\u001b[58Gfuente,\u001b[66Gque\u001b[70Gel\u001b[73Gpedido\u001b[80Gexige.\u001b[87GConstruyo\u001b[97Gy\u001b[99Greviso\u001b[106Gel\u001b[109Grender.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m5\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mPortada\u001b[11Gy\u001b[13Gpersona\u001b[21Gse\u001b[24Gven\u001b[28Gbien.\u001b[34GSigo\u001b[39Grevisando\u001b[49Gel\u001b[52Gresto\u001b[58Gde\u001b[61Glas\u001b[65Gcapturas,\u001b[75Gincluida\u001b[84Gla\u001b[87Gd"]
[650.0362, "o", "emo\u001b[92Gpaso\u001b[97Ga\u001b[99Gpaso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos\u001b[7Gproblemas\u001b[17Gen\u001b[20Gla\u001b[23Gl\u00e1mina\u001b[30G3:\u001b[33G\u00ab9\u00b2\u00bb\u001b[38Gy\u001b[40G\u00abUS$\u001b[45G450\u001b[49GM\u00b2\u00bb\u001b[53Gse\u001b[56Gleen\u001b[61Gcomo\u001b[66Gpotencia\u001b[75Gy\u001b[77Gmetros\u001b[84Gcuadrados.\u001b[95GLo\u001b[98Gcorrijo.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[46C\u001b[2B\u001b[38;2;153;153;153mthought for 6s)\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
