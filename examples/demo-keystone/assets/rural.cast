[1039.0972, "o", "s\u001b[88Grurales\u001b[96Gdirectamente\u001b[109Gde\u001b[112Gsus\u001b[116Gtablas.\r\u001b[4C\u001b[1B\u001b[1mINDAP\u2013USACH (2015):\u001b[25G\u001b[22mestudio sobre compras p\u00fablicas d\u001b[58G alimentos y agricultura familia\u001b[91G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mLa Tercera (2024):\u001b[22m citan\u001b[30Go a INDAP y JUNAEB.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mQu\u00e9 conviene revisar antes de presentarla:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mDat\u001b[9G de compras escolares:\u001b[22m la cifra de $4.126\u001b[51Gmillones\u001b[60Gvendidos\u001b[69Gpor\u001b[73Gla\u001b[76Gagricultura\u001b[88Gfamiliar\u001b[97Gal\u001b[100GPrograma\u001b[109Gde\u001b[112GAlimentaci\u00f3n\u001b[125GEscolar\u001b[133Gen\u001b[136G2023\u001b[141Gy\u001b[143Gel\u001b[146G5%\u001b[149Gde\r\u001b[2C\u001b[1B \u001b[5Gcompra local vienen de una\u001b[32Gnota de pr\u001b[43Gnsa\u001b[47G Los sitios de Mineduc y JUNAEB rechazaron la conexi\u00f3n, as\u00ed que no pude verificar esas cifras\u001b[141Gen \u001b[145Ga\u001b[K\r\u001b[4C\u001b[1Bfuente\u001b[12Goficial.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEstudio de INDAP:\u001b[23G\u001b[22mes\u001b[26Gde\u00a02015.\u001b[35GLa\u001b[38Gdemanda\u001b[46Gp\u00fablica\u001b[54Gde\u001b[57GUS$\u001b[61G450\u001b[65Gmillones\u001b[74Ges\u001b[77Guna\u001b[81Gestimaci\u00f3n\u001b[92Gde\u001b[95Gese\u001b[99Ga\u00f1o.\r\u001b[4C\u001b[1B\u001b[1mLo inventado est\u00e1 marcado:\u001b[22m la\u001b[35G"]
[1039.0984, "o", "iniciativ\u001b[45G, los personajes, los monto\u001b[74Gde\u001b[77Gla d\u001b[82Gmo, la comisi\u00f3n y las\u001b[104Gmetas\u001b[110Gdel\u001b[114Gpiloto.\u001b[122GCada\u001b[127Gl\u00e1mina\u001b[134Gcon\u001b[138Gesos\u001b[143Gdatos\u001b[149Glo\r\u001b[2C\u001b[1B \u001b[5Gindica en su pie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAvisos pendientes:\u001b[24G\u001b[22mlos\u001b[28Gchequeos\u001b[37Gde\u001b[40Gkeystone\u001b[49Gpasan\u001b[55Gsin\u001b[59Gerrores.\u001b[68GQuedan\u001b[75Gavisos\u001b[82Gde\u001b[85Gexceso\u001b[92Gde\u001b[95Gpalabras\u001b[104Gen\u001b[107Gseis\u001b[112Gl\u00e1minas,\u001b[121Gen\u001b[124Gparte\u001b[130Gpor\u001b[134Glos\u001b[138Gpies\u001b[143Gde\r\u001b[2C\u001b[1B \u001b[5Gfuente que pediste, y otros que\u001b[37Gson fals\u001b[46Gs positivos po\u001b[61G porcentajes dentr\u001b[80G del\u001b[85GCSS.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecisiones\u001b[14Gque\u001b[18Gtom\u00e9\u001b[23Gsin\u001b[27Gconsultarte:\u001b[40Gubicar\u001b[47Gla\u001b[50Giniciativa\u001b[61Gen\u001b[64GChile,\u001b[71Gusar\u001b[76Guna\u001b[80Gpaleta\u001b[87Gverde\u001b[93Gtierra\u001b[100Gpropia\u001b[107Gy\u001b[109Gdirigir\u001b[117Gla\u001b[120Gpresentaci\u00f3n\u001b[133Ga\u001b[135Gun\u001b[138Gmunicipio\u001b[148Gy\u001b[150Ga\r\u001b[2C\u001b[1Bprogramas de fomento que deciden si prest\u001b[45Gn\u001b[47Guna comuna p\u001b[60Gra el piloto.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTodo\u001b[8Gest\u00e1\u001b[13Gen\u001b[16G\u001b[38;2;177;18"]
