[975.2902, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa\u001b[6Gdemo\u001b[11Gya\u001b[14Gfunciona\u001b[23Gde\u001b[26Gpunta\u001b[32Ga\u001b[34Gpunta,\u001b[41Gcon\u001b[45Gla\u001b[48Gcompra\u001b[55Glocal\u001b[61Gsubiendo\u001b[70Ga\u001b[72G5,2%.\u001b[78GAhora\u001b[84Gajusto\u001b[91Gel\u001b[94Gr\u00f3tulo\u001b[101Gque\u001b[105Gtapa\u001b[110Gel\u001b[113Gpanel,\u001b[120Gla\u001b[123Gletra\u001b[129Gchica\u001b[135Gdel\u001b[139Gpanel\u001b[145Gdel\r\u001b[1B \u001b[3Gl\u001b[5Gptop y el celular, que se aprieta al final.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mFunciona,\u001b[13Gpero\u001b[18Gen\u001b[21Gel\u001b[24Gpaso\u001b[29G1\u001b[31Glas\u001b[35Gl\u00edneas\u001b[42Gdel\u001b[46Gr\u00f3tulo\u001b[53Gchocan\u001b[60Gcon\u001b[64Gel\u001b[67Gindicador\u001b[77Gde\u001b[80Gcompra\u001b[87Glocal\u001b[93Gy\u001b[95G\u00abUS$\u001b[100G450\u001b[104Gmillones\u00b2\u00bb\u001b[115Gcasi\u001b[120Gtoca\u001b[125Gla\u001b[128Gcolumna\u001b[136Gvecina.\u001b[144GPaso\u001b[149Gel\r\u001b[1B \u001b[3Gpa\u001b[6Gel a una s\u001b[17Gla co\u001b[23Gumna para que los r\u00f3tulos queden limpi\u001b[62Gs.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[2"]
[975.2919, "o", "2m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEl\u001b[6Gpaso\u001b[11G3\u001b[13Gahora\u001b[19Gtapa\u001b[24Gla\u001b[27Glista\u001b[33Gde\u001b[36Gpedidos;\u001b[45Gintercambio\u001b[57Glas\u001b[61Gdos\u001b[65Gcajas\u001b[71Gpara\u001b[76Gque\u001b[80Gel\u001b[83Gindicador\u001b[93Gquede\u001b[99Gal\u001b[102Gborde\u001b[108Gderecho.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m7\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa\u001b[6Grevisi\u00f3n\u001b[15Gencontr\u00f3\u001b[24Gcuatro\u001b[31Gproblemas\u001b[41Gen\u001b[44Gel\u001b[47Gmodelo:\u001b[55Gel\u001b[58Glaptop\u001b[65Gest\u00e1\u001b[70Gbajo\u001b[75Gel\u001b[78Gcelular\u001b[86Gcon\u001b[90Gun\u001b[93Gestado\u001b[100Ginconsistente,\u001b[115Gla\u001b[118Gl\u00ednea\u001b[124Gdel\u001b[128Gpiloto\u001b[135Gsale\u001b[140Gazul\u001b[145Gpor\u001b[149Gel\r\u001b[1B \u001b[3Gcolor fijo d\u001b[16Gl mo\u001b[21Gor, l\u001b[27Gs cif\u001b[33Gas de \u00abpor\u001b[44Gqu\u00e9 ahora\u00bb\u001b[55Gson demasiado chicas y\u001b[78Gla mat\u001b[85Giz repit\u001b[94G r\u00f3tulos e\u001b[105G las esquin\u001b[117Gs. Ahora corrijo e\u001b[136Gos cuatro\u001b[K\r\u001b[2C\u001b[1Bpuntos.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m4\u001b[22m files, ran \u001b[1m3"]
