[148.1491, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m5\u001b[22m shell commands \u00b7 \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLeyendo c\u00f3mo el motor dibuja las escenas \u001b[38;2;177;185;249mjourney\u001b[39m y \u001b[38;2;177;185;249mmap\u001b[58G\u001b[39mpara\u001b[63Garmar\u001b[69Glas\u001b[73Gdos\u001b[77Gl\u00e1minas.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora busco una cifra\u001b[25Gp\u00fablica\u001b[33Gpara\u001b[38G\u00abde\u001b[42Gcada\u001b[47G100\u001b[51Gproductores,\u001b[64Gcu\u00e1ntos\u001b[72Gvenden\u001b[79Gdirecto\u00bb.\r\u001b[2B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo Agro\u001b[26Gecuario 2021 Chile canal\u001b[51Gde comercializaci\u00f3n venta directa consumidor\u001b[96Gporcentaje\u001b[107Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G6s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"CAF\u001b[19G2021 \"destino\u001b[33Gde\u001b[36Gla\u001b[39Gproducci\u00f3n\"\u001b[51GUPA\u001b[55Gventa\u001b[61Gdirecta\u001b[69G\"consumidor\u001b[81Gfinal\"\u001b[88Gporcentaje\u001b[99GINE\u001b[103G"]
[148.151, "o", "ODEPA\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"porce\u001b[21Gtaje\u001b[26Gagricultura\u001b[38Gfamiliar\u001b[47Gcampesina\u001b[57GChile\u001b[63Gvende\u001b[69Gdirectamente\u001b[82Gcircuitos\u001b[92Gcortos\u001b[99Gestudio\u001b[107GODEPA\u001b[113GINDAP\u001b[119Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mFetch\u001b[22m(https://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actual)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mReceived\u001b[15G\u001b[1m2.3KB\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEncontr\u00e9 el estudio ODEPA/Rimisp\u001b[36G2015;\u001b[42Gbusco\u001b[48Gahora\u001b[54Gel\u001b[57Gdato\u001b[62Gchileno\u001b[70Gde\u001b[73Gexplotaciones\u001b[87Gcon\u001b[91Gventa\u001b[97Gdirecta.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mS\u001b[5Gg\u00fan ODEPA/Rimisp (2015, Cuadro 7),\u001b[40Gsolo el 6"]
