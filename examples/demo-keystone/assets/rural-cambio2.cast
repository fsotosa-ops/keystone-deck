[361.1808, "o", "[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos\u001b[7Gproblemas\u001b[17Gen\u001b[20Gel\u001b[23Gmapa:\u001b[29Gla\u001b[32Getiqueta\u001b[41G\u00ab10\u001b[45Gkm\u00bb\u001b[49Gchoca\u001b[55Gcon\u001b[59G\u00abRosa\u001b[65G\u00b7\u001b[67Glechuga\u00bb\u001b[76G(y\u001b[79G\u00ab20\u001b[83Gkm\u00bb\u001b[87Gcasi\u001b[92Gtoca\u001b[97GZapallo),\u001b[107Gy\u001b[109Gla\u001b[112Gnota\u001b[117Gde\u001b[120Gfuente\u001b[127Gqueda\u001b[133Gencima\u001b[140Gdel\u001b[144Gmapa.\r\u001b[1B \u001b[3GL\u001b[7Gcorrijo.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m3\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Limpio. Compruebo que los productores\u001b[41Gaparecen\u001b[50Gde\u001b[53Ga\u001b[55Guno\u001b[59Gpor\u001b[63Gclic.\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[361.187, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSeg\u00fan ODEPA/Rimisp (2015,\u001b[29GCuadro\u001b[36G7),\u001b[40Gsolo\u001b[45Gel\u001b[48G6%\u001b[51Gde\u001b[54Glas\u001b[58Gexplotaciones\u001b[72Gde\u001b[75Gagricultura\u001b[87Gfamiliar\u001b[96Gparticipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[2C\u001b[1Bcontornos\u001b[13Greales\u001b[20Gde\u001b[23Glas\u001b[27Gcomunas\u001b[35Gpara\u001b[40Gel\u001b[43Gmapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mTengo todo lo que necesito.\u001b[31GEscribo\u001b[39Gel\u001b[42Gcontorno,\u001b[52Glas\u001b[56Gcifras\u001b[63Gy\u001b[65Glas\u001b[69Gdos\u001b[73Gl\u00e1minas.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora las dos l\u00e1minas\u001b[25Gen\u001b[28Gdeck.json\u001b[38G(despu\u00e9s\u001b[47Gde\u001b[50GRosa,\u001b[56Gy\u001b[58Gdespu\u00e9s\u001b[66Gdel\u001b[70Gproblema)\u001b[80Gy\u001b[82Gel\u001b[85Gguion\u001b[91Gen\u001b[94Gtalk.md.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[3"]
[361.1892, "o", "8;2;255;255;255m\u23fa\u001b[3G\u001b[39mL\u00e1minas construidas; ahora\u001b[30Greviso\u001b[37Gc\u00f3mo\u001b[42Gse\u001b[45Gven,\u001b[50Gcon\u001b[54Gcapturas\u001b[63Gpor\u001b[67Gpaso.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m5\u001b[22m times, ran \u001b[1m2\u001b[22m shell commands \u00b7 \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa l\u00e1mina de las personitas se ve bien. Ajusto una etiqueta que afirmaba m\u00e1s de lo que dice\u001b[95Gla\u001b[98Gfuente\u001b[105Gy\u001b[107Greviso\u001b[114Gel\u001b[117Gmapa.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m3\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos problemas en el mapa: la etiqueta \u00ab10 km\u00bb choca con \u00abRosa \u00b7 lechuga\u00bb (y \u00ab20\u001b[83Gkm\u00bb\u001b[87Gcasi\u001b[92Gtoca\u001b[97GZapallo),\u001b[107Gy\u001b[109Gla\u001b[112Gnota\u001b[117Gde\u001b[120Gfuente\u001b[127Gqueda\u001b[133Gencima\u001b[140Gdel\u001b[144Gmapa.\r\u001b[2C\u001b[1BLos\u001b[7Gcorrijo.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, called plugin:pl"]
[361.1903, "o", "aywright:playwright \u001b[1m3\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLimpio. Compruebo que los productores aparecen de a uno por clic.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mCall\u001b[8Gng\u001b[11Gplugin:playwright:\u001b[30Glaywright\u2026\u001b[41G\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
