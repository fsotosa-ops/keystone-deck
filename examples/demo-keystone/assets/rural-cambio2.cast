[392.9455, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[4C\u001b[33B[ODEPA\u001b[12G\u2013\u001b[14GAgricultura\u001b[26Gfamiliar\u001b[35Gy\u001b[37Gcircuitos\u001b[47Gcortos\u001b[54Gen\u001b[57GChile\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[393.1062, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[5G- El dat\u001b[14G e\u001b[17G de 2014\u001b[26Gy no enco\u001b[36Gtr\u00e9\u001b[40Guno m\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[2C\u001b[1B \u001b[5G- Un \u00abcircuito corto\u00bb\u001b[27Gincluye\u001b[35Gventas\u001b[42Gcon\u001b[46Gun\u001b[49Gintermediario,\u001b[64Gas\u00ed\u001b[68Gque\u001b[72Gvender\u001b[79Grealmente\u001b[89Gdirecto\u001b[97Ges\u001b[100Gtodav\u00eda\u001b[108Gmenos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar\u001b[21Gm\u00e1s de\u001b[28Gl\u001b[31Gque dice\u001b[40Gel estudio, la \u001b[56Gtapa\u001b[61Gd\u001b[63Gl me\u001b[68Gio se llama \u00abOtros can\u001b[91Gles\u00bb y no \u00abcami\u00f3n o feria\u001b[117Gmayorista\u00bb.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Es el mapa real de las comunas alrededor de San Vicente de\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[4C\u001b[1BgeoBoundaries\u001b[19G(BCN),\u001b[26GCC\u001b[29GBY\u001b[32G3."]
[393.1074, "o", "0,\u001b[37Gy\u001b[39Gla\u001b[42Gcita\u001b[47Gest\u00e1\u001b[52Gen\u001b[55Gla\u001b[58Gl\u00e1mina.\r\u001b[4C\u001b[1BLa\u001b[8GEscuel\u001b[16GLos Maitenes va al centro. Los seis produc\u001b[59Gores\u001b[64Gaparecen de\u001b[76Ga uno por cli\u001b[90G, co\u001b[95G una l\u00ednea hasta\u001b[112Gla\u001b[115Gescuela: Rosa \u00b7\u001b[131Glechuga, tomate,\r\u001b[4C\u001b[1Bmiel, huevos,\u001b[19Gzapallo y\u001b[29Gqueso de cabra.\u001b[K\r\u001b[4C\u001b[1BEn\u001b[8Gel s\u00e9ptim\u001b[18G clic aparece\u001b[32Ge\u001b[36Gier\u001b[40Ge:\u001b[43G\u00abTodos dentro de 30 km, el radio\u001b[76Gdel pil\u001b[84Gto. Hoy\u001b[92Gnadie los conecta con esa cocina\u00bb.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy\u001b[78Gla\u001b[81Gl\u00e1mina\u001b[88Glo\u001b[91Gdice.\u001b[97GPuse\u001b[102Ga\u001b[104GRosa\u001b[109Ga\u001b[111G12\u001b[114Gkm\u001b[117Gpara\u001b[122Gque\u001b[126Gcalce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Ge\u001b[8Gla\u001b[11Gl\u00e1mina de Ros\u001b[25G; los d\u001b[33Gm\u00e1s quedan entre\u001b[50G15 y 26 km.\u001b[K\r\u001b[4C\u001b[1BCorreg\u00ed dos choques que vi en la revisi\u00f3n: la etiqueta \u00ab10 km\u00bb tapaba a Rosa, y l\u001b[88Gn\u001b[90Gta d\u001b[95G fuente qued\u001b[108Gb\u001b[111Genci\u001b[116Ga del\u001b[122Gmapa.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b"]
[393.1086, "o", "[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\u001b[35G\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[2B- \u001b[38;2;177;185;249mdata/figuras.py\u001b[39m y \u001b[38;2;177;185;249mevidence.json\u001b[39m:\u001b[38Gnueva\u001b[44Gcifra\u001b[50G\u001b[38;2;177;185;249mafc-cc\u001b[57G\u001b[39my\u001b[59Gnueva\u001b[65Greferencia.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdeck.json\u001b[39m:\u001b[16Glas\u001b[20Gdos\u001b[24Gl\u00e1minas\u001b[32Gnuevas.\u001b[40GEl\u001b[43GCSS\u001b[47Gde\u001b[50Gla\u001b[53Gl\u00e1mina\u001b[60Gde\u001b[63Gmapa\u001b[68Gqued\u00f3\u001b[74Gdentro\u001b[81Gdel\u001b[85G\u001b[38;2;177;185;249m<style>\u001b[93G\u001b[39mde\u001b[96Gla\u001b[99Gl\u00e1mina\u001b[106G\u00abproblema\u00bb,\u001b[118Gdonde\u001b[124Gya\u001b[127Gestaban\u001b[135Glos\u001b[139Gdem\u00e1s\r\u001b[2C\u001b[1B \u001b[5Gajustes de estilo.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mtal\u001b[10Gmd\u001b[39m: guion\u001b[21Ge las dos l\u00e1min\u001b[38G,\u001b[40Gcon las transicio\u001b[58Ges de la l\u00e1mina\u001b[76G Rosa y la del problema ajustadas.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249massets/comunas-cachapoal-colchagua.geojson\u001b[39m:\u001b[49Gel\u001b[52Gcontorno\u001b[61Gde\u001b[64Glas\u001b[68Gcomunas.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLa revisi\u00f3n de contenido pasa sin errores; quedan sol\u001b[57G advertencias. L\u001b[75G dos\u001b[80Gl\u00e1minas\u001b[88Gnuevas\u001b[95Gtiene"]
[393.1097, "o", "n\u001b[102Gm\u00e1s\u001b[106Gpalabras\u001b[115Gvisibles\u001b[124Gque\u001b[128Gel\u001b[131Gm\u00e1ximo\u001b[138Grecomendado\r\u001b[2C\u001b[1Bde\u001b[6G25,\u001b[10Gsobre\u001b[16Gtodo\u001b[21Gel\u001b[24Gmapa\u001b[29Gcon\u001b[33Gsus\u001b[37Getiquetas.\u001b[48GEl\u001b[51Gchequeo\u001b[59Gtambi\u00e9n\u001b[67Glee\u001b[71Gcomo\u001b[76G\u00abn\u00fameros\u001b[85Gescritos\u001b[94Ga\u001b[96Gmano\u00bb\u001b[102Gel\u001b[105G\u00abcuadro\u001b[113G7,\u001b[116Gp.\u001b[119G51\u00bb\u001b[123Gy\u001b[125Gla\u001b[128Glicencia\u001b[137G\u00abCC\u001b[141GBY\u001b[144G3.0\u00bb:\r\u001b[2C\u001b[1Bson parte de la ci\u001b[22Ga, n\u001b[28Gcifra\u001b[34G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLas\u001b[7Gc\u001b[9Gp\u001b[11Guras\u001b[16Gest\u00e1n en\u001b[25G\u001b[38;2;177;185;249mdeck/build/review/03-de-cada-cien.png\u001b[63G\u001b[39my\u001b[65G\u001b[38;2;177;185;249mdeck/build/review/05-mapa-todos.png\u001b[39m.\u001b[102GLas\u001b[106Gcapturas\u001b[115Ganteriores\u001b[126Gde\u001b[129Gesa\u001b[133Gcarpeta\u001b[141Gconservan\r\u001b[2C\u001b[1Bla\u001b[6Gnumeraci\u00f3n\u001b[17Gvieja.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFue\u001b[7Gtes:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GODEPA\u001b[11G\u2013\u001b[13GAgricultura\u001b[25Gfamiliar\u001b[34Gy\u001b[36Gcircuitos\u001b[46Gcortos\u001b[53Gen\u001b[56GChile\u001b[62G(2015)\r\u001b[2C\u001b[1B  (h\u001b[8Gtps://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actu"]
