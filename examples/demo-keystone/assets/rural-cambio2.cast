[387.7253, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mDos\u001b[7Gproblemas\u001b[17Gen\u001b[20Gel\u001b[23Gmapa:\u001b[29Gla\u001b[32Getiqueta\u001b[41G\u00ab10\u001b[45Gkm\u00bb\u001b[49Gchoca\u001b[55Gcon\u001b[59G\u00abRosa\u001b[65G\u00b7\u001b[67Glechuga\u00bb\u001b[76G(y\u001b[79G\u00ab20\u001b[83Gkm\u00bb\u001b[87Gcasi\u001b[92Gtoca\u001b[97GZapallo),\u001b[107Gy\u001b[109Gla\u001b[112Gnota\u001b[117Gde\u001b[120Gfuente\u001b[127Gqueda\u001b[133Gencima\u001b[140Gdel\u001b[144Gmapa.\r\u001b[1B \u001b[3GLos corrijo.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m3\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLimpio.\u001b[11GCompruebo\u001b[21Gque\u001b[25Glos\u001b[29Gproductores\u001b[41Gaparecen\u001b[50Gde\u001b[53Ga\u001b[55Guno\u001b[59Gpor\u001b[63Gclic.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled plugin:playwright:playwright, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9\u001b[11Glas\u001b[15Gdos\u001b[19Gl\u00e1minas\u001b[27Gy\u001b[29Greconstru\u00ed\u001b[40Gel\u001b[43Gdeck:\u001b[49Gahora\u001b[55Gtiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b["]
[387.7265, "o", "106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[1B \u001b[3Gpr\u001b[6Gductores y\u001b[17Gcada clic agrega uno, siete clics en total.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mNuevo orden:\u001b[22m portada \u2192\u001b[26Gpersona\u001b[34G\u2192\u001b[36G\u001b[1mde-cada-cien\u001b[49G\u001b[22m\u2192\u001b[51Gproblema\u001b[60G\u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gespejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[123G9:30.\r\u001b[2B \u001b[3G\u001b[1m1. \u00abDe cada cien productores familiares, casi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\r\u001b[2C\u001b[2B\u001b[22m- Salen 100 personitas y solo \u001b[1m6\u001b[22m llegan a \u00abVenden en circuito corto\u00bb. Las dem\u00e1s se quedan en\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFuente:\u001b[13G\u001b[22mODEPA\u2013Rimisp\u001b[26G(2015),\u001b[34G\u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m,\u001b[84Gcuadro\u001b[91G7,\u001b[94Gp.\u00a051.\u001b[101GSon\u001b[105G13.706\u001b[112Gproductores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[1B \u001b[3G  (catastro INDAP\u00a02014) sobre 239.469 explotacio\u001b[52Ges de agricultur"]
[387.7266, "o", "a familiar (C\u001b[82Gns\u001b[85G\u00a02007). Eso da 5,72%,\u001b[107Gque en\u001b[114Gla\u001b[117Gl\u00e1mina\u001b[124Gse\u001b[127Glee\u001b[131Gcomo\u001b[136G\u00ab6\u001b[139Gde\u001b[142Gcada\r\u001b[4C\u001b[1Bcien\u00bb,\u001b[12Gcon\u001b[16Gsu\u001b[19Gn\u00famero\u001b[26Gde\u001b[29Greferencia\u001b[40Gal\u001b[43Gpie.\r\u001b[2C\u001b[1B- \u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GEl\u001b[10Gdato\u001b[15Ges\u001b[18Gde\u001b[21G2014\u001b[26Gy\u001b[28Gno\u001b[31Gencontr\u00e9\u001b[40Guno\u001b[44Gm\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[1B \u001b[3G  -\u001b[7GUn \u00abcircuito\u001b[20Gcorto\u00bb incluye ven\u001b[40Gs con un\u001b[49Gintermediari\u001b[62G, as\u00ed que vender\u001b[79Grealmente d\u001b[91Grecto\u001b[97Ges todav\u00eda menos. La l\u00e1mina y\u001b[127Gel guio\u001b[135G lo dicen.\u001b[K\r\u001b[2C\u001b[1B- Para no afirmar\u001b[21Gm\u00e1s\u001b[25Gde\u001b[28Glo\u001b[31Gque\u001b[35Gdice\u001b[40Gel\u001b[43Gestudio,\u001b[52Gla\u001b[55Getapa\u001b[61Gdel\u001b[65Gmedio\u001b[71Gse\u001b[74Gllama\u001b[80G\u00abOtros\u001b[87Gcanales\u00bb\u001b[96Gy\u001b[98Gno\u001b[101G\u00abcami\u00f3n\u001b[109Go\u001b[111Gferia\u001b[117Gmayorista\u00bb.\r\u001b[2C\u001b[2B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\u001b[22m\u001b[K\r\u001b[2B \u001b[3G- Es el\u001b[11Gmapa "]
[387.7414, "o", "r\u001b[18Gal\u001b[21Gde las comunas alrededo\u001b[45G d\u001b[48G San\u001b[53GVicente de Tagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[4C\u001b[1BgeoBoundaries\u001b[19G(BCN),\u001b[26GCC\u001b[29GBY\u001b[32G3.0,\u001b[37Gy\u001b[39Gla\u001b[42Gcita\u001b[47Gest\u00e1\u001b[52Gen\u001b[55Gla\u001b[58Gl\u00e1mina.\r\u001b[1B \u001b[3G- La Escuela\u001b[16GL\u001b[18Gs Maiten\u001b[27Gs\u001b[29Gva al centro. Los seis pr\u001b[55Gductores\u001b[64Gaparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[1B    miel, huevos, zapallo y queso de cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEn\u001b[8Gel\u001b[11Gs\u00e9ptimo\u001b[19Gclic\u001b[24Gaparece\u001b[32Gel\u001b[35Gcierre:\u001b[43G\u00abTodos\u001b[50Gdentro\u001b[57Gde\u001b[60G30\u001b[63Gkm,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[1B \u001b[3G-\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[387.928, "o", "\u001b]0;\u25d1 Escenas del motor en deck/\u0007"]
[387.9561, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[4C\u001b[33B\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy\u001b[78Gla\u001b[81Gl\u00e1mina\u001b[88Glo\u001b[91Gdice.\u001b[97GPuse\u001b[102Ga\u001b[104GRosa\u001b[109Ga\u001b[111G12\u001b[114Gkm\u001b[117Gpara\u001b[122Gque\u001b[126Gcalce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[388.275, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m3\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLimpio. Compruebo que los productores aparecen de a uno por clic.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mCalled plugin:playwright:playwright, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9 las dos l\u00e1minas y reconstru\u00ed el deck: ahora tiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b[106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[2C\u001b[1Bproductores\u001b[15Gy\u001b[17Gcada\u001b[22Gclic\u001b[27Gagrega\u001b[34Guno,\u001b[39Gsiete\u001b[45Gclics\u001b[51Gen\u001b[54Gtotal.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNuevo orden:\u001b[22m port\u001b[21Gda \u2192 person\u001b[34G\u2192 \u001b[1mde-cada-cien\u001b[22m \u2192\u001b[51Gproblema \u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gespejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[12"]
[388.2762, "o", "3G9:30.\r\u001b[2C\u001b[2B\u001b[1m1. \u00abDe cada cien productores familiares, \u001b[45Gasi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\u001b[82G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Salen 100 personitas y solo \u001b[1m6\u001b[22m llegan a \u00abVenden en circuito corto\u00bb. Las dem\u00e1s\u001b[82Gse\u001b[85Gquedan\u001b[92Gen\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFuente:\u001b[13G\u001b[22mODEPA\u2013Rimisp\u001b[26G(2015),\u001b[34G\u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m,\u001b[84Gcuadro\u001b[91G7,\u001b[94Gp.\u00a051.\u001b[101GSon\u001b[105G13.706\u001b[112Gproductores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[2C\u001b[1B \u001b[5G(catastro\u001b[15GINDAP\u00a02014) sobre\u001b[33G239.469 explotacion\u001b[53Gs\u001b[55Gde agricultura familiar (Censo\u00a02007). Eso da 5,72%, que en\u001b[114Gla l\u00e1mina\u001b[124Gse\u001b[127Glee\u001b[131Gcomo\u001b[136G\u00ab6\u001b[139Gde\u001b[142Gcada\r\u001b[2C\u001b[1B \u001b[5Gcien\u00bb, con su n\u00fa\u001b[22Gero\u001b[26Gde referencia al pie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- El dat\u001b[14G e\u001b[17G de 2014\u001b[26Gy no enco\u001b[36Gtr\u00e9\u001b[40Guno m\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor"]
[388.2775, "o", "\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[2C\u001b[1B \u001b[5G- Un \u00abcircuito corto\u00bb\u001b[27Gincluye\u001b[35Gventas\u001b[42Gcon\u001b[46Gun\u001b[49Gintermediario,\u001b[64Gas\u00ed\u001b[68Gque\u001b[72Gvender\u001b[79Grealmente\u001b[89Gdirecto\u001b[97Ges\u001b[100Gtodav\u00eda\u001b[108Gmenos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar\u001b[21Gm\u00e1s de\u001b[28Gl\u001b[31Gque dice\u001b[40Gel estudio, la \u001b[56Gtapa\u001b[61Gd\u001b[63Gl me\u001b[68Gio se llama \u00abOtros can\u001b[91Gles\u00bb y no \u00abcami\u00f3n o feria\u001b[117Gmayorista\u00bb.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Es el mapa real de las comunas alrededor de San Vicente de\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[4C\u001b[1BgeoBoundaries\u001b[19G(BCN),\u001b[26GCC\u001b[29GBY\u001b[32G3.0,\u001b[37Gy\u001b[39Gla\u001b[42Gcita\u001b[47Gest\u00e1\u001b[52Gen\u001b[55Gla\u001b[58Gl\u00e1mina.\r\u001b[4C\u001b[1BLa\u001b[8GEscuel\u001b[16GLos Maitenes va al centro. Los seis produc\u001b[59Gores\u001b[64Gaparecen de\u001b[76Ga uno por c"]
[388.2787, "o", "li\u001b[90G, co\u001b[95G una l\u00ednea hasta\u001b[112Gla\u001b[115Gescuela: Rosa \u00b7\u001b[131Glechuga, tomate,\r\u001b[4C\u001b[1Bmiel, huevos,\u001b[19Gzapallo y\u001b[29Gqueso de cabra.\u001b[K\r\u001b[4C\u001b[1BEn\u001b[8Gel s\u00e9ptim\u001b[18G clic aparece\u001b[32Ge\u001b[36Gier\u001b[40Ge:\u001b[43G\u00abTodos dentro de 30 km, el radio\u001b[76Gdel pil\u001b[84Gto. Hoy\u001b[92Gnadie los conecta con esa cocina\u00bb.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy\u001b[78Gla\u001b[81Gl\u00e1mina\u001b[88Glo\u001b[91Gdice.\u001b[97GPuse\u001b[102Ga\u001b[104GRosa\u001b[109Ga\u001b[111G12\u001b[114Gkm\u001b[117Gpara\u001b[122Gque\u001b[126Gcalce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Ge\u001b[8Gla\u001b[11Gl\u00e1mina de Ros\u001b[25G; los d\u001b[33Gm\u00e1s quedan entre\u001b[50G15 y 26 km.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[388.7787, "o", "\u001b]0;\u25d0 Escenas del motor en deck/\u0007"]
[388.902, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m3\u001b[22m times, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLimpio.\u001b[11GCompruebo\u001b[21Gque\u001b[25Glos\u001b[29Gproductores\u001b[41Gaparecen\u001b[50Gde\u001b[53Ga\u001b[55Guno\u001b[59Gpor\u001b[63Gclic.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled plugin:playwright:playwright, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9\u001b[11Glas\u001b[15Gdos\u001b[19Gl\u00e1minas\u001b[27Gy\u001b[29Greconstru\u00ed\u001b[40Gel\u001b[43Gdeck:\u001b[49Gahora\u001b[55Gtiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b[106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[1B \u001b[3Gproductore\u001b[15Gy cada clic\u001b[27Gag\u001b[31Gga uno, siete \u001b[46Glics en total.\u001b[61G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNuevo orden:\u001b[16G\u001b[22mportada\u001b[24G\u2192\u001b[26Gpersona\u001b[34G\u2192\u001b[36G\u001b[1mde-cada-cien\u001b[49G\u001b[22m\u2192\u001b[51Gproblema\u001b[60G\u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gesp"]
[388.9031, "o", "ejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[123G9:30.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. \u00abDe cada cien productores familiares, casi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSalen\u001b[11G100\u001b[15Gpersonitas\u001b[26Gy\u001b[28Gsolo\u001b[33G\u001b[1m6\u001b[35G\u001b[22mllegan\u001b[42Ga\u001b[44G\u00abVenden\u001b[52Gen\u001b[55Gcircuito\u001b[64Gcorto\u00bb.\u001b[72GLas\u001b[76Gdem\u00e1s\u001b[82Gse\u001b[85Gquedan\u001b[92Gen\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[4C\u001b[1B\u001b[1mFuente:\u001b[22m ODEPA\u2013Rimisp\u001b[26G(2015), \u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m, cuadro 7, p.\u00a051. Son 13.706 productores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[2C\u001b[1B \u001b[5G(catastro INDAP\u00a02014) sobre 239.469 explotaciones de agricultura familiar (Censo\u00a02007). Eso da 5,72%, que en la l\u00e1mina\u001b[124Gse\u001b[127Glee com\u001b[135G \u00ab6 de cada\r\u001b[4C\u001b[1Bcien\u00bb, c\u001b[14Gn su n\u00famero de referencia al \u001b[44Gie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- El dato es de 2014\u001b[26Gy\u001b[28Gno\u001b[31Gencontr\u00e9\u001b"]
[388.9043, "o", "[40Guno\u001b[44Gm\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[6C\u001b[1BUn\u001b[10G\u00abcircuito corto\u00bb i\u001b[29Gcluye ventas con un int\u001b[53Grm\u001b[56Gdiario, as\u00ed que vender realmente directo\u001b[97Ges todav\u00eda menos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar m\u00e1s de lo qu\u001b[35Gdice el est\u001b[47Gdio, la \u001b[56Gtapa del medio se llama \u00abOtros canal\u001b[93Gs\u00bb y no \u00abc\u001b[104Gmi\u00f3n o feria mayorista\u00bb.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEs\u001b[8Gel\u001b[11Gmapa\u001b[16Greal\u001b[21Gde\u001b[24Glas\u001b[28Gcomunas\u001b[36Galrededor\u001b[46Gde\u001b[49GSan\u001b[53GVicente\u001b[61Gde\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[2C\u001b[1B \u001b[5GgeoBoundaries (BCN), CC BY 3.0, y la cita \u001b[48Gst\u00e1 en la l\u00e1mina.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLa Escuela Los Maitenes\u001b[29Gv"]
[388.9055, "o", "a\u001b[32Gal centro. Los\u001b[47Gseis\u001b[52Gproductores aparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[2C\u001b[1B \u001b[5Gmiel, huevos, zapallo y\u001b[29Gqueso\u001b[35Gd\u001b[37G cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEn el\u001b[11Gs\u00e9ptimo\u001b[19Gclic aparece el\u001b[35Gcierre: \u00abTodos\u001b[50Gdentro\u001b[57Gde\u001b[60G30\u001b[63Gkm,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[4C\u001b[1B\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy \u001b[79Ga l\u00e1mina\u001b[88Gl\u001b[90G dice. Puse\u001b[102Ga Rosa a 12\u001b[114Gkm para que calce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Gen la l\u00e1mina de Rosa; los dem\u00e1s quedan entre 15 y 26 km.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCorreg\u00ed dos choque\u001b[24G que vi \u001b[33Gn la r\u001b[40Gvisi\u00f3\u001b[46G: la etiqueta \u00ab10\u001b[64Gkm\u00bb\u001b[68Gtapaba\u001b[75Ga\u001b[77GRosa,\u001b[83Gy\u001b[85Gla\u001b[88Gnota\u001b[93Gde\u001b[96Gfuente\u001b[103Gquedaba\u001b[111Gencima\u001b[118Gdel\u001b[122Gmapa.\r\u001b[2C\u001b[1B\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[389.0538, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled plugin:playwright:playwright, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9\u001b[11Glas\u001b[15Gdos\u001b[19Gl\u00e1minas\u001b[27Gy\u001b[29Greconstru\u00ed\u001b[40Gel\u001b[43Gdeck:\u001b[49Gahora\u001b[55Gtiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b[106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[2C\u001b[1Bproductores y cada clic agrega uno, siete clics en total.\r\u001b[2B \u001b[3G\u001b[1mNuevo orden:\u001b[22m portada \u2192 persona \u2192 \u001b[1mde-cada-cien\u001b[49G\u001b[22m\u2192 p\u001b[53Goblema \u2192 \u001b[1mmapa\u001b[22m \u2192\u001b[69Gespejo\u001b[76G\u2192 \u2026 \u2192\u001b[82Gcierre. La duraci\u00f3n total pasa de 8:00\u001b[121Ga 9:30.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. \u00abDe cada cien productores familiares, casi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSalen\u001b[11G100\u001b[15Gpersonitas\u001b[26Gy\u001b[28Gsolo\u001b[33G\u001b[1m6\u001b[35G\u001b[22mllegan\u001b[42Ga\u001b[44G\u00abVenden\u001b[52Gen\u001b[55Gcircuito\u001b[64Gcorto\u00bb.\u001b[72GLas\u001b[76Gdem\u00e1s\u001b[82Gse\u001b[85"]
[389.0599, "o", "Gquedan\u001b[92Gen\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[2C\u001b[1B- \u001b[1mFuente:\u001b[22m ODEPA\u2013Rimisp (2015), \u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m,\u001b[84Gcuadro\u001b[91G7,\u001b[94Gp.\u00a051.\u001b[101GSon\u001b[105G13.706\u001b[112Gproductores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[4C\u001b[1B(catastro\u001b[15GINDAP\u00a02014)\u001b[27Gsobre\u001b[33G239.469\u001b[41Gexplotaciones\u001b[55Gde\u001b[58Gagricultura\u001b[70Gfamiliar\u001b[79G(Censo\u00a02007).\u001b[93GEso\u001b[97Gda\u001b[100G5,72%,\u001b[107Gque\u001b[111Gen\u001b[114Gla\u001b[117Gl\u00e1mina\u001b[124Gse\u001b[127Glee\u001b[131Gcomo\u001b[136G\u00ab6\u001b[139Gde\u001b[142Gcada\r\u001b[2C\u001b[1B \u001b[5Gcien\u00bb, con su n\u00famero\u001b[26Gde referencia al pie.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- El dat\u001b[15Ges de \u001b[25G y no \u001b[32Gncontr\u00e9 uno m\u00e1s reci\u001b[53Gnte:\u001b[58Gel censo de\u001b[70G2021 no publica cifras\u001b[93Gpor\u001b[97Gc\u001b[99Gnal de venta.\u001b[K\r\u001b[4C\u001b[1B- U\u001b[9G \u00abcircuito cort\u001b[25G\u00bb incluye ventas con un\u001b[49Gintermediario,\u001b[64Gas\u00ed\u001b[68Gque\u001b[72Gvender\u001b[79Grealmente\u001b[89Gdirecto\u001b[97Ges\u001b[100Gtodav\u00eda\u001b[108Gmenos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[4C\u001b["]
[389.061, "o", "1BPara no afirmar m\u00e1s\u001b[25Gde\u001b[28Glo\u001b[31Gque\u001b[35Gdice\u001b[40Gel\u001b[43Gestudio,\u001b[52Gla\u001b[55Getapa\u001b[61Gdel\u001b[65Gmedio\u001b[71Gse\u001b[74Gllama\u001b[80G\u00abOtros\u001b[87Gcanales\u00bb\u001b[96Gy\u001b[98Gno\u001b[101G\u00abcami\u00f3n\u001b[109Go\u001b[111Gferia\u001b[117Gmayorista\u00bb.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEs\u001b[8Gel\u001b[11Gmapa\u001b[16Greal\u001b[21Gde\u001b[24Glas\u001b[28Gcomunas\u001b[36Galrededor\u001b[46Gde\u001b[49GSan\u001b[53GVicente\u001b[61Gde\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[2C\u001b[1B  geoBoundaries (BCN), CC BY 3.0, y la cita est\u00e1 en la l\u00e1mina.\r\u001b[2C\u001b[1B-\u001b[5GLa\u001b[8GEscuela\u001b[16GLos\u001b[20GMaitenes\u001b[29Gva\u001b[32Gal\u001b[35Gcentro.\u001b[43GLos\u001b[47Gseis\u001b[52Gproductores\u001b[64Gaparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[2C\u001b[1B \u001b[5Gmiel,\u001b[11Ghuevos, zapal\u001b[25Go y queso de cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G"]
[389.0622, "o", "En el s\u00e9pt\u001b[16Gmo\u001b[19Gclic aparece\u001b[32Gel cierre: \u00abTodo\u001b[49G dentro de 30 km,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[4C\u001b[1B\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy\u001b[78Gla l\u00e1mina lo dice. Puse a Ros\u001b[108G a 12 km para que c\u001b[128Glce con lo que se dice\r\u001b[4C\u001b[1Ben \u001b[9Ga\u001b[11Gl\u00e1mina de Rosa;\u001b[27Glos dem\u00e1s quedan entre\u001b[50G15\u001b[53Gy\u001b[55G26\u001b[58Gkm.\r\u001b[4C\u001b[1BCorreg\u00ed dos choques que vi\u001b[33Gn\u001b[35Gla \u001b[39Gevisi\u00f3n: la \u001b[52Gtiqueta\u001b[60G\u00ab10 km\u00bb tap\u001b[72Gba a Rosa, y la\u001b[88Gn\u001b[90Gta de fuente qu\u001b[106Gdaba e\u001b[113Gcim\u001b[118Gdel m\u001b[124Gpa.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[389.3517, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled plugin:playwright:playwright, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9\u001b[11Glas\u001b[15Gdos\u001b[19Gl\u00e1minas\u001b[27Gy\u001b[29Greconstru\u00ed\u001b[40Gel\u001b[43Gdeck:\u001b[49Gahora\u001b[55Gtiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b[106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[1B \u001b[3Gproductore\u001b[15Gy cada clic\u001b[27Gag\u001b[31Gga uno, siete \u001b[46Glics en total.\u001b[61G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNuevo orden:\u001b[16G\u001b[22mportada\u001b[24G\u2192\u001b[26Gpersona\u001b[34G\u2192\u001b[36G\u001b[1mde-cada-cien\u001b[49G\u001b[22m\u2192\u001b[51Gproblema\u001b[60G\u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gespejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[123G9:30.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. \u00abDe cada cien productores familiares, casi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSalen\u001b[11G100\u001b[15Gpersonitas\u001b[26Gy\u001b[28Gsolo\u001b[33G\u001b[1m6\u001b["]
[389.3529, "o", "35G\u001b[22mllegan\u001b[42Ga\u001b[44G\u00abVenden\u001b[52Gen\u001b[55Gcircuito\u001b[64Gcorto\u00bb.\u001b[72GLas\u001b[76Gdem\u00e1s\u001b[82Gse\u001b[85Gquedan\u001b[92Gen\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[4C\u001b[1B\u001b[1mFuente:\u001b[22m ODEPA\u2013Rimisp\u001b[26G(2015), \u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m, cuadro 7, p.\u00a051. Son 13.706 productores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[2C\u001b[1B \u001b[5G(catastro INDAP\u00a02014) sobre 239.469 explotaciones de agricultura familiar (Censo\u00a02007). Eso da 5,72%, que en la l\u00e1mina\u001b[124Gse\u001b[127Glee com\u001b[135G \u00ab6 de cada\r\u001b[4C\u001b[1Bcien\u00bb, c\u001b[14Gn su n\u00famero de referencia al \u001b[44Gie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- El dato es de 2014\u001b[26Gy\u001b[28Gno\u001b[31Gencontr\u00e9\u001b[40Guno\u001b[44Gm\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[6C\u001b[1BUn\u001b[10G\u00abcircuito corto\u00bb i\u001b[29Gcluye ventas con un int\u001b[53Grm\u001b[56Gdiario, as\u00ed que vender realmente directo\u001b[97Ges todav\u00eda menos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139G"]
[389.3542, "o", "dicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar m\u00e1s de lo qu\u001b[35Gdice el est\u001b[47Gdio, la \u001b[56Gtapa del medio se llama \u00abOtros canal\u001b[93Gs\u00bb y no \u00abc\u001b[104Gmi\u00f3n o feria mayorista\u00bb.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEs\u001b[8Gel\u001b[11Gmapa\u001b[16Greal\u001b[21Gde\u001b[24Glas\u001b[28Gcomunas\u001b[36Galrededor\u001b[46Gde\u001b[49GSan\u001b[53GVicente\u001b[61Gde\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[2C\u001b[1B \u001b[5GgeoBoundaries (BCN), CC BY 3.0, y la cita \u001b[48Gst\u00e1 en la l\u00e1mina.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLa Escuela Los Maitenes\u001b[29Gva\u001b[32Gal centro. Los\u001b[47Gseis\u001b[52Gproductores aparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[2C\u001b[1B \u001b[5Gmiel, huevos, zapallo y\u001b[29Gqueso\u001b[35Gd\u001b[37G cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEn el\u001b[11Gs\u00e9ptimo\u001b[19Gclic aparece el\u001b[35Gcierre: "]
[389.356, "o", "\u00abTodos\u001b[50Gdentro\u001b[57Gde\u001b[60G30\u001b[63Gkm,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[4C\u001b[1B\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy \u001b[79Ga l\u00e1mina\u001b[88Gl\u001b[90G dice. Puse\u001b[102Ga Rosa a 12\u001b[114Gkm para que calce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Gen la l\u00e1mina de Rosa; los dem\u00e1s quedan entre 15 y 26 km.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCorreg\u00ed dos choque\u001b[24G que vi \u001b[33Gn la r\u001b[40Gvisi\u00f3\u001b[46G: la etiqueta \u00ab10\u001b[64Gkm\u00bb\u001b[68Gtapaba\u001b[75Ga\u001b[77GRosa,\u001b[83Gy\u001b[85Gla\u001b[88Gnota\u001b[93Gde\u001b[96Gfuente\u001b[103Gquedaba\u001b[111Gencima\u001b[118Gdel\u001b[122Gmapa.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdata/figuras.py\u001b[21G\u001b[39my\u001b[23G\u001b[38;2;177;185;249mevidence.json\u001b[39m:\u001b[38Gnueva\u001b[44Gcifra\u001b[50G\u001b[38;2;177;185;249mafc-cc\u001b[57G\u001b[39my\u001b[59Gnueva\u001b[65Greferencia.\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[389.7391, "o", "\u001b]0;\u25d1 Escenas del motor en deck/\u0007"]
[389.846, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[4C\u001b[33B\u001b[38;2;177;185;249mdeck.json\u001b[39m:\u001b[16Glas\u001b[20Gdos\u001b[24Gl\u00e1minas\u001b[32Gnuevas.\u001b[40GEl\u001b[43GCSS\u001b[47Gde\u001b[50Gla\u001b[53Gl\u00e1mina\u001b[60Gde\u001b[63Gmapa\u001b[68Gqued\u00f3\u001b[74Gdentro\u001b[81Gdel\u001b[85G\u001b[38;2;177;185;249m<style>\u001b[93G\u001b[39mde\u001b[96Gla\u001b[99Gl\u00e1mina\u001b[106G\u00abproblema\u00bb,\u001b[118Gdonde\u001b[124Gya\u001b[127Gestaban\u001b[135Glos\u001b[139Gdem\u00e1s\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[390.0064, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9 las dos l\u00e1minas y reconstru\u00ed el deck: ahora tiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b[106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[2C\u001b[1Bproductores\u001b[15Gy\u001b[17Gcada\u001b[22Gclic\u001b[27Gagrega\u001b[34Guno,\u001b[39Gsiete\u001b[45Gclics\u001b[51Gen\u001b[54Gtotal.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNuevo orden:\u001b[22m port\u001b[21Gda \u2192 person\u001b[34G\u2192 \u001b[1mde-cada-cien\u001b[22m \u2192\u001b[51Gproblema \u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gespejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[123G9:30.\r\u001b[2C\u001b[2B\u001b[1m1. \u00abDe cada cien productores familiares, \u001b[45Gasi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\u001b[82G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Salen 100 personitas y solo \u001b[1m6\u001b[22m llegan a \u00abVenden en circuito corto\u00bb. Las dem\u00e1s\u001b[82Gse\u001b[85Gquedan\u001b[92Gen\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFuente:\u001b[13G\u001b[22mODEPA\u2013Rimisp\u001b[26G(2015),\u001b[34"]
[390.01, "o", "G\u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m,\u001b[84Gcuadro\u001b[91G7,\u001b[94Gp.\u00a051.\u001b[101GSon\u001b[105G13.706\u001b[112Gproductores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[2C\u001b[1B \u001b[5G(catastro\u001b[15GINDAP\u00a02014) sobre\u001b[33G239.469 explotacion\u001b[53Gs\u001b[55Gde agricultura familiar (Censo\u00a02007). Eso da 5,72%, que en\u001b[114Gla l\u00e1mina\u001b[124Gse\u001b[127Glee\u001b[131Gcomo\u001b[136G\u00ab6\u001b[139Gde\u001b[142Gcada\r\u001b[2C\u001b[1B \u001b[5Gcien\u00bb, con su n\u00fa\u001b[22Gero\u001b[26Gde referencia al pie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- El dat\u001b[14G e\u001b[17G de 2014\u001b[26Gy no enco\u001b[36Gtr\u00e9\u001b[40Guno m\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[2C\u001b[1B \u001b[5G- Un \u00abcircuito corto\u00bb\u001b[27Gincluye\u001b[35Gventas\u001b[42Gcon\u001b[46Gun\u001b[49Gintermediario,\u001b[64Gas\u00ed\u001b[68Gque\u001b[72Gvender\u001b[79Grealmente\u001b[89Gdirecto\u001b[97Ges\u001b[100Gtodav\u00eda\u001b[108Gmenos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar\u001b[21Gm\u00e1s de\u001b[28Gl\u001b[31Gque dice\u001b[40Gel estudio, la \u001b[56Gtapa\u001b[61Gd\u001b[63"]
[390.0111, "o", "Gl me\u001b[68Gio se llama \u00abOtros can\u001b[91Gles\u00bb y no \u00abcami\u00f3n o feria\u001b[117Gmayorista\u00bb.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Es el mapa real de las comunas alrededor de San Vicente de\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[4C\u001b[1BgeoBoundaries\u001b[19G(BCN),\u001b[26GCC\u001b[29GBY\u001b[32G3.0,\u001b[37Gy\u001b[39Gla\u001b[42Gcita\u001b[47Gest\u00e1\u001b[52Gen\u001b[55Gla\u001b[58Gl\u00e1mina.\r\u001b[4C\u001b[1BLa\u001b[8GEscuel\u001b[16GLos Maitenes va al centro. Los seis produc\u001b[59Gores\u001b[64Gaparecen de\u001b[76Ga uno por cli\u001b[90G, co\u001b[95G una l\u00ednea hasta\u001b[112Gla\u001b[115Gescuela: Rosa \u00b7\u001b[131Glechuga, tomate,\r\u001b[4C\u001b[1Bmiel, huevos,\u001b[19Gzapallo y\u001b[29Gqueso de cabra.\u001b[K\r\u001b[4C\u001b[1BEn\u001b[8Gel s\u00e9ptim\u001b[18G clic aparece\u001b[32Ge\u001b[36Gier\u001b[40Ge:\u001b[43G\u00abTodos dentro de 30 km, el radio\u001b[76Gdel pil\u001b[84Gto. Hoy\u001b[92Gnadie los conecta con esa cocina\u00bb.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLa comuna es real, pero la escuela y las ubicacion"]
[390.0124, "o", "es son ilustrativas\u001b[22m,\u001b[76Gy\u001b[78Gla\u001b[81Gl\u00e1mina\u001b[88Glo\u001b[91Gdice.\u001b[97GPuse\u001b[102Ga\u001b[104GRosa\u001b[109Ga\u001b[111G12\u001b[114Gkm\u001b[117Gpara\u001b[122Gque\u001b[126Gcalce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Ge\u001b[8Gla\u001b[11Gl\u00e1mina de Ros\u001b[25G; los d\u001b[33Gm\u00e1s quedan entre\u001b[50G15 y 26 km.\u001b[K\r\u001b[4C\u001b[1BCorreg\u00ed dos choques que vi en la revisi\u00f3n: la etiqueta \u00ab10 km\u00bb tapaba a Rosa, y l\u001b[88Gn\u001b[90Gta d\u001b[95G fuente qued\u001b[108Gb\u001b[111Genci\u001b[116Ga del\u001b[122Gmapa.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\u001b[35G\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[2B- \u001b[38;2;177;185;249mdata/figuras.py\u001b[39m y \u001b[38;2;177;185;249mevidence.json\u001b[39m:\u001b[38Gnueva\u001b[44Gcifra\u001b[50G\u001b[38;2;177;185;249mafc-cc\u001b[57G\u001b[39my\u001b[59Gnueva\u001b[65Greferencia.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdeck.json\u001b[39m:\u001b[16Glas\u001b[20Gdos\u001b[24Gl\u00e1minas\u001b[32Gnuevas.\u001b[40GEl\u001b[43GCSS\u001b[47Gde\u001b[50Gla\u001b[53Gl\u00e1mina\u001b[60Gde\u001b[63Gmapa\u001b[68Gqued\u00f3\u001b[74Gdentro\u001b[81Gdel\u001b[85G\u001b[38;2;177;185;249m<style>\u001b[93G\u001b[39mde\u001b[96Gla\u001b[99Gl\u00e1mina\u001b[106G\u00abproblema\u00bb,\u001b[118Gdonde\u001b[124Gya\u001b[127Gestaban\u001b[135Glos\u001b[13"]
[390.0137, "o", "9Gdem\u00e1s\r\u001b[2C\u001b[1B \u001b[5Gajustes de estilo.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
[390.2538, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAgregu\u00e9\u001b[11Glas\u001b[15Gdos\u001b[19Gl\u00e1minas\u001b[27Gy\u001b[29Greconstru\u00ed\u001b[40Gel\u001b[43Gdeck:\u001b[49Gahora\u001b[55Gtiene\u001b[61G12.\u001b[65GLas\u001b[69Grevis\u00e9\u001b[76Gen\u001b[79Gel\u001b[82Gnavegador\u001b[92Ga\u001b[94G1920\u00d71080\u001b[104Gy\u001b[106Gel\u001b[109Gmapa\u001b[114Gavanza\u001b[121Gbien\u001b[126Gclic\u001b[131Ga\u001b[133Gclic:\u001b[139Gparte\u001b[145Gsin\r\u001b[1B \u001b[3Gproductore\u001b[15Gy cada clic\u001b[27Gag\u001b[31Gga uno, siete \u001b[46Glics en total.\u001b[61G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNuevo orden:\u001b[16G\u001b[22mportada\u001b[24G\u2192\u001b[26Gpersona\u001b[34G\u2192\u001b[36G\u001b[1mde-cada-cien\u001b[49G\u001b[22m\u2192\u001b[51Gproblema\u001b[60G\u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gespejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[123G9:30.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. \u00abDe cada cien productores familiares, casi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSalen\u001b[11G100\u001b[15Gpersonitas\u001b[26Gy\u001b[28Gsolo\u001b[33G\u001b[1m6\u001b[35G\u001b[22mllegan\u001b[42Ga\u001b[44G\u00abVenden\u001b[52Gen\u001b[55Gcircuito\u001b[64Gcorto\u00bb.\u001b[72GLas\u001b[76Gdem\u00e1s\u001b[82Gse\u001b[85Gquedan\u001b[92Gen\u001b[95Ge"]
[390.2549, "o", "l\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[4C\u001b[1B\u001b[1mFuente:\u001b[22m ODEPA\u2013Rimisp\u001b[26G(2015), \u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m, cuadro 7, p.\u00a051. Son 13.706 productores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[2C\u001b[1B \u001b[5G(catastro INDAP\u00a02014) sobre 239.469 explotaciones de agricultura familiar (Censo\u00a02007). Eso da 5,72%, que en la l\u00e1mina\u001b[124Gse\u001b[127Glee com\u001b[135G \u00ab6 de cada\r\u001b[4C\u001b[1Bcien\u00bb, c\u001b[14Gn su n\u00famero de referencia al \u001b[44Gie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- El dato es de 2014\u001b[26Gy\u001b[28Gno\u001b[31Gencontr\u00e9\u001b[40Guno\u001b[44Gm\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[6C\u001b[1BUn\u001b[10G\u00abcircuito corto\u00bb i\u001b[29Gcluye ventas con un int\u001b[53Grm\u001b[56Gdiario, as\u00ed que vender realmente directo\u001b[97Ges todav\u00eda menos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar m\u00e1s de lo qu\u001b[35Gdice el est\u001b[47Gdio, la \u001b[56Gtapa del medio se llama \u00abOtr"]
[390.2561, "o", "os canal\u001b[93Gs\u00bb y no \u00abc\u001b[104Gmi\u00f3n o feria mayorista\u00bb.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEs\u001b[8Gel\u001b[11Gmapa\u001b[16Greal\u001b[21Gde\u001b[24Glas\u001b[28Gcomunas\u001b[36Galrededor\u001b[46Gde\u001b[49GSan\u001b[53GVicente\u001b[61Gde\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[2C\u001b[1B \u001b[5GgeoBoundaries (BCN), CC BY 3.0, y la cita \u001b[48Gst\u00e1 en la l\u00e1mina.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLa Escuela Los Maitenes\u001b[29Gva\u001b[32Gal centro. Los\u001b[47Gseis\u001b[52Gproductores aparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[2C\u001b[1B \u001b[5Gmiel, huevos, zapallo y\u001b[29Gqueso\u001b[35Gd\u001b[37G cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEn el\u001b[11Gs\u00e9ptimo\u001b[19Gclic aparece el\u001b[35Gcierre: \u00abTodos\u001b[50Gdentro\u001b[57Gde\u001b[60G30\u001b[63Gkm,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta"]
[390.2572, "o", "\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[4C\u001b[1B\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy \u001b[79Ga l\u00e1mina\u001b[88Gl\u001b[90G dice. Puse\u001b[102Ga Rosa a 12\u001b[114Gkm para que calce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Gen la l\u00e1mina de Rosa; los dem\u00e1s quedan entre 15 y 26 km.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCorreg\u00ed dos choque\u001b[24G que vi \u001b[33Gn la r\u001b[40Gvisi\u00f3\u001b[46G: la etiqueta \u00ab10\u001b[64Gkm\u00bb\u001b[68Gtapaba\u001b[75Ga\u001b[77GRosa,\u001b[83Gy\u001b[85Gla\u001b[88Gnota\u001b[93Gde\u001b[96Gfuente\u001b[103Gquedaba\u001b[111Gencima\u001b[118Gdel\u001b[122Gmapa.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdata/figuras.py\u001b[21G\u001b[39my\u001b[23G\u001b[38;2;177;185;249mevidence.json\u001b[39m:\u001b[38Gnueva\u001b[44Gcifra\u001b[50G\u001b[38;2;177;185;249mafc-cc\u001b[57G\u001b[39my\u001b[59Gnueva\u001b[65Greferencia.\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249meck.json\u001b[39m: las dos l\u00e1minas nuevas. El CSS de\u001b[50Gla l\u00e1mina d\u001b[62G mapa qu\u001b[71Gd\u00f3 dentro\u001b[81Gdel\u001b[85G\u001b[38;2;177;185;249m<style>\u001b[93G\u001b[39mde\u001b[96Gla\u001b[99Gl\u00e1mina\u001b[106G\u00abpro"]
[390.2584, "o", "blema\u00bb,\u001b[118Gdonde\u001b[124Gya\u001b[127Gestaban\u001b[135Glos\u001b[139Gdem\u00e1s\r\u001b[2C\u001b[1B \u001b[5Gajustes de\u001b[16Gestil\u001b[22G.\u001b[24G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtalk.md\u001b[39m: guion de las\u001b[27Gdos\u001b[31Gl\u00e1minas,\u001b[40Gcon\u001b[44Glas\u001b[48Gtransiciones\u001b[61Gde\u001b[64Gla\u001b[67Gl\u00e1mina\u001b[74Gde\u001b[77GRosa\u001b[82Gy\u001b[84Gla\u001b[87Gdel\u001b[91Gproblema\u001b[100Gajustadas.\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
