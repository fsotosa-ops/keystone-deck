[235.9332, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"porce\u001b[21Gtaje\u001b[26Gagricultura\u001b[38Gfamiliar\u001b[47Gcampesina\u001b[57GChile\u001b[63Gvende\u001b[69Gdirectamente\u001b[82Gcircuitos\u001b[92Gcortos\u001b[99Gestudio\u001b[107GODEPA\u001b[113GINDAP\u001b[119Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mFetch\u001b[22m(https://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actual)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mReceived\u001b[15G\u001b[1m2.3KB\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEncontr\u00e9 el estudi\u001b[22G ODEPA/Rimis\u001b[35G 2015; busco ahora el d\u001b[59Gto chileno de explotaciones con venta direc\u001b[103Ga.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSeg\u00fan\u001b[9GODEPA/Rimisp\u001b[22G(2015,\u001b[29GCuadro"]
[235.9354, "o", "\u001b[36G7),\u001b[40Gsolo\u001b[45Gel\u001b[48G6%\u001b[51Gde\u001b[54Glas\u001b[58Gexplotaciones\u001b[72Gde\u001b[75Gagricultura\u001b[87Gfamiliar\u001b[96Gparticipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[1B \u001b[3Gcontornos reales de\u001b[23Glas comuna\u001b[34G para el mapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m8\u001b[22G\u001b[22ms \r\u001b[2C\u001b[2B\u001b[39mT\u001b[5Gngo\u001b[9Gtodo lo que necesito. Escribo el c\u001b[44Gntorno, las cifras y las dos l\u00e1minas.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora\u001b[9Glas\u001b[13Gdos\u001b[17Gl\u00e1minas\u001b[25Gen\u001b[28Gdeck.json\u001b[38G(despu\u00e9s\u001b[47Gde\u001b[50GRosa,\u001b[56Gy\u001b[58Gdespu\u00e9s\u001b[66Gdel\u001b[70Gproblema)\u001b[80Gy\u001b[82Gel\u001b[85Gguion\u001b[91Gen\u001b[94Gtalk.md.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mInserting\u001b[13Gjourney\u001b[21Gand\u001b[25Gmap\u001b[29Gslides\u001b[36Ginto\u001b[41Gdeck.json\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  $ python3 -I - <<'EOF'\r\u001b[5C\u001b[1Bimport json, math, pathlib\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mp = pathlib.Path(\"deck.json\"); d = json.loads(p.read_te"]
