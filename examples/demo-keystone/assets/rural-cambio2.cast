[175.7747, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m5\u001b[22m shell commands \u00b7 \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLeyendo c\u00f3mo el motor\u001b[25Gdibuja\u001b[32Glas\u001b[36Gescenas\u001b[44G\u001b[38;2;177;185;249mjourney\u001b[52G\u001b[39my\u001b[54G\u001b[38;2;177;185;249mmap\u001b[58G\u001b[39mpara\u001b[63Garmar\u001b[69Glas\u001b[73Gdos\u001b[77Gl\u00e1minas.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora busco una cifra \u001b[26G\u00fablica para \u00abde cada 100\u001b[51Gproductores, cu\u00e1ntos venden directo\u00bb.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo\u001b[21GAgropecuario\u001b[34G2021\u001b[39GChile\u001b[45Gcanal\u001b[51Gde\u001b[54Gcomercializaci\u00f3n\u001b[71Gventa\u001b[77Gdirecta\u001b[85Gconsumidor\u001b[96Gporcentaje\u001b[107Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search\u001b[19Gin 6s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"CAF\u001b[19G2021\u001b[24G\"destino\u001b[33Gde\u001b[36Gla\u001b[39Gproducci\u00f3n\"\u001b[51GUPA\u001b[55Gventa\u001b[61Gdirecta\u001b[69G\"consumidor\u001b[81"]
