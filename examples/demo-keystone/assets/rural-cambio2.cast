[131.8486, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m\u276f \u001b[38;2;255;255;255mEn el deck de deck/, agrega dos l\u00e1minas con las escenas del motor: una con las personitas (de cada 100 productores, cu\u00e1ntos logran vender directo, \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mcon fuente) y\u001b[17Gun mapa real de la zona con los productores cercanos\u001b[70Ga la escuela, que ap\u001b[91Grezcan clic a clic. Decide t\u00fa y reconst\u001b[131Guye \u001b[136Gl deck.\u001b[39m       \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(keystone-html:stage-deck)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mLoad\u001b[11Gd skill\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m5\u001b[22m shell commands \u00b7 \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLeyendo\u001b[11Gc\u00f3mo\u001b[16Gel\u001b[19Gmotor\u001b[25Gdibuja\u001b[32Glas\u001b[36Gescenas\u001b[44G\u001b[38;2;177;185;249mjourney\u001b[52G\u001b[39my\u001b[54G\u001b[38;2;177;185;249mmap\u001b[58G\u001b[39mpara\u001b[63Garmar\u001b[69Glas\u001b[73Gdos\u001b[77Gl\u00e1minas.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell c"]
[131.8498, "o", "ommand \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora\u001b[9Gbusco\u001b[15Guna\u001b[19Gcifra\u001b[25Gp\u00fablica\u001b[33Gpara\u001b[38G\u00abde\u001b[42Gcada\u001b[47G100\u001b[51Gproductores,\u001b[64Gcu\u00e1ntos\u001b[72Gvenden\u001b[79Gdirecto\u00bb.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo\u001b[21GAgropecuario\u001b[34G2021\u001b[39GChile\u001b[45Gcanal\u001b[51Gde\u001b[54Gcomercializaci\u00f3n\u001b[71Gventa\u001b[77Gdirecta\u001b[85Gconsumidor\u001b[96Gporcentaje\u001b[107Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search in 6s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"CAF\u001b[19G2021\u001b[24G\"destino\u001b[33Gde\u001b[36Gla\u001b[39Gproducci\u00f3n\"\u001b[51GUPA\u001b[55Gventa\u001b[61Gdirecta\u001b[69G\"consumidor\u001b[81Gfinal\"\u001b[88Gporcentaje\u001b[99GINE\u001b[103GODEPA\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search\u001b[19Gin 5s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"porcentaje\u001b[26Gagricultura\u001b[38Gfamiliar\u001b[47Gcampesina\u001b[57GChile\u001b[63Gvende\u001b[69Gdirectamente\u001b[82Gcircuitos\u001b[92Gcortos\u001b[99Gestudio\u001b[107GODEPA\u001b[113GINDAP\u001b[119Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 searc"]
[131.8509, "o", "h i\u001b[21G 5s\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mFetch\u001b[22m(https://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actual)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mReceived \u001b[1m2.3KB\u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Encontr\u00e9 el estudio ODEPA/Rimisp 2015; busco ahora el dato chileno de explotaciones con venta directa.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mSublimating\u2026\u001b[39m\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
