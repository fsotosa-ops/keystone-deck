[393.7554, "o", "[K\r\u001b[2C\u001b[1BLas\u001b[7Gc\u001b[9Gp\u001b[11Guras\u001b[16Gest\u00e1n en\u001b[25G\u001b[38;2;177;185;249mdeck/build/review/03-de-cada-cien.png\u001b[63G\u001b[39my\u001b[65G\u001b[38;2;177;185;249mdeck/build/review/05-mapa-todos.png\u001b[39m.\u001b[102GLas\u001b[106Gcapturas\u001b[115Ganteriores\u001b[126Gde\u001b[129Gesa\u001b[133Gcarpeta\u001b[141Gconservan\r\u001b[2C\u001b[1Bla\u001b[6Gnumeraci\u00f3n\u001b[17Gvieja.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFue\u001b[7Gtes:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GODEPA\u001b[11G\u2013\u001b[13GAgricultura\u001b[25Gfamiliar\u001b[34Gy\u001b[36Gcircuitos\u001b[46Gcortos\u001b[53Gen\u001b[56GChile\u001b[62G(2015)\r\u001b[2C\u001b[1B  (h\u001b[8Gtps://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actual)\r\u001b[4C\u001b[1BINDAP\u001b[13GManual C\u00f3mo\u001b[25Gvender en circuitos cortos\u001b[K\r\u001b[17C\u001b[1Bindap\u001b[31Gsites/default\u001b[45Gfiles/2024-01/Serie%20MyC%20N4%20-%20M\u001b[84Gnual%20Circuitos%20C\u001b[109G.pdf)\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[37;3H\u001b[?25h\u001b[?2026l"]
