[216.0741, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"Censo\u001b[21GAgropecuario\u001b[34G2021\u001b[39GChile\u001b[45Gcanal\u001b[51Gde\u001b[54Gcomercializaci\u00f3n\u001b[71Gventa\u001b[77Gdirecta\u001b[85Gconsumidor\u001b[96Gporcentaje\u001b[107Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid 1 search in 6s\r\u001b[2B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mWeb Search\u001b[22m(\"CAF\u001b[19G2021 \"dest\u001b[30Gno\u001b[33Gde la producci\u00f3n\"\u001b[51GUPA venta directa \"consumidor final\" porcentaje\u001b[99GINE\u001b[103GODEPA\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mWeb Search\u001b[22m(\"porce\u001b[21Gtaje\u001b[26Gagricultura\u001b[38Gfamiliar\u001b[47Gcampesina\u001b[57GChile\u001b[63Gvende\u001b[69Gdirectamente\u001b[82Gcircuitos\u001b[92Gcortos\u001b[99Gestudio\u001b[107GODEPA\u001b[113GINDAP\u001b[119Gproductores\")\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mDid\u001b[10G1\u001b[12Gsearch\u001b[19Gin\u001b[22G5s\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[39m \u001b[1mFetch\u001b[22m(https://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actual)\r\u001b[1B\u001b[38;2;153;1"]
[216.0759, "o", "53;153m  \u23bf \u00a0\u001b[39mReceived\u001b[15G\u001b[1m2.3KB\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEncontr\u00e9 el estudi\u001b[22G ODEPA/Rimis\u001b[35G 2015; busco ahora el d\u001b[59Gto chileno de explotaciones con venta direc\u001b[103Ga.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSeg\u00fan\u001b[9GODEPA/Rimisp\u001b[22G(2015,\u001b[29GCuadro\u001b[36G7),\u001b[40Gsolo\u001b[45Gel\u001b[48G6%\u001b[51Gde\u001b[54Glas\u001b[58Gexplotaciones\u001b[72Gde\u001b[75Gagricultura\u001b[87Gfamiliar\u001b[96Gparticipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[1B \u001b[3Gcontornos reales de\u001b[23Glas comuna\u001b[34G para el mapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m8\u001b[22G\u001b[22ms \r\u001b[2C\u001b[2B\u001b[39mT\u001b[5Gngo\u001b[9Gtodo lo que necesito. Escribo el c\u001b[44Gntorno, las cifras y las dos l\u00e1minas.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m\u23fa\u001b[3G\u001b[39mSaving\u001b[10Gcomuna\u001b[17Goutlines\u001b[26Garound\u001b[33GSan\u001b[37GVicente\u001b[45Gto\u001b[48Gdeck\u001b[53Gassets\r\u001b[1B\u001b[38;2;"]
