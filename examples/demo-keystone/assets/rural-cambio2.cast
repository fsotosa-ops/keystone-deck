[321.9559, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m\u23fa\u001b[3G\u001b[39m\u001b[1mFetch\u001b[22m(https://www.odepa.gob.cl/publicaciones/consultorias-y-asesorias/agricultura-familiar-y-circuitos-cortos-situacion-actual)\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mReceiv\u001b[13Gd\u001b[15G\u001b[1m2.3KB\u001b[22m\u001b[K\r\u001b[2C\u001b[4BEnco\u001b[8Gtr\u00e9 el estudio ODEPA/Rimisp\u001b[36G2015; busco\u001b[48Gahora\u001b[54Gel dato chileno de \u001b[74Gxplotaciones\u001b[87Gcon venta dire\u001b[102Gta.\u001b[106G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSeg\u00fan\u001b[9GODEPA/Rimisp\u001b[22G(2015,\u001b[29GCuadro\u001b[36G7),\u001b[40Gsolo\u001b[45Gel\u001b[48G6%\u001b[51Gde\u001b[54Glas\u001b[58Gexplotaciones\u001b[72Gde\u001b[75Gagricultura\u001b[87Gfamiliar\u001b[96Gparticipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[1B \u001b[3Gco\u001b[6Gt\u001b[8Grn\u001b[11Gs reales de la\u001b[26G c\u001b[29Gmunas para el mapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m8\r\u001b[2C\u001b[2B\u001b[22m\u001b[39mTengo\u001b[9Gtodo lo\u001b[17Gque \u001b[22Gecesito. Escribo el contorno, l\u001b[54Gs\u001b[56Gcifras y las dos l"]
[321.957, "o", "\u00e1minas.\u001b[82G\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m2\r\u001b[2C\u001b[2B\u001b[22m\u001b[39mAhora las dos l\u00e1minas en deck.j\u001b[36Gn (despu\u00e9s de\u001b[50GR\u001b[52Gsa, y despu\u00e9s del problema)\u001b[80Gy\u001b[82Gel\u001b[85Gguion\u001b[91Gen\u001b[94Gtalk.md.\r\u001b[3C\u001b[2B\u001b[38;2;153;153;153man \u001b[1m6\u001b[22m she\u001b[13Gl comman\u001b[22Gs \u001b[39m\u001b[K\r\u001b[3C\u001b[2B\u00e1minas construidas; ahor\u001b[29G reviso\u001b[37Gc\u00f3mo se ven,\u001b[50Gcon\u001b[54Gcapt\u001b[59Gras\u001b[63Gpor\u001b[67Gpaso.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, called plugin:playwright:playwright \u001b[1m5\u001b[22m times, ran \u001b[1m2\u001b[22m shell commands \u00b7 \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mLa\u001b[6Gl\u00e1mina de\u001b[16Glas\u001b[20Gpersonitas\u001b[31Gse\u001b[34Gve\u001b[37Gbien.\u001b[43GAjusto\u001b[50Guna\u001b[54Getiqueta\u001b[63Gque\u001b[67Gafirmaba\u001b[76Gm\u00e1s\u001b[80Gde\u001b[83Glo\u001b[86Gque\u001b[90Gdice\u001b[95Gla\u001b[98Gfuente\u001b[105Gy\u001b[107Greviso\u001b[114Gel\u001b[117Gmapa.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mReading build/review/05-mapa-todos.png\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf  build/\u001b[14Gview/05-mapa-todos.png\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[3G\u001b[38;"]
