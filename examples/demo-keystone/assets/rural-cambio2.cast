[349.0732, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSeg\u00fan\u001b[9GODEPA/Rimisp\u001b[22G(2015,\u001b[29GCuadro\u001b[36G7),\u001b[40Gsolo\u001b[45Gel\u001b[48G6%\u001b[51Gde\u001b[54Glas\u001b[58Gexplotaciones\u001b[72Gde\u001b[75Gagricultura\u001b[87Gfamiliar\u001b[96Gparticipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[1B \u001b[3Gcontornos reales de\u001b[23Glas comuna\u001b[34G para el mapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\u001b[39m\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m8\u001b[22G\u001b[22ms \r\u001b[2C\u001b[2B\u001b[39mT\u001b[5Gngo\u001b[9Gtodo lo que necesito. Escribo el c\u001b[44Gntorno, las cifras y las dos l\u00e1minas.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mAhora\u001b[9Glas\u001b[13Gdos\u001b[17Gl\u00e1minas\u001b[25Gen\u001b[28Gdeck.json\u001b[38G(despu\u00e9s\u001b[47Gde\u001b[50GRosa,\u001b[56Gy\u001b[58Gdespu\u00e9s\u001b[66Gdel\u001b[70Gproblema)\u001b[80Gy\u001b[82Gel\u001b[85Gguion\u001b[91Gen\u001b[94Gtalk.md.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mL\u00e1minas\u001b[11Gconstruidas;\u001b[24Gahora\u001b[30Greviso\u001b[37Gc\u00f3mo\u001b[42Gse\u001b[45"]
