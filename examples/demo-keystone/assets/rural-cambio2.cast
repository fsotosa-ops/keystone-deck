[341.6911, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[39m Encontr\u00e9 \u001b[13Gl\u001b[15Gestudio\u001b[23GODEPA/Rimisp\u001b[36G2015;\u001b[42Gbusco\u001b[48Gahora\u001b[54Gel\u001b[57Gdato\u001b[62Gchileno\u001b[70Gde\u001b[73Gexplotaciones\u001b[87Gcon\u001b[91Gventa\u001b[97Gdirecta.\r\u001b[2C\u001b[4BSeg\u00fa\u001b[8G ODEPA/Rimisp (2015, Cuadro\u001b[36G7), solo el\u001b[48G6% de\u001b[54Glas explotaciones d\u001b[74G agricultura\u001b[87Gfamiliar parti\u001b[102Gipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[2C\u001b[1Bcontornos\u001b[13Greales\u001b[20Gde\u001b[23Glas\u001b[27Gcomunas\u001b[35Gpara\u001b[40Gel\u001b[43Gmapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mTe\u001b[6Gg\u001b[8G t\u001b[11Gdo lo que nece\u001b[26Git\u001b[29G. Escribo el contorno, las cifras\u001b[63Gy\u001b[65Glas\u001b[69Gdos\u001b[73Gl\u00e1minas.\r\u001b[6C\u001b[2B\u001b[38;2;153;153;153m\u001b[1m2\r\u001b[2C\u001b[2B\u001b[22m\u001b[39mAhora\u001b[9Glas dos\u001b[17Gl\u00e1mi\u001b[22Gas en deck.json (despu\u00e9s de Ros\u001b[54G,\u001b[56Gy despu\u00e9s del problema) y\u001b[82Gel\u001b[85Gguion\u001b[91Gen\u001b[94Gtalk"]
