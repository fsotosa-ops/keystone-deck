[394.3723, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEs\u001b[8Gel\u001b[11Gmapa\u001b[16Greal\u001b[21Gde\u001b[24Glas\u001b[28Gcomunas\u001b[36Galrededor\u001b[46Gde\u001b[49GSan\u001b[53GVicente\u001b[61Gde\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[112G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[2C\u001b[1B \u001b[5GgeoBoundaries (BCN), CC BY 3.0, y la cita \u001b[48Gst\u00e1 en la l\u00e1mina.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLa Escuela Los Maitenes\u001b[29Gva\u001b[32Gal centro. Los\u001b[47Gseis\u001b[52Gproductores aparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[2C\u001b[1B \u001b[5Gmiel, huevos, zapallo y\u001b[29Gqueso\u001b[35Gd\u001b[37G cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEn el\u001b[11Gs\u00e9ptimo\u001b[19Gclic aparece el\u001b[35Gcierre: \u00abTodos\u001b[50Gdentro\u001b[57Gde\u001b[60G30\u001b[63Gkm,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[4C\u001b[1B\u001b[1mLa"]
[394.3736, "o", " comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy \u001b[79Ga l\u00e1mina\u001b[88Gl\u001b[90G dice. Puse\u001b[102Ga Rosa a 12\u001b[114Gkm para que calce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Gen la l\u00e1mina de Rosa; los dem\u00e1s quedan entre 15 y 26 km.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCorreg\u00ed dos choque\u001b[24G que vi \u001b[33Gn la r\u001b[40Gvisi\u00f3\u001b[46G: la etiqueta \u00ab10\u001b[64Gkm\u00bb\u001b[68Gtapaba\u001b[75Ga\u001b[77GRosa,\u001b[83Gy\u001b[85Gla\u001b[88Gnota\u001b[93Gde\u001b[96Gfuente\u001b[103Gquedaba\u001b[111Gencima\u001b[118Gdel\u001b[122Gmapa.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdata/figuras.py\u001b[21G\u001b[39my\u001b[23G\u001b[38;2;177;185;249mevidence.json\u001b[39m:\u001b[38Gnueva\u001b[44Gcifra\u001b[50G\u001b[38;2;177;185;249mafc-cc\u001b[57G\u001b[39my\u001b[59Gnueva\u001b[65Greferencia.\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249meck.json\u001b[39m: las dos l\u00e1minas nuevas. El CSS de\u001b[50Gla l\u00e1mina d\u001b[62G mapa qu\u001b[71Gd\u00f3 dentro\u001b[81Gdel\u001b[85G\u001b[38;2;177;185;249m<style>\u001b[93G\u001b[39mde\u001b[96Gla\u001b[99Gl\u00e1mina\u001b[106G\u00abproblema\u00bb,\u001b[118Gdonde\u001b[124Gya\u001b[127Gestaban\u001b[135Glo"]
[394.3748, "o", "s\u001b[139Gdem\u00e1s\r\u001b[2C\u001b[1B \u001b[5Gajustes de\u001b[16Gestil\u001b[22G.\u001b[24G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtalk.md\u001b[39m: guion de las\u001b[27Gdos\u001b[31Gl\u00e1minas,\u001b[40Gcon\u001b[44Glas\u001b[48Gtransiciones\u001b[61Gde\u001b[64Gla\u001b[67Gl\u00e1mina\u001b[74Gde\u001b[77GRosa\u001b[82Gy\u001b[84Gla\u001b[87Gdel\u001b[91Gproblema\u001b[100Gajustadas.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249massets/comunas-cachapoal-colchagua.geojson\u001b[39m: el cont\u001b[57Grno\u001b[66Gs comunas.\u001b[77G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLa\u001b[6Grevisi\u00f3n\u001b[15Gde\u001b[18Gcontenido\u001b[28Gpasa\u001b[33Gsin\u001b[37Gerrores;\u001b[46Gquedan\u001b[53Gsolo\u001b[58Gadvertencias.\u001b[72GLas\u001b[76Gdos\u001b[80Gl\u00e1minas\u001b[88Gnuevas\u001b[95Gtienen\u001b[102Gm\u00e1s\u001b[106Gpalabras\u001b[115Gvisibles\u001b[124Gque\u001b[128Gel\u001b[131Gm\u00e1ximo\u001b[138Grecomendado\r\u001b[2C\u001b[1Bde\u001b[6G25, \u001b[11Gobre tod\u001b[20G el mapa con\u001b[34Gus\u001b[38Gtiqu\u001b[43Gtas. El chequeo tambi\u00e9\u001b[66G lee como\u001b[76G\u00abn\u00fameros e\u001b[87Gcritos a ma\u001b[99Go\u00bb\u001b[102Gel \u00abcuadro 7, p. 51\u00bb y la\u001b[128Glicenc\u001b[135Ga \u00abCC BY 3.0\u00bb:\r\u001b[2C\u001b[1Bson parte d\u001b[16Gla cita, no cifra\u001b[34G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLas\u001b[7Gcapturas\u001b[16Gest\u00e1n\u001b[22Gen\u001b[25G\u001b[38;2;177;185;249mdeck/build/review/03-de-cada-cien.png"]
