[391.103, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNuevo orden:\u001b[16G\u001b[22mportada\u001b[24G\u2192\u001b[26Gpersona\u001b[34G\u2192\u001b[36G\u001b[1mde-cada-cien\u001b[49G\u001b[22m\u2192\u001b[51Gproblema\u001b[60G\u2192\u001b[62G\u001b[1mmapa\u001b[67G\u001b[22m\u2192\u001b[69Gespejo\u001b[76G\u2192\u001b[78G\u2026\u001b[80G\u2192\u001b[82Gcierre.\u001b[90GLa\u001b[93Gduraci\u00f3n\u001b[102Gtotal\u001b[108Gpasa\u001b[113Gde\u001b[116G8:00\u001b[121Ga\u001b[123G9:30.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. \u00abDe cada cien productores familiares, casi ninguno vende directo\u00bb (\u001b[38;2;177;185;249mjourney\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSalen\u001b[11G100\u001b[15Gpersonitas\u001b[26Gy\u001b[28Gsolo\u001b[33G\u001b[1m6\u001b[35G\u001b[22mllegan\u001b[42Ga\u001b[44G\u00abVenden\u001b[52Gen\u001b[55Gcircuito\u001b[64Gcorto\u00bb.\u001b[72GLas\u001b[76Gdem\u00e1s\u001b[82Gse\u001b[85Gquedan\u001b[92Gen\u001b[95Gel\u001b[98Gcamino,\u001b[106Gen\u001b[109Gtono\u001b[114Gapagado.\r\u001b[4C\u001b[1B\u001b[1mFuente:\u001b[22m ODEPA\u2013Rimisp\u001b[26G(2015), \u001b[3mAgricultura familiar y circuitos cortos en Chile\u001b[23m, cuadro 7, p.\u00a051. Son 13.706 productores\u001b[124Gen\u001b[127Gcircuitos\u001b[137Gcortos\r\u001b[2C\u001b[1B \u001b[5G(catastro INDAP\u00a02014) sobre 239.469 explotaciones de agricultura familiar (Censo\u00a02007). Eso da 5,72%, que en la l\u00e1mina\u001b[124Gse\u001b[127Glee com\u001b[135"]
[391.1039, "o", "G \u00ab6 de cada\r\u001b[4C\u001b[1Bcien\u00bb, c\u001b[14Gn su n\u00famero de referencia al \u001b[44Gie.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOjo con dos cosas:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- El dato es de 2014\u001b[26Gy\u001b[28Gno\u001b[31Gencontr\u00e9\u001b[40Guno\u001b[44Gm\u00e1s\u001b[48Greciente:\u001b[58Gel\u001b[61Gcenso\u001b[67Gde\u001b[70G2021\u001b[75Gno\u001b[78Gpublica\u001b[86Gcifras\u001b[93Gpor\u001b[97Gcanal\u001b[103Gde\u001b[106Gventa.\r\u001b[6C\u001b[1BUn\u001b[10G\u00abcircuito corto\u00bb i\u001b[29Gcluye ventas con un int\u001b[53Grm\u001b[56Gdiario, as\u00ed que vender realmente directo\u001b[97Ges todav\u00eda menos.\u001b[115GLa\u001b[118Gl\u00e1mina\u001b[125Gy\u001b[127Gel\u001b[130Gguion\u001b[136Glo\u001b[139Gdicen.\r\u001b[2C\u001b[1B-\u001b[5GPara\u001b[10Gno afirmar m\u00e1s de lo qu\u001b[35Gdice el est\u001b[47Gdio, la \u001b[56Gtapa del medio se llama \u00abOtros canal\u001b[93Gs\u00bb y no \u00abc\u001b[104Gmi\u00f3n o feria mayorista\u00bb.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. \u00abLa cocina del colegio tiene la cosecha a minutos\u00bb (\u001b[38;2;177;185;249mmap\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEs\u001b[8Gel\u001b[11Gmapa\u001b[16Greal\u001b[21Gde\u001b[24Glas\u001b[28Gcomunas\u001b[36Galrededor\u001b[46Gde\u001b[49GSan\u001b[53GVicente\u001b[61Gde\u001b[64GTagua\u001b[70GTagua\u001b[76G(O'Higgins),\u001b[89Gcon\u001b[93Ganillos\u001b[101Ga\u001b[103G10,\u001b[107G20\u001b[110Gy\u001b[1"]
[391.1051, "o", "12G30\u001b[115Gkm.\u001b[119GLos\u001b[123Gl\u00edmites\u001b[131Gvienen\u001b[138Gde\r\u001b[2C\u001b[1B \u001b[5GgeoBoundaries (BCN), CC BY 3.0, y la cita \u001b[48Gst\u00e1 en la l\u00e1mina.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLa Escuela Los Maitenes\u001b[29Gva\u001b[32Gal centro. Los\u001b[47Gseis\u001b[52Gproductores aparecen\u001b[73Gde\u001b[76Ga\u001b[78Guno\u001b[82Gpor\u001b[86Gclic,\u001b[92Gcon\u001b[96Guna\u001b[100Gl\u00ednea\u001b[106Ghasta\u001b[112Gla\u001b[115Gescuela:\u001b[124GRosa\u001b[129G\u00b7\u001b[131Glechuga,\u001b[140Gtomate,\r\u001b[2C\u001b[1B \u001b[5Gmiel, huevos, zapallo y\u001b[29Gqueso\u001b[35Gd\u001b[37G cabra.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEn el\u001b[11Gs\u00e9ptimo\u001b[19Gclic aparece el\u001b[35Gcierre: \u00abTodos\u001b[50Gdentro\u001b[57Gde\u001b[60G30\u001b[63Gkm,\u001b[67Gel\u001b[70Gradio\u001b[76Gdel\u001b[80Gpiloto.\u001b[88GHoy\u001b[92Gnadie\u001b[98Glos\u001b[102Gconecta\u001b[110Gcon\u001b[114Gesa\u001b[118Gcocina\u00bb.\r\u001b[4C\u001b[1B\u001b[1mLa comuna es real, pero la escuela y las ubicaciones son ilustrativas\u001b[22m,\u001b[76Gy \u001b[79Ga l\u00e1mina\u001b[88Gl\u001b[90G dice. Puse\u001b[102Ga Rosa a 12\u001b[114Gkm para que calce\u001b[132Gcon\u001b[136Glo\u001b[139Gque\u001b[143Gse\u001b[146Gdice\r\u001b[2C\u001b[1B \u001b[5Gen la l\u00e1mina de Rosa; los dem\u00e1s quedan entre 15 y 26 km.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCorreg\u00ed dos choque\u001b[24G que vi \u001b[33Gn la r\u001b[40Gvisi\u00f3\u001b["]
[391.1064, "o", "46G: la etiqueta \u00ab10\u001b[64Gkm\u00bb\u001b[68Gtapaba\u001b[75Ga\u001b[77GRosa,\u001b[83Gy\u001b[85Gla\u001b[88Gnota\u001b[93Gde\u001b[96Gfuente\u001b[103Gquedaba\u001b[111Gencima\u001b[118Gdel\u001b[122Gmapa.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mArchivos que cambiaron en \u001b[38;2;177;185;249mdeck/\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdata/figuras.py\u001b[21G\u001b[39my\u001b[23G\u001b[38;2;177;185;249mevidence.json\u001b[39m:\u001b[38Gnueva\u001b[44Gcifra\u001b[50G\u001b[38;2;177;185;249mafc-cc\u001b[57G\u001b[39my\u001b[59Gnueva\u001b[65Greferencia.\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249meck.json\u001b[39m: las dos l\u00e1minas nuevas. El CSS de\u001b[50Gla l\u00e1mina d\u001b[62G mapa qu\u001b[71Gd\u00f3 dentro\u001b[81Gdel\u001b[85G\u001b[38;2;177;185;249m<style>\u001b[93G\u001b[39mde\u001b[96Gla\u001b[99Gl\u00e1mina\u001b[106G\u00abproblema\u00bb,\u001b[118Gdonde\u001b[124Gya\u001b[127Gestaban\u001b[135Glos\u001b[139Gdem\u00e1s\r\u001b[2C\u001b[1B \u001b[5Gajustes de\u001b[16Gestil\u001b[22G.\u001b[24G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtalk.md\u001b[39m: guion de las\u001b[27Gdos\u001b[31Gl\u00e1minas,\u001b[40Gcon\u001b[44Glas\u001b[48Gtransiciones\u001b[61Gde\u001b[64Gla\u001b[67Gl\u00e1mina\u001b[74Gde\u001b[77GRosa\u001b[82Gy\u001b[84Gla\u001b[87Gdel\u001b[91Gproblema\u001b[100Gajustadas.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249massets/comunas-cachapoal-colchagua.geojson\u001b[39m: e"]
