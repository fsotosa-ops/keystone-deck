[212.3181, "o", "C\u001b[1BReceived \u001b[1m2.3KB\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mEncontr\u00e9\u001b[12Gel\u001b[15Gestudio\u001b[23GODEPA/Rimisp\u001b[36G2015;\u001b[42Gbusco\u001b[48Gahora\u001b[54Gel\u001b[57Gdato\u001b[62Gchileno\u001b[70Gde\u001b[73Gexplotaciones\u001b[87Gcon\u001b[91Gventa\u001b[97Gdirecta.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSeg\u00fan\u001b[9GODEPA/Rimisp\u001b[22G(2015,\u001b[29GCuadro\u001b[36G7),\u001b[40Gsolo\u001b[45Gel\u001b[48G6%\u001b[51Gde\u001b[54Glas\u001b[58Gexplotaciones\u001b[72Gde\u001b[75Gagricultura\u001b[87Gfamiliar\u001b[96Gparticipa\u001b[106Gen\u001b[109Gcircuitos\u001b[119Gcortos.\u001b[127GAhora\u001b[133Gdescargo\u001b[142Glos\r\u001b[2C\u001b[1Bcontornos reales de las\u001b[27Gcomunas\u001b[35Gpara\u001b[40Gel\u001b[43Gmapa.\u001b[38;2;153;153;153m \u00b7\u00a0summary\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mTengo\u001b[9Gtodo\u001b[14Glo\u001b[17Gque\u001b[21Gnecesito.\u001b[31GEscribo\u001b[39Gel\u001b[42Gcontorno,\u001b[52Glas\u001b[56Gcifras\u001b[63Gy\u001b[65Glas\u001b[69Gdos\u001b[73Gl\u00e1minas.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153"]
